  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;

  border: 0 !important;
  border-color: transparent !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  font-family: var(--font-header) !important;
  font-size: 18px !important;
  font-style: normal !important;
  font-weight: 700 !important;
  line-height: 1 !important;
  letter-spacing: 0.01em !important;

  text-align: center !important;
  text-decoration: none !important;
  text-transform: none !important;

  text-shadow:
    0 1px 0 rgba(255, 245, 225, 0.42) !important;

  filter:
    drop-shadow(0 2px 3px rgba(0, 0, 0, 0.25)) !important;

  transform: none !important;

  transition:
    filter 0.22s ease !important;
}


/* Preserve the parchment without moving it. */

.user-css.page-world-homepage .widget-community .btn:hover,
.user-css.page-world-homepage .widget-community a.btn:hover,
.user-css.page-world-homepage .widget-community .btn:focus,
.user-css.page-world-homepage .widget-community a.btn:focus,
.user-css.page-world-homepage .widget-community .btn:active,
.user-css.page-world-homepage .widget-community a.btn:active {
