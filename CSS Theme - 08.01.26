/* FOOTER CREDITS */

.user-css .credits {
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  margin: 12px auto;
  padding: 16px 22px;
  color: var(--color-text);
  background:
    linear-gradient(180deg, rgba(8, 25, 32, 0.98), rgba(3, 12, 18, 0.98));
  border: 1px solid var(--color-border);
  border-radius: 8px;
  box-shadow:
    0 8px 22px rgba(0, 0, 0, 0.38),
    inset 0 1px 0 rgba(255, 255, 255, 0.035);
  font-family: var(--font-meta);
  font-size: clamp(12px, 1vw, 15px);
  line-height: 1.55;
  text-align: center;
  transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
}

.user-css .credits:hover {
  transform: translateY(-2px);
  border-color: var(--color-accent);
  box-shadow:
    0 12px 28px rgba(0, 0, 0, 0.46),
    0 0 12px rgba(217, 167, 111, 0.16),
    inset 0 1px 0 rgba(255, 255, 255, 0.045);
}

.user-css .credits p,
.user-css .credits li,
.user-css .credits span,
.user-css .credits strong,
.user-css .credits b {
  color: var(--color-text) !important;
  font-family: var(--font-meta);
  line-height: 1.55;
  text-shadow: none !important;
}

.user-css .credits p:last-child {
  margin-bottom: 0;
}

.user-css .credits a {
  color: var(--color-link);
  font-family: var(--font-meta);
  font-size: inherit;
  text-decoration: none;
}

.user-css .credits a:hover {
  color: var(--color-link-light);
  text-decoration: underline;
}

@media only screen and (max-width: 768px) {
  .user-css .credits {
    width: 100%;
    padding: 12px 14px;
    font-size: 12px;
  }
}

/* COMMISSIONED ART GALLERY */

.user-css .art-gallery {
  box-sizing: border-box;
  width: 100%;
  max-width: none;
  margin: 36px auto 60px;
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
}

.user-css .art-gallery .art-artist {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  margin: 38px auto;
  padding: clamp(20px, 3vw, 34px);
  overflow: hidden;
  color: var(--color-text);
  background:
    radial-gradient(circle at 50% 0%, rgba(217, 167, 111, 0.09), transparent 34%),
    linear-gradient(180deg, rgba(8, 25, 32, 0.98), rgba(3, 12, 18, 0.98));
  border: 1px solid var(--color-border);
  border-radius: 18px;
  box-shadow:
    0 18px 42px rgba(0, 0, 0, 0.46),
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    inset 0 0 44px rgba(0, 0, 0, 0.28);
}

.user-css .art-gallery .art-artist::before {
  content: "";
  position: absolute;
  top: 0;
  left: 10%;
  width: 80%;
  height: 1px;
  pointer-events: none;
  background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  opacity: 0.8;
}

.user-css .art-gallery .art-artist > h1,
.user-css .art-gallery .art-artist > h2 {
  margin: 0 0 6px !important;
  padding: 0 0 10px !important;
  text-align: center !important;
  font-family: var(--font-display) !important;
  font-size: clamp(34px, 4vw, 54px) !important;
  line-height: 1.15 !important;
  letter-spacing: 0.025em;
  background: var(--color-header) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  border-bottom: 1px solid var(--color-border-soft) !important;
}

.user-css .art-gallery .artist-link {
  margin: 8px auto 24px;
  text-align: center;
  color: var(--color-muted);
  font-family: var(--font-meta);
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.user-css .art-gallery .artist-link center {
  margin: 0;
}

.user-css .art-gallery .artist-link a {
  color: var(--color-link-light);
  font-family: var(--font-meta);
  font-size: inherit;
  text-decoration: none;
}

.user-css .art-gallery .artist-link a:hover {
  color: #ffe2bf;
  text-decoration: underline;
}

.user-css .art-gallery .art-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(18px, 2.2vw, 28px);
  align-items: start;
  width: 100%;
}

.user-css .art-gallery .art-piece,
.user-css .art-gallery .art-piece-wide {
  position: relative;
  box-sizing: border-box;
  min-width: 0;
  padding: 14px;
  overflow: hidden;
  color: var(--color-text);
  background: linear-gradient(180deg, #071820 0%, #041016 100%);
  border: 1px solid rgba(179, 116, 77, 0.68);
  border-radius: 12px;
  box-shadow:
    0 12px 26px rgba(0, 0, 0, 0.42),
    inset 0 1px 0 rgba(255, 255, 255, 0.025);
  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}

.user-css .art-gallery .art-piece-wide {
  grid-column: 1 / -1;
}

.user-css .art-gallery .art-piece:hover,
.user-css .art-gallery .art-piece-wide:hover {
  transform: translateY(-4px);
  border-color: var(--color-accent);
  box-shadow:
    0 18px 38px rgba(0, 0, 0, 0.54),
    0 0 15px rgba(217, 167, 111, 0.14),
    inset 0 1px 0 rgba(255, 255, 255, 0.035);
}

.user-css .art-gallery .piece-title {
  margin: 0 0 12px;
  padding: 9px 12px 10px;
  text-align: center;
  color: var(--color-link-light);
  background: linear-gradient(180deg, rgba(18, 48, 57, 0.96), rgba(7, 27, 34, 0.96));
  border: 1px solid rgba(179, 116, 77, 0.48);
  border-radius: 8px;
  box-shadow: inset 0 0 18px rgba(0, 0, 0, 0.28);
  font-family: var(--font-header);
  font-size: clamp(24px, 2.6vw, 34px);
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: 0.02em;
}

.user-css .art-gallery .piece-title i,
.user-css .art-gallery .piece-title em {
  color: inherit;
  font-style: normal;
}

.user-css .art-gallery .piece-note {
  margin: 12px 2px 0;
  padding: 10px 12px;
  color: var(--color-muted);
  background: rgba(2, 8, 12, 0.78);
  border-left: 3px solid var(--color-border);
  border-radius: 4px;
  font-family: var(--font-);
  font-size: 15px;
  line-height: 1.5;
  text-align: left;
}

.user-css .art-gallery .piece-note a {
  color: var(--color-link-light);
}

.user-css .art-gallery .art-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  align-items: stretch;
  width: 100%;
}

.user-css .art-gallery img,
.user-css .art-gallery .img-responsive,
.user-css .art-gallery .img-fluid,
.user-css .art-gallery .img-responsive.img-fluid,
.user-css .art-gallery .max-width-100 {
  display: block !important;
  float: none !important;
  width: auto !important;
  max-width: 100% !important;
  height: auto !important;
  max-height: 760px;
  margin: 0 auto !important;
  padding: 0 !important;
  object-fit: contain !important;
  opacity: 1 !important;
  filter: none !important;
  transform: none !important;
  -webkit-mask-image: none !important;
  mask-image: none !important;
  border: 1px solid rgba(217, 167, 111, 0.24) !important;
  border-image: none !important;
  border-radius: 6px !important;
  background: #020609;
  box-shadow: 0 9px 22px rgba(0, 0, 0, 0.5) !important;
  transition: transform 0.35s ease, box-shadow 0.35s ease, filter 0.35s ease !important;
}

.user-css .art-gallery .art-pair img,
.user-css .art-gallery .art-pair .img-responsive,
.user-css .art-gallery .art-pair .img-fluid {
  width: 100% !important;
  height: 100% !important;
  max-height: 560px;
  object-fit: contain !important;
}

.user-css .art-gallery .art-piece:hover img,
.user-css .art-gallery .art-piece-wide:hover img {
  transform: scale(1.012) !important;
  filter: brightness(1.03) !important;
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.58) !important;
}

.user-css .art-gallery .art-piece .spoiler-button,
.user-css .art-gallery .art-piece-wide .spoiler-button {
  margin-top: 4px;
}

.user-css .art-gallery .art-piece .spoiler-content,
.user-css .art-gallery .art-piece-wide .spoiler-content {
  text-align: center;
}

.user-css .art-gallery .art-piece .spoiler-content img,
.user-css .art-gallery .art-piece-wide .spoiler-content img {
  margin: 14px auto !important;
}

@media only screen and (max-width: 850px) {
  .user-css .art-gallery .art-grid {
    grid-template-columns: 1fr;
  }

  .user-css .art-gallery .art-piece-wide {
    grid-column: auto;
  }
}

@media only screen and (max-width: 560px) {
  .user-css .art-gallery .art-artist {
    margin: 24px auto;
    padding: 16px;
    border-radius: 12px;
  }

  .user-css .art-gallery .art-grid {
    gap: 16px;
  }

  .user-css .art-gallery .art-piece,
  .user-css .art-gallery .art-piece-wide {
    padding: 10px;
  }

  .user-css .art-gallery .art-pair {
    grid-template-columns: 1fr;
  }

  .user-css .art-gallery .piece-title {
    font-size: 25px;
  }
}

/* ART GALLERY TEXT */

.user-css .article-content-left .art-gallery .piece-title,
.user-css .article-content-left .art-gallery .piece-title i,
.user-css .article-content-left .art-gallery .piece-title em {
  color: #f3c990 !important;
  -webkit-text-fill-color: #f3c990 !important;
  text-shadow:
    0 2px 3px rgba(0, 0, 0, 0.95),
    0 0 10px rgba(217, 167, 111, 0.18) !important;
}

.user-css .article-content-left .art-gallery .piece-note,
.user-css .article-content-left .art-gallery .piece-note p,
.user-css .article-content-left .art-gallery .piece-note strong,
.user-css .article-content-left .art-gallery .piece-note b {
  color: #ddd5c7 !important;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9) !important;
}

.user-css .article-content-left .art-gallery .piece-note i,
.user-css .article-content-left .art-gallery .piece-note em {
  color: #f0c38e !important;
  -webkit-text-fill-color: #f0c38e !important;
  font-style: italic;
  font-weight: 600;
  text-shadow:
    0 1px 2px rgba(0, 0, 0, 0.95),
    0 0 8px rgba(217, 167, 111, 0.16) !important;
}

/* ARTICLE TYPOGRAPHY */

.user-css h1,
