/* MOBILE */

@media only screen and (max-width: 680px) {
  .user-css .team-credits-rotator {
    width: 100% !important;

    margin: 24px auto !important;
  }

  .user-css .team-credits-rotator .team-credit {
    top: 22% !important;
    right: 11% !important;
    bottom: 20% !important;
    left: 11% !important;

    padding: 6px 10px !important;

    font-size: clamp(17px, 4.8vw, 24px) !important;
  }

  .user-css .team-credits-rotator .team-credit-title {
    font-size: clamp(28px, 7vw, 46px) !important;
  }

  .user-css
  .team-credits-rotator
  .team-credit-thanks
  .team-credit-title {
    max-width: 94% !important;

    font-size: clamp(20px, 5.2vw, 31px) !important;
    line-height: 1 !important;
    letter-spacing: 0.01em !important;
  }

  .user-css .team-credits-rotator .team-credit-legal {
    font-size: clamp(9px, 2vw, 12px) !important;
    line-height: 1.32 !important;
  }

  .user-css .team-credits-rotator .team-credit-farewell em,
  .user-css .team-credits-rotator .team-credit-farewell i {
    font-size: clamp(16px, 4vw, 22px) !important;
  }
}


/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {
  .user-css .team-credits-rotator .team-credit {
    display: none !important;

    animation: none !important;
  }

  .user-css
  .team-credits-rotator
  .team-credit:nth-of-type(1) {
    display: flex !important;

    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;

    filter: none !important;
    transform: none !important;
  }
}

/* NUMBER OF FOLLOWERS — DRIFTWOOD COUNT AND PARCHMENT CONTROL */

@keyframes followersDriftwoodFloat {
  0% {
    transform: translateY(0) rotate(0deg);
  }

  25% {
    transform: translateY(-3px) rotate(-0.35deg);
  }

  50% {
    transform: translateY(1px) rotate(0.25deg);
  }

  75% {
    transform: translateY(-2px) rotate(-0.2deg);
  }

  100% {
    transform: translateY(0) rotate(0deg);
  }
}


