.user-css h2,
.user-css-extended h2,
.user-css h3,
.user-css-extended h3,
.user-css h4,
.user-css-extended h4,
.user-css h5,
.user-css-extended h5 {
  text-shadow: 0 1px 0 rgba(0, 0, 0, 0.72) !important;
  filter: none !important;
}

.user-css .parchment h1,
.user-css .parchment h2,
.user-css .parchment h3,
.user-css .parchment h4,
.user-css .parchment h5,
.user-css .bordered-cardbg h1,
.user-css .bordered-cardbg h2,
.user-css .bordered-cardbg h3,
.user-css .bordered-cardbg h4,
.user-css .bordered-cardbg h5,
.user-css .border-card h1,
.user-css .border-card h2,
.user-css .border-card h3,
.user-css .border-card h4,
.user-css .border-card h5,
.user-css .side-card h1,
.user-css .side-card h2,
.user-css .side-card h3,
.user-css .side-card h4,
.user-css .side-card h5,
.user-css .parchment2 h1,
.user-css .parchment2 h2,
.user-css .parchment2 h3,
.user-css .parchment2 h4,
.user-css .parchment2 h5,
.user-css .weapon-card h1,
.user-css .weapon-card h2,
.user-css .weapon-card h3,
.user-css .weapon-card h4,
.user-css .weapon-card h5,
.user-css .gear-card h1,
.user-css .gear-card h2,
.user-css .gear-card h3,
.user-css .gear-card h4,
.user-css .gear-card h5,
.user-css .spell-card h1,
.user-css .spell-card h2,
.user-css .spell-card h3,
.user-css .spell-card h4,
.user-css .spell-card h5,
.user-css .magic-item-card h1,
.user-css .magic-item-card h2,
.user-css .magic-item-card h3,
.user-css .magic-item-card h4,
.user-css .magic-item-card h5,
.user-css .background-card h1,
.user-css .background-card h2,
.user-css .background-card h3,
