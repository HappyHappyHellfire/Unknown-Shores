/* ================================================================
   PARCHMENT PAGE
   ================================================================ */

.user-css .parchment-page,
.user-css-extended .parchment-page {
  position: relative !important;
  isolation: isolate;
  box-sizing: border-box !important;

  display: block !important;
  width: 100% !important;
  max-width: 1100px !important;
  min-height: 260px !important;

  margin: 30px auto 45px !important;
  padding: 34px 46px !important;
  overflow: visible !important;

  color: #3d2b1e !important;
  background: transparent !important;

  border: 52px solid transparent !important;

  border-image-source:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/a10fa12150a520e1953d3e1440db0ba3.png) !important;

  border-image-slice: 95 fill !important;
  border-image-width: 1 !important;
  border-image-outset: 0 !important;
  border-image-repeat: stretch !important;

  border-radius: 0 !important;
  box-shadow: none !important;

  filter:
    drop-shadow(0 10px 8px rgba(0, 0, 0, 0.28))
    drop-shadow(0 20px 24px rgba(0, 0, 0, 0.18)) !important;

  font-family:
    Cardo,
    EBGaramond,
    Garamond,
    serif !important;

  font-size: clamp(16px, 1.35vw, 20px) !important;
  line-height: 1.65 !important;

  text-align: left !important;
  text-shadow: none !important;
}

/* Ordinary text */

.user-css .parchment-page p,
.user-css .parchment-page li,
.user-css .parchment-page span,
.user-css .parchment-page strong,
.user-css .parchment-page b,
.user-css .parchment-page em,
.user-css .parchment-page figcaption,
.user-css-extended .parchment-page p,
.user-css-extended .parchment-page li,
.user-css-extended .parchment-page span,
.user-css-extended .parchment-page strong,
.user-css-extended .parchment-page b,
.user-css-extended .parchment-page em,
.user-css-extended .parchment-page figcaption {
  color: #3d2b1e !important;
  background: transparent !important;
  text-shadow: none !important;
}

.user-css .parchment-page :is(p, li, td, blockquote) i,
.user-css-extended .parchment-page :is(p, li, td, blockquote) i {
  color: #3d2b1e !important;
  text-shadow: none !important;
}

.user-css .parchment-page small,
.user-css .parchment-page .text-muted,
.user-css .parchment-page .author,
.user-css-extended .parchment-page small,
.user-css-extended .parchment-page .text-muted,
.user-css-extended .parchment-page .author {
  color: #6b4a34 !important;
  background: transparent !important;
  text-shadow: none !important;
}

/* Headings */

.user-css .parchment-page h1,
.user-css .parchment-page h2,
.user-css .parchment-page h3,
.user-css .parchment-page h4,
.user-css .parchment-page h5,
.user-css-extended .parchment-page h1,
.user-css-extended .parchment-page h2,
.user-css-extended .parchment-page h3,
.user-css-extended .parchment-page h4,
.user-css-extended .parchment-page h5 {
  color: #542b18 !important;
  background: none !important;

  border-color: rgba(94, 49, 25, 0.38) !important;
  box-shadow: none !important;

  font-family:
    JimNightshade,
    Georgia,
    serif !important;

  font-weight: 400 !important;
  line-height: 1.1 !important;
  letter-spacing: 0.015em !important;

  text-align: left !important;
  text-transform: none !important;

  text-shadow:
    0 1px rgba(255, 247, 224, 0.72),
    0 0 4px rgba(83, 43, 23, 0.08) !important;

  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  -webkit-text-fill-color: #542b18 !important;
}

/* Links */

.user-css .parchment-page a,
.user-css-extended .parchment-page a {
  color: #7b3f20 !important;
  background: transparent !important;

  font-weight: 600 !important;
  text-decoration-color: rgba(123, 63, 32, 0.45) !important;
  text-shadow: none !important;

  -webkit-text-fill-color: #7b3f20 !important;

  transition: color 180ms ease !important;
}

.user-css .parchment-page a:hover,
.user-css .parchment-page a:focus,
.user-css-extended .parchment-page a:hover,
.user-css-extended .parchment-page a:focus {
  color: #a24e22 !important;
  text-decoration-color: #a24e22 !important;
  -webkit-text-fill-color: #a24e22 !important;
}

/* Quotations */

.user-css .parchment-page blockquote,
.user-css-extended .parchment-page blockquote {
  margin: 24px 18px !important;
  padding: 16px 20px !important;

  color: #4a3020 !important;
  background: rgba(112, 68, 34, 0.07) !important;

  border: 0 !important;
  border-left: 3px solid rgba(126, 71, 34, 0.62) !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  animation: none !important;
  font-size: 1.05em !important;

  font-family:
    Cardo,
    EBGaramond,
    Garamond,
    serif !important;

  text-shadow: none !important;
}

.user-css .parchment-page blockquote::before,
.user-css-extended .parchment-page blockquote::before {
  content: none !important;
  display: none !important;
}

/* Dividers */

.user-css .parchment-page hr,
.user-css-extended .parchment-page hr {
  height: 1px !important;
  margin: 28px auto !important;

  background: rgba(103, 56, 29, 0.45) !important;

  border: 0 !important;
  box-shadow: none !important;
}

/* Tables */

.user-css .parchment-page table,
.user-css-extended .parchment-page table {
  color: #3d2b1e !important;
  background: rgba(111, 67, 34, 0.045) !important;

  border-color: rgba(103, 56, 29, 0.38) !important;
  box-shadow: none !important;
}

.user-css .parchment-page th,
.user-css .parchment-page td,
.user-css-extended .parchment-page th,
.user-css-extended .parchment-page td {
  color: #3d2b1e !important;
  background: transparent !important;

  border-color: rgba(103, 56, 29, 0.28) !important;
  text-shadow: none !important;
}

.user-css .parchment-page th,
.user-css-extended .parchment-page th {
  background: rgba(111, 67, 34, 0.09) !important;
}

/* Mobile */

@media only screen and (max-width: 760px) {
  .user-css .parchment-page,
  .user-css-extended .parchment-page {
    width: 100% !important;
    min-height: 180px !important;

    margin: 20px auto 32px !important;
    padding: 18px 20px !important;

    border-width: 28px !important;

    font-size: 16px !important;
    line-height: 1.55 !important;

    filter:
      drop-shadow(0 7px 6px rgba(0, 0, 0, 0.24))
      drop-shadow(0 12px 15px rgba(0, 0, 0, 0.14)) !important;
  }

  .user-css .parchment-page blockquote,
  .user-css-extended .parchment-page blockquote {
    margin: 18px 4px !important;
    padding: 12px 14px !important;
  }
}

@media only screen and (max-width: 500px) {
  
}

