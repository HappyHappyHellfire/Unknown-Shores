/* HOMEPAGE LEARN-BOOK ARTICLE HOVER — SINGLE CLEAN SYSTEM */

html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:focus-within {
  position: relative !important;
  isolation: isolate !important;
  overflow: hidden !important;

  transform: none !important;
  filter: none !important;
  box-shadow: none !important;
}

/* Make the article panel—not .details—the containing block for the overlay. */
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel > a,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .details {
  position: static !important;
}

/* Full-card teal cover. */
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel::before {
  content: "" !important;

  position: absolute !important;
  inset: 0 !important;
  z-index: 90 !important;

  display: block !important;
  width: auto !important;
  height: auto !important;

  margin: 0 !important;
  padding: 0 !important;

  background:
    linear-gradient(
      180deg,
      #071820 0%,
      #0a242c 100%
    ) !important;

  border: 0 !important;
  border-radius: inherit !important;
  box-shadow: none !important;

  opacity: 0 !important;
  pointer-events: none !important;

  transform: none !important;
  filter: none !important;
  animation: none !important;
  transition: opacity 0.38s ease !important;
}

html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel::after {
  content: none !important;
  display: none !important;
}

html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover::before,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:focus-within::before {
  opacity: 1 !important;
}

/* Excerpt occupies the complete card above the teal cover. */
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .details p,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .details p.excerpt {
  position: absolute !important;
  inset: 0 !important;
  z-index: 100 !important;

  display: flex !important;
  visibility: visible !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;
  width: auto !important;
  min-width: 100% !important;
  max-width: none !important;
  height: auto !important;
  min-height: 100% !important;
  max-height: none !important;

  margin: 0 !important;
  padding: clamp(14px, 1.6vw, 22px) !important;
  overflow: hidden !important;

  color: #d9a76f !important;
  -webkit-text-fill-color: #d9a76f !important;

  background: transparent !important;
  border: 0 !important;
  border-radius: inherit !important;
  box-shadow: none !important;

  font-family: Cardo, EBGaramond, Garamond, serif !important;
  font-size: clamp(15px, 1.45vw, 21px) !important;
  font-style: normal !important;
  font-weight: 400 !important;
  letter-spacing: 0 !important;
  line-height: 1.5 !important;
  text-align: center !important;
  text-shadow: 0 0 2px rgba(217, 167, 111, 0.72) !important;

  opacity: 0 !important;
  pointer-events: none !important;

  transform: translateY(8px) scale(1.02) !important;
  animation: none !important;

  transition:
    opacity 0.32s ease,
    transform 0.70s ease !important;
}

html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover .details p,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover .details p.excerpt,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:focus-within .details p,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:focus-within .details p.excerpt {
  opacity: 1 !important;
  transform: none !important;
  animation: none !important;
}

