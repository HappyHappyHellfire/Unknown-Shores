  filter: none !important;
}

/* ARTICLE METADATA */

.user-css-extended .page {
  min-height: 0 !important;
  height: auto !important;
  margin: 18px auto 30px !important;
  padding: 14px 26px 18px !important;
  overflow: visible !important;
}

.user-css-extended .nav-tabs {
  margin: 0 !important;
}

.user-css-extended .tab-content,
.user-css-extended .tab-pane,
.user-css-extended .tab-content > .active {
  min-height: 0 !important;
  height: auto !important;
}

.user-css-extended .tab-content:empty,
.user-css-extended .tab-pane:empty {
  display: none !important;
}

@media only screen and (max-width: 768px) {
  .user-css-extended .page {
    margin: 10px auto 20px !important;
    padding: 10px 14px 14px !important;
  }
}

/* CREDIT CARDS */

.user-css .credit-card .credit-bio,
.user-css .credit-card .credit-bio p,
.user-css .credit-card .credit-bio span {
  color: #ddd5c7 !important;
  text-shadow: none !important;
}

.user-css .credit-card .credit-bio i,
.user-css .credit-card .credit-bio em,
.user-css .credit-card .credit-bio strong,
.user-css .credit-card .credit-bio b {
  color: #f0c38e !important;
  -webkit-text-fill-color: #f0c38e !important;
  font-weight: 600;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9) !important;
}

.user-css .credit-card .credit-links a {
  color: var(--color-link-light) !important;
}

.user-css .credit-card .credit-links a:hover {
  color: #ffe2bf !important;
}

/* ARTICLE IMAGE FRAMES */

/*
   The parchment remains a nine-slice border on the native image.
   The wrapper handles both tilt and color treatment. Applying the
   filter to the complete painted frame avoids later image-level rules
   cancelling the sepia effect while keeping the slice geometry stable.
*/

.user-css .photo-frame {
  display: block !important;
  box-sizing: border-box !important;

  width: 100% !important;
  max-width: 100% !important;

  margin: 1.6em auto !important;
  padding: 0 !important;

  overflow: visible !important;

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 0 !important;
  border-radius: 0 !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  transform:
    rotate(-0.45deg)
    translateY(0) !important;

  transform-origin: center center !important;

  backface-visibility: hidden !important;
  -webkit-backface-visibility: hidden !important;

  filter:
    sepia(1)
    saturate(0.58)
    contrast(1.1)
    brightness(0.7) !important;

  animation: none !important;

  transition:
    transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
    filter 3.2s ease-in-out !important;

  will-change: transform, filter;
}

.user-css .photo-frame .user-css-image-thumbnail,
.user-css .photo-frame .image-thumb-container,
.user-css .photo-frame .user-css-image-thumbnail a,
.user-css .photo-frame .image-thumb-container a {
  display: block !important;
  box-sizing: border-box !important;

  width: 100% !important;
  max-width: 100% !important;

  margin: 0 auto !important;
  padding: 0 !important;

  overflow: visible !important;

  color: inherit !important;

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 0 !important;
  border-radius: 0 !important;
  outline: 0 !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  font-size: 0 !important;
  line-height: 0 !important;
  text-decoration: none !important;

  transform: none !important;
  filter: none !important;

  animation: none !important;
  transition: none !important;
}

.user-css .photo-frame img,
.user-css .photo-frame img.img-responsive,
.user-css .photo-frame img.img-fluid,
.user-css .photo-frame img.img-responsive.img-fluid,
.user-css .photo-frame img.max-width-100 {
  position: relative !important;

  display: block !important;
  box-sizing: border-box !important;

  max-width: 100% !important;
  height: auto !important;

  margin: 0 auto !important;
  padding: 0 !important;

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 40px solid transparent !important;

  border-image-source:
    url(https://www.worldanvil.com/i/6986890/render) !important;

  border-image-slice: 30 !important;
  border-image-width: 1 !important;
  border-image-outset: 0 !important;
  border-image-repeat: stretch !important;

  border-radius: 0 !important;
  outline: 0 !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  -webkit-mask: none !important;
  -webkit-mask-image: none !important;

  mask: none !important;
  mask-image: none !important;

  transform: none !important;
  transform-origin: center center !important;

  backface-visibility: visible !important;
  -webkit-backface-visibility: visible !important;

  image-rendering: auto !important;

  filter: none !important;

  will-change: auto !important;

  animation: none !important;
  transition: none !important;
}

.user-css .photo-frame:hover,
.user-css .photo-frame:focus-within {
  filter:
    sepia(0)
    saturate(1)
    contrast(1.05)
    brightness(1) !important;
}

/* The wrapper moves; the framed image remains geometrically untouched. */

@media (hover: hover) and (pointer: fine) {
  .user-css .photo-frame:hover,
  .user-css .photo-frame:focus-within {
    transform:
      rotate(0.55deg)
      translateY(-7px) !important;
  }
}

/* Narrow article sidebars need a smaller physical frame, but use the
   same slice coordinates and the same native image element. */

@media only screen and (min-width: 992px) {
  .user-css .article-content-right .photo-frame img,
  .user-css .article-content-right .photo-frame img.img-responsive,
  .user-css .article-content-right .photo-frame img.img-fluid,
  .user-css .article-content-right .photo-frame img.max-width-100 {
    border-width: 28px !important;
  }
}

@media only screen and (max-width: 600px) {
  .user-css .photo-frame img,
  .user-css .photo-frame img.img-responsive,
  .user-css .photo-frame img.img-fluid,
  .user-css .photo-frame img.max-width-100 {
    border-width: 24px !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  .user-css .photo-frame,
  .user-css .photo-frame:hover,
  .user-css .photo-frame:focus-within {
    transform: none !important;
    transition: none !important;
    will-change: auto !important;
  }
}

.user-css .article-title h1,
.user-css .article-title .m-b-0,
.user-css .article-title .m-b-0 h1 {
  font-family: var(--font-display) !important;
}

/* ARTICLE HEADING HIERARCHY */

.user-css .article-content-left > h2,
.user-css .article-content-left > h3,
.user-css .article-content-left > h4,
.user-css .article-content-left > h5 {
  font-family: var(--font-display) !important;
  font-weight: 400 !important;
  font-style: normal !important;
  font-variant: normal !important;
  text-transform: none !important;
  filter: none !important;
  -webkit-text-stroke: 0.25px rgba(245, 190, 124, 0.16);
}

.user-css .article-content-left > h2,
.user-css .article-content-left > h3 {
  letter-spacing: 0.018em;
}

.user-css .article-content-left > h2 {
  color: #bd7542 !important;
  background: linear-gradient(
    180deg,
    #d7a066 0%,
    #c17a43 38%,
    #9f542e 72%,
    #c9824b 100%
  ) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  font-size: clamp(31px, 3.3vw, 48px);
  line-height: 1.18;
  border-bottom-color: rgba(193, 122, 67, 0.72) !important;
  text-shadow:
    0 1px 0 rgba(24, 9, 3, 0.98),
    1px 0 0 rgba(24, 9, 3, 0.45) !important;
}
.user-css .article-content-left > h3 {
  color: #d0925b !important;
  background: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  -webkit-text-fill-color: #d0925b !important;
  font-size: clamp(27px, 2.8vw, 40px);
  line-height: 1.2;
  text-shadow: 0 1px 0 rgba(24, 9, 3, 0.95) !important;
}

.user-css .article-content-left > h4 {
  color: #c98855 !important;
  background: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  -webkit-text-fill-color: #c98855 !important;
  text-shadow: 0 1px 0 rgba(24, 9, 3, 0.92) !important;
}

.user-css .article-content-left > h5 {
  color: #bf7b49 !important;
  background: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  -webkit-text-fill-color: #bf7b49 !important;
  text-shadow: 0 1px 0 rgba(24, 9, 3, 0.9) !important;
}

/* RAW IMAGE COMPATIBILITY */

.user-css .raw-image,
.user-css .-raw-image,
.user-css [class~="raw-image"],
.user-css-extended .raw-image,
.user-css-extended .-raw-image,
.user-css-extended [class~="raw-image"] {
  box-sizing: border-box !important;
  width: 100% !important;
  max-width: 100% !important;
  margin-inline: auto !important;
  padding: 0 !important;
  background: transparent !important;
  border: 0 !important;
  border-image: none !important;
  border-radius: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  filter: none !important;
  transform: none !important;
}

.user-css .raw-image::before,
.user-css .raw-image::after,
.user-css .-raw-image::before,
.user-css .-raw-image::after,
.user-css [class~="raw-image"]::before,
.user-css [class~="raw-image"]::after,
.user-css-extended .raw-image::before,
.user-css-extended .raw-image::after,
.user-css-extended .-raw-image::before,
.user-css-extended .-raw-image::after,
.user-css-extended [class~="raw-image"]::before,
.user-css-extended [class~="raw-image"]::after {
  content: none !important;
  display: none !important;
}

.user-css :is(.raw-image, .-raw-image, [class~="raw-image"])
  :is(.imageblock, .image-block, figure, picture, a, span),
.user-css-extended :is(.raw-image, .-raw-image, [class~="raw-image"])
  :is(.imageblock, .image-block, figure, picture, a, span) {
  box-sizing: border-box !important;
  max-width: 100% !important;
  margin-inline: auto !important;
  padding: 0 !important;
  background: transparent !important;
  border: 0 !important;
  border-image: none !important;
  border-radius: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  filter: none !important;
  transform: none !important;
}

.user-css :is(.raw-image, .-raw-image, [class~="raw-image"])
  :is(.imageblock, .image-block, figure, picture, a, span)::before,
.user-css :is(.raw-image, .-raw-image, [class~="raw-image"])
  :is(.imageblock, .image-block, figure, picture, a, span)::after,
.user-css-extended :is(.raw-image, .-raw-image, [class~="raw-image"])
  :is(.imageblock, .image-block, figure, picture, a, span)::before,
.user-css-extended :is(.raw-image, .-raw-image, [class~="raw-image"])
  :is(.imageblock, .image-block, figure, picture, a, span)::after {
  content: none !important;
  display: none !important;
}

.user-css :is(.raw-image, .-raw-image, [class~="raw-image"]) img,
.user-css img.raw-image,
.user-css img.-raw-image,
.user-css-extended :is(.raw-image, .-raw-image, [class~="raw-image"]) img,
.user-css-extended img.raw-image,
.user-css-extended img.-raw-image {
  display: block !important;
  box-sizing: border-box !important;
  width: auto !important;
  max-width: 100% !important;
  height: auto !important;
  margin: 0 auto !important;
  padding: 0 !important;
  background: transparent !important;
  border: 0 !important;
  border-image: none !important;
  border-radius: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  filter: none !important;
  -webkit-mask-image: none !important;
  mask-image: none !important;
  opacity: 1 !important;
  transform: none !important;
  transition: none !important;
  animation: none !important;
}

.user-css :is(.raw-image, .-raw-image, [class~="raw-image"]) img:hover,
.user-css img.raw-image:hover,
.user-css img.-raw-image:hover,
.user-css-extended :is(.raw-image, .-raw-image, [class~="raw-image"]) img:hover,
.user-css-extended img.raw-image:hover,
.user-css-extended img.-raw-image:hover {
  border: 0 !important;
  border-image: none !important;
  box-shadow: none !important;
  filter: none !important;
  opacity: 1 !important;
  transform: none !important;
}

/* JOURNAL PAGE NAVIGATION */

:root {
  --navigation-journal-page-image: none;
}

.user-css-presentation #world-navigation-sidebar {
  box-sizing: border-box;
  height: fit-content !important;
  min-height: 0 !important;
  max-height: calc(100vh - 80px) !important;
  overflow-x: hidden !important;
  overflow-y: auto !important;
  padding: 22px 20px 24px;

  color: #281a11;
  text-align: left !important;

  background-color: #bba580;
  background-image:
    linear-gradient(90deg, rgba(54, 31, 16, 0.16) 0%, transparent 7%, transparent 93%, rgba(54, 31, 16, 0.16) 100%),
    linear-gradient(180deg, rgba(255, 244, 214, 0.18) 0%, transparent 18%, transparent 82%, rgba(69, 39, 20, 0.12) 100%),
    radial-gradient(circle at 18% 14%, rgba(84, 51, 25, 0.11) 0 2px, transparent 3px),
    radial-gradient(circle at 78% 67%, rgba(84, 51, 25, 0.08) 0 1px, transparent 2px),
    var(--navigation-journal-page-image);
  background-position: center, center, center, center, center;
  background-size: 100% 100%, 100% 100%, 120px 120px, 95px 95px, 100% 100%;
  background-repeat: no-repeat, no-repeat, repeat, repeat, no-repeat;

  border: 1px solid #765036;
  border-top: 1px solid #765036;
  border-radius: 5px 12px 8px 4px;
  box-shadow:
    0 14px 32px rgba(0, 0, 0, 0.48),
    inset 0 0 28px rgba(67, 39, 20, 0.16),
    inset 0 0 0 1px rgba(242, 220, 176, 0.24);

  scrollbar-color: #8d5f3c rgba(65, 40, 23, 0.14);
}

.user-css-presentation #world-navigation-sidebar,
.user-css-presentation #world-navigation-sidebar .world-navigation-custom-content,
.user-css-presentation #world-navigation-sidebar .category-list,
.user-css-presentation #world-navigation-sidebar ul,
.user-css-presentation #world-navigation-sidebar li,
.user-css-presentation #world-navigation-sidebar p {
  text-align: left !important;
}

.user-css-presentation #world-navigation-sidebar .world-navigation-custom-content,
.user-css-presentation #world-navigation-sidebar .category-list,
.user-css-presentation #world-navigation-sidebar > *:last-child {
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
}

.user-css .world-navigation-custom-content h2,
.user-css-presentation #world-navigation-sidebar h2 {
  margin: 0 0 12px;
  padding: 0 0 8px;
  color: #4f2b1b;
  text-align: left !important;
  background: none;
  -webkit-background-clip: border-box;
  background-clip: border-box;
  -webkit-text-fill-color: #4f2b1b;
  text-shadow: none;
  border-bottom: 1px solid rgba(91, 55, 31, 0.58);
}

.user-css-presentation #world-navigation-sidebar a,
.user-css .world-navigation-custom-content a {
  color: #5e321f;
  text-align: left !important;
  text-shadow: none;
  transform-origin: left center;
}

.user-css-presentation #world-navigation-sidebar a:hover,
.user-css .world-navigation-custom-content a:hover {
  color: #8b482b;
  text-shadow: none;
  transform: translateX(4px);
}

.user-css-presentation #world-navigation-sidebar::-webkit-scrollbar {
  width: 7px;
}

.user-css-presentation #world-navigation-sidebar::-webkit-scrollbar-track {
  background: rgba(65, 40, 23, 0.12);
}

.user-css-presentation #world-navigation-sidebar::-webkit-scrollbar-thumb {
  background: #8d5f3c;
  border: 1px solid rgba(53, 31, 18, 0.48);
  border-radius: 999px;
}

@media only screen and (max-width: 500px) {
  .user-css-presentation #world-navigation-sidebar {
    height: fit-content !important;
    min-height: 0 !important;
    max-height: calc(100vh - 110px) !important;
    padding: 18px 16px 20px;
    background-size: 100% 100%, 100% 100%, 100px 100px, 80px 80px, 100% 100%;
  }
}

/* HOMEPAGE LOWER DECK */

:root {
  --homepage-ledger-paper-image: none;
}

/* STICKER SECTION — CLEAN RESET WITH STONE BACKGROUND */

.user-css.page-world-homepage .stickers-article-collection,
.page-world-homepage .stickers-article-collection {
  position: relative !important;
  display: flex !important;
  flex-wrap: wrap !important;
  justify-content: center !important;
  align-items: center !important;
  gap: 12px !important;

  box-sizing: border-box !important;
  width: min(340px, 100%) !important;
  min-height: 240px !important;

  margin: 18px auto !important;
  padding: 34px 20px 22px 20px !important;

  background-color: transparent !important;
  background-image: url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/4bd15c6af034ec8b5af86caac57b6edd.png) !important;
  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;

  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;

  overflow: visible !important;
}


/* Kill the old fake headings / labels */

.user-css.page-world-homepage .stickers-article-collection::before,
.user-css.page-world-homepage .stickers-article-collection::after,
.page-world-homepage .stickers-article-collection::before,
.page-world-homepage .stickers-article-collection::after {
  content: none !important;
  display: none !important;
}


/* Undo the old hidden-heading trick */

.user-css.page-world-homepage .stickers-article-collection h4,
.page-world-homepage .stickers-article-collection h4 {
  position: static !important;
  width: auto !important;
  height: auto !important;
  margin: 0 0 10px 0 !important;
  padding: 0 !important;
  overflow: visible !important;
  clip: auto !important;
  white-space: normal !important;
}


/* Neutral sticker item reset — no hover gimmicks, no forced transforms */

.user-css.page-world-homepage .stickers-article-collection .sticker-collection-sticker,
.page-world-homepage .stickers-article-collection .sticker-collection-sticker {
  position: relative !important;
  display: inline-block !important;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;

  transform: none !important;
  transition: none !important;
}


/* Sticker images themselves stay untouched for now */

.user-css.page-world-homepage .stickers-article-collection .sticker-collection-sticker img,
.user-css.page-world-homepage .stickers-article-collection img.sticker-collection-sticker,
.page-world-homepage .stickers-article-collection .sticker-collection-sticker img,
.page-world-homepage .stickers-article-collection img.sticker-collection-sticker {
  display: block !important;

  width: auto !important;
  max-width: 100% !important;
  height: auto !important;
  max-height: 120px !important;

  margin: 0 auto !important;
  padding: 0 !important;

  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;

  transform: none !important;
  transition: none !important;
  filter: none !important;
}


/* Kill the old hover behavior completely */

.user-css.page-world-homepage .stickers-article-collection .sticker-collection-sticker:hover,
.user-css.page-world-homepage .stickers-article-collection .sticker-collection-sticker:hover img,
.user-css.page-world-homepage .stickers-article-collection img.sticker-collection-sticker:hover,
.page-world-homepage .stickers-article-collection .sticker-collection-sticker:hover,
.page-world-homepage .stickers-article-collection .sticker-collection-sticker:hover img,
.page-world-homepage .stickers-article-collection img.sticker-collection-sticker:hover {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
  transform: none !important;
  filter: none !important;
}


/* Mobile */

@media only screen and (max-width: 768px) {
  .user-css.page-world-homepage .stickers-article-collection,
  .page-world-homepage .stickers-article-collection {
    width: min(320px, 100%) !important;
    min-height: 225px !important;
    padding: 30px 16px 20px 16px !important;
  }

  .user-css.page-world-homepage .stickers-article-collection .sticker-collection-sticker img,
  .user-css.page-world-homepage .stickers-article-collection img.sticker-collection-sticker,
  .page-world-homepage .stickers-article-collection .sticker-collection-sticker img,
  .page-world-homepage .stickers-article-collection img.sticker-collection-sticker {
    max-height: 100px !important;
  }
}
.user-css.page-world-homepage .btn-danger,
.user-css.page-world-homepage .btn-info,
.user-css.page-world-homepage .btn-sticker,
.user-css.page-world-homepage #likes-indicator.text-danger,
.page-world-homepage .btn-danger,
.page-world-homepage .btn-info,
.page-world-homepage .btn-sticker,
.page-world-homepage #likes-indicator.text-danger {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  min-height: 30px;
  margin: 3px 2px !important;
  padding: 6px 11px !important;
  color: #ddbd86 !important;
  background: linear-gradient(180deg, #17282c, #071114) !important;
  border: 1px solid #81512f !important;
  border-radius: 2px !important;
  box-shadow: inset 0 0 0 2px rgba(182, 118, 68, 0.06), 0 4px 9px rgba(0, 0, 0, 0.31) !important;
  font-family: var(--font-meta) !important;
  font-size: 9px !important;
  font-weight: 700 !important;
  letter-spacing: 0.07em;
  line-height: 1 !important;
  text-shadow: none !important;
  text-transform: uppercase;
  transition: transform 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease !important;
}

.user-css.page-world-homepage .btn-danger:hover,
.user-css.page-world-homepage .btn-info:hover,
.user-css.page-world-homepage .btn-sticker:hover,
.user-css.page-world-homepage #likes-indicator.text-danger:hover,
.page-world-homepage .btn-danger:hover,
.page-world-homepage .btn-info:hover,
.page-world-homepage .btn-sticker:hover,
