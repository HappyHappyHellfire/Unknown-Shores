    max-height: none;

    margin:
      0
      auto;

    visibility: visible !important;
    opacity: 1 !important;

    filter: none !important;
    transform: none !important;
    animation: none !important;
  }


  html 
  .user-css.page-world-homepage
  .medallion-cube-object
  .bookcover
  img {
    width:
      min(
        470px,
        100%
      ) !important;

