  font-weight: 400 !important;
  line-height: 1.05 !important;

  text-align: center !important;

  -webkit-text-stroke: 0.35px #2a1107 !important;
  paint-order: stroke fill !important;

  text-shadow:
    0 1px 0 #321308,
    0 2px 3px rgba(0, 0, 0, 0.92),
    0 0 5px rgba(0, 0, 0, 0.58) !important;
}


/* Membership label */

.user-css.page-world-homepage .widget-community .label,
.user-css.page-world-homepage .widget-community .badge {
  display: inline-block !important;

  margin: 0 auto 9px !important;
  padding: 5px 11px !important;

  color: #f6d49a !important;
  -webkit-text-fill-color: #f6d49a !important;

  background: rgba(26, 13, 6, 0.64) !important;

  border: 1px solid rgba(217, 167, 111, 0.52) !important;
  border-radius: 999px !important;

  box-shadow:
    inset 0 0 8px rgba(0, 0, 0, 0.38) !important;

  font-family: var(--font-meta) !important;
  font-size: 10px !important;
  line-height: 1.2 !important;
  letter-spacing: 0.05em !important;
}


/* COMMUNITY HUB BUTTON — PARCHMENT TAG */

.user-css.page-world-homepage .widget-community .btn,
.user-css.page-world-homepage .widget-community a.btn {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 6px !important;

  box-sizing: border-box !important;

  width: min(235px, 86%) !important;
  max-width: 235px !important;
  aspect-ratio: 641 / 239 !important;

  margin: 0 auto !important;
  padding: 0 26px 4px !important;

  color: #17100a !important;
  -webkit-text-fill-color: #17100a !important;

  background-color: transparent !important;
  background-image:
