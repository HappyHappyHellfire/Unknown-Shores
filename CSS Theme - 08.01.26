  -webkit-text-fill-color: #080503 !important;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/51ee28af8d8a3017bb905c0cea865f5d.png) !important;

  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;

  border: 0 !important;
  border-color: transparent !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  text-decoration: none !important;

  filter:
    brightness(1.04)
    drop-shadow(0 4px 4px rgba(0, 0, 0, 0.3)) !important;

  transform: none !important;
}


/* Make the community icon match the black lettering. */

.user-css.page-world-homepage .widget-community .btn .fa,
.user-css.page-world-homepage .widget-community a.btn .fa,
.user-css.page-world-homepage .widget-community .btn i,
.user-css.page-world-homepage .widget-community a.btn i {
  color: inherit !important;
  -webkit-text-fill-color: inherit !important;

  background: transparent !important;

  font-size: 0.95em !important;

  text-shadow: none !important;
}


/* DISCUSSION BOARDS — FLOATING WOOD SIGN */

@keyframes discussionBoardDrift {
  0% {
    transform: translateX(0) translateY(0) rotate(0deg);
  }

  18% {
    transform: translateX(2px) translateY(-4px) rotate(0.3deg);
  }

  39% {
    transform: translateX(-1px) translateY(1px) rotate(-0.18deg);
  }

  61% {
    transform: translateX(1px) translateY(-2px) rotate(0.14deg);
  }

  82% {
    transform: translateX(-2px) translateY(2px) rotate(-0.24deg);
  }

  100% {
    transform: translateX(0) translateY(0) rotate(0deg);
  }
}

html  .user-css.page-world-homepage a[href*=discussion-boards],
html  .page-world-homepage a[href*=discussion-boards] {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;

  width: min(360px, 94%) !important;
  max-width: 360px !important;
  aspect-ratio: 468 / 191 !important;

  margin: 18px auto 28px !important;
  padding: 30px 48px 27px !important;

  color: #fff0c9 !important;
  -webkit-text-fill-color: #fff0c9 !important;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/8df9c2b84639b274ed7d04d5f4baf076.png) !important;

  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;

  border: 0 !important;
  border-color: transparent !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  font-family: var(--font-header) !important;
  font-size: clamp(21px, 2.3vw, 28px) !important;
  font-style: normal !important;
  font-weight: 400 !important;
  line-height: 1.05 !important;
  letter-spacing: 0.025em !important;

  text-align: center !important;
  text-decoration: none !important;
  text-transform: none !important;

  -webkit-text-stroke: 0.35px #241006 !important;
  paint-order: stroke fill !important;

  text-shadow:
    0 1px 0 #321308,
    0 2px 3px rgba(0, 0, 0, 0.94),
    0 0 5px rgba(0, 0, 0, 0.62) !important;

  filter:
    drop-shadow(0 8px 7px rgba(0, 0, 0, 0.44)) !important;

  transform-origin: center center !important;

  animation:
    discussionBoardDrift 6.8s ease-in-out infinite !important;
}


/* Preserve the discussion sign during hover and focus. */

html  .user-css.page-world-homepage a[href*=discussion-boards]:hover,
html  .user-css.page-world-homepage a[href*=discussion-boards]:focus,
html  .page-world-homepage a[href*=discussion-boards]:hover,
