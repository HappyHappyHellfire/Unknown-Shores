  text-align: center !important;

  text-shadow:
    0 1px 1px rgba(48, 20, 7, 0.95),
    0 2px 3px rgba(0, 0, 0, 0.88) !important;

  opacity: 1 !important;

  transform: none !important;
  filter: none !important;

  animation: none !important;
}


/* ---------------------------------------------------------------
   LIKE COUNT HEART
   --------------------------------------------------------------- */

.page-article #likes-indicator i,
.page-article-main #likes-indicator i {
  position: static !important;

  display: inline-block !important;
  visibility: visible !important;

  width: auto !important;
  height: auto !important;

  margin: 0 !important;
  padding: 0 !important;

  overflow: visible !important;

  color: #e6ae63 !important;
  -webkit-text-fill-color: #e6ae63 !important;

  background: transparent !important;

  border: 0 !important;
  box-shadow: none !important;

  font-size: 18px !important;
  line-height: 1 !important;

  opacity: 1 !important;

  text-shadow:
    0 1px 1px rgba(48, 20, 7, 0.95),
    0 2px 3px rgba(0, 0, 0, 0.88) !important;

  transform: none !important;
  filter: none !important;

  animation: none !important;

  pointer-events: none !important;
}


/* Prevent old generated content from appearing on the counter icon. */

.page-article #likes-indicator i::after,
.page-article-main #likes-indicator i::after {
  content: none !important;
  display: none !important;
}


/* ---------------------------------------------------------------
   LIKE COUNT HOVER
   --------------------------------------------------------------- */

.page-article #likes-indicator:hover,
.page-article-main #likes-indicator:hover {
  transform:
    translateY(-2px)
    rotate(0.2deg) !important;

  filter:
    brightness(1.07)
    drop-shadow(
      0
      7px
      7px
      rgba(0, 0, 0, 0.46)
    ) !important;
}


/* ================================================================
   LIKE BUTTON WOODEN PLANK
   ================================================================ */

.page-article a.like-action[href$=favourite],
.page-article a.like-action[href$=favourite]:link,
.page-article a.like-action[href$=favourite]:visited,
.page-article-main a.like-action[href$=favourite],
.page-article-main a.like-action[href$=favourite]:link,
.page-article-main a.like-action[href$=favourite]:visited {
  position: relative !important;

  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  float: none !important;
  flex: none !important;
  vertical-align: middle !important;

  box-sizing: border-box !important;

  width: 280px !important;
  min-width: 280px !important;
  max-width: 280px !important;

  height: 48px !important;
  min-height: 48px !important;
  max-height: 48px !important;

  margin: 0 12px 16px 0 !important;
  padding: 6px 36px 8px !important;

  overflow: visible !important;

  color: #f4d6a1 !important;
  -webkit-text-fill-color: #f4d6a1 !important;
  caret-color: #f4d6a1 !important;

  background-color: transparent !important;

  background-image:
    url(https://wa-cdn.nyc3.cdn.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/f0f9f3770f19616d926676a63a0d5b4a.png) !important;

  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;

  border: 0 !important;
  border-width: 0 !important;
  border-style: none !important;
  border-color: transparent !important;
  border-radius: 0 !important;

  outline: none !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  font-family:
    Cardo,
    EBGaramond,
    Garamond,
    Georgia,
    serif !important;

  font-size: 18px !important;
  font-style: normal !important;
  font-weight: 400 !important;
  line-height: 1 !important;
  letter-spacing: 0.025em !important;

  white-space: nowrap !important;

  text-align: center !important;
  text-decoration: none !important;
  text-transform: none !important;

  text-shadow:
    0 1px 1px rgba(42, 17, 5, 0.98),
    0 2px 3px rgba(0, 0, 0, 0.9),
    0 0 5px rgba(0, 0, 0, 0.5) !important;

  transform-origin:
    center center !important;

  filter:
    drop-shadow(
      0
      6px
      7px
      rgba(0, 0, 0, 0.44)
    ) !important;

  animation:
    usLikePlankCalm
    4.2s
    ease-in-out
    infinite !important;

  transition:
    color 0.25s ease,
    filter 0.3s ease !important;

  cursor: pointer !important;

  -webkit-tap-highlight-color:
    transparent !important;
}


/* ---------------------------------------------------------------
   REMOVE ALL OLD GENERATED PLANK LAYERS
   --------------------------------------------------------------- */

.page-article a.like-action[href$=favourite]::before,
.page-article a.like-action[href$=favourite]::after,
.page-article-main a.like-action[href$=favourite]::before,
.page-article-main a.like-action[href$=favourite]::after {
  content: none !important;

  display: none !important;

  width: 0 !important;
  height: 0 !important;

  background: none !important;

  opacity: 0 !important;

  transform: none !important;
  filter: none !important;

  animation: none !important;
}


/* ---------------------------------------------------------------
   REMOVE NATIVE LIKE BUTTON ICON
   --------------------------------------------------------------- */

.page-article a.like-action[href$=favourite] i,
.page-article a.like-action[href$=favourite] svg,
.page-article-main a.like-action[href$=favourite] i,
.page-article-main a.like-action[href$=favourite] svg {
  position: static !important;

  display: none !important;
  visibility: hidden !important;

  width: 0 !important;
  height: 0 !important;

  margin: 0 !important;
  padding: 0 !important;

  overflow: hidden !important;

  color: transparent !important;
  -webkit-text-fill-color: transparent !important;

  background: none !important;

  border: 0 !important;
  box-shadow: none !important;

  font-size: 0 !important;
  line-height: 0 !important;

  opacity: 0 !important;

  transform: none !important;
  filter: none !important;

  animation: none !important;

  pointer-events: none !important;
}


.page-article a.like-action[href$=favourite] i::before,
.page-article a.like-action[href$=favourite] i::after,
.page-article-main a.like-action[href$=favourite] i::before,
.page-article-main a.like-action[href$=favourite] i::after {
  content: none !important;

  display: none !important;

  width: 0 !important;
  height: 0 !important;

  opacity: 0 !important;

  transform: none !important;
  filter: none !important;

  animation: none !important;
}


/* ---------------------------------------------------------------
   CALM LIKE BUTTON BOB
   --------------------------------------------------------------- */

@keyframes usLikePlankCalm {
  0% {
    transform:
      translateY(0)
      rotate(-0.65deg);
  }

  18% {
    transform:
      translateY(-2px)
      rotate(-0.42deg);
  }

  39% {
    transform:
      translateY(-5px)
      rotate(-0.78deg);
  }

  57% {
    transform:
      translateY(-3px)
      rotate(-0.28deg);
  }

  76% {
    transform:
      translateY(-6px)
      rotate(-0.56deg);
  }

  89% {
    transform:
      translateY(-2px)
      rotate(-0.36deg);
  }

  100% {
    transform:
      translateY(0)
      rotate(-0.65deg);
  }
}


/* ---------------------------------------------------------------
   LIKE BUTTON HOVER, FOCUS, AND ACTIVE
   --------------------------------------------------------------- */

.page-article a.like-action[href$=favourite]:hover,
.page-article a.like-action[href$=favourite]:focus,
.page-article a.like-action[href$=favourite]:focus-visible,
.page-article-main a.like-action[href$=favourite]:hover,
.page-article-main a.like-action[href$=favourite]:focus,
.page-article-main a.like-action[href$=favourite]:focus-visible {
  color: #ffe7bd !important;
  -webkit-text-fill-color: #ffe7bd !important;

  background-color: transparent !important;

  background-image:
    url(https://wa-cdn.nyc3.cdn.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/f0f9f3770f19616d926676a63a0d5b4a.png) !important;

  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;

  border: 0 !important;
  border-color: transparent !important;

  outline: none !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  text-decoration: none !important;

  filter:
    brightness(1.08)
    drop-shadow(
      0
      9px
      10px
      rgba(0, 0, 0, 0.5)
    ) !important;
}


.page-article a.like-action[href$=favourite]:active,
.page-article-main a.like-action[href$=favourite]:active {
  border: 0 !important;
  border-color: transparent !important;

  outline: none !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  filter:
    brightness(0.97)
    drop-shadow(
      0
      4px
      5px
      rgba(0, 0, 0, 0.4)
    ) !important;
}


/* ================================================================
   MOBILE
   ================================================================ */

@media only screen and (max-width: 520px) {

  .page-article #likes-indicator,
  .page-article-main #likes-indicator {
    width: 100px !important;
    min-width: 100px !important;
    max-width: 100px !important;

    height: 44px !important;
    min-height: 44px !important;
    max-height: 44px !important;

    margin: 0 8px 14px 0 !important;
    padding: 6px 18px 8px !important;

    gap: 6px !important;
  }


  .page-article #likes-number,
  .page-article-main #likes-number {
    font-size: 19px !important;
  }


  .page-article #likes-indicator i,
  .page-article-main #likes-indicator i {
    font-size: 16px !important;
  }


  .page-article a.like-action[href$=favourite],
  .page-article-main a.like-action[href$=favourite] {
    width: 235px !important;
    min-width: 235px !important;
    max-width: 235px !important;

    height: 44px !important;
    min-height: 44px !important;
    max-height: 44px !important;

    margin: 0 8px 14px 0 !important;
    padding: 5px 28px 7px !important;

    font-size: 16px !important;
  }
}


/* ================================================================
   REDUCED MOTION
   ================================================================ */

@media (prefers-reduced-motion: reduce) {

  .page-article a.like-action[href$=favourite],
  .page-article-main a.like-action[href$=favourite] {
    animation: none !important;

    transform:
      translateY(0)
      rotate(-0.65deg) !important;
  }
}
