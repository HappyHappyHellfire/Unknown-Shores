    0 7px 18px rgba(0, 0, 0, 0.4),
    0 0 10px rgba(217, 167, 111, 0.16) !important;
}


/* UNKNOWN SHORES COMMUNITY — FLOATING WOODEN SIGN */

@keyframes communitySignFloat {
  0% {
    transform: translateY(0) rotate(0deg);
  }

  25% {
    transform: translateY(-3px) rotate(-0.3deg);
  }

  50% {
    transform: translateY(1px) rotate(0.22deg);
  }

  75% {
    transform: translateY(-2px) rotate(-0.18deg);
  }

  100% {
    transform: translateY(0) rotate(0deg);
  }
}

.user-css.page-world-homepage .widget-community {
  position: relative !important;

  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;

  width: min(440px, 100%) !important;
  aspect-ratio: 422 / 243 !important;
  min-height: 0 !important;

  margin: 4px auto 24px !important;
  padding: 44px 54px 45px !important;

  color: #ffe1a9 !important;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/cc9fb83800784ec3d63063cf50e7f930.png) !important;

  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;

  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;

  text-align: center !important;

  filter:
    drop-shadow(0 9px 8px rgba(0, 0, 0, 0.46)) !important;

  transform-origin: center center !important;

  animation:
    communitySignFloat 5.4s ease-in-out infinite !important;
}


/* Remove the original World Anvil panel shell. */

.user-css.page-world-homepage .widget-community .panel {
