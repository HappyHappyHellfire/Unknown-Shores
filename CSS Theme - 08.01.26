  position: relative;
  box-sizing: border-box;

  width: min(720px, 96%);
  min-height: 940px;

  margin: 30px auto;
  padding: 92px 94px 104px;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/1492bb551a1210b9a9045765146eb993.png);
  background-position: center center;
  background-size: 100% 100%;
  background-repeat: no-repeat;

  color: #21170f;

  font-family:
    var(--font-),
    Georgia,
    serif;

  font-size: 15px;
  line-height: 1.46;

  border: none;
  border-radius: 0;

  box-shadow:
    0 8px 24px rgba(0, 0, 0, .45);

  overflow-wrap: break-word;
  hyphens: auto;
}

.user-css .background-card > * {
  position: relative;
  z-index: 2;
}

.user-css .background-card h5 {
  margin: 0 0 4px;
  padding: 0 0 6px;

  color: #6f251c;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-size: 2em;
  font-weight: 700;
  font-variant: small-caps;
  line-height: 1.05;
  letter-spacing: .025em;

  text-align: left;

  border-bottom: 2px solid #8b4a2f;
}

.user-css .background-card .background-meta {
  margin: 0 0 14px;
  padding: 0;

  color: #342218;

  font-size: .94em;
  font-style: italic;
  line-height: 1.3;
  text-align: left;
}

.user-css .background-card .background-meta p,
.user-css .background-card .background-meta .text-left {
  margin: 0;
  padding: 0;

  text-align: left;
}

.user-css .background-card .background-introduction {
  margin: 0 0 16px;
  padding: 0;

  font-style: italic;
  line-height: 1.48;
}

.user-css .background-card .background-details {
  margin: 0 0 16px;
  padding: 10px 12px;

  background:
    rgba(122, 67, 36, .08);

  border-top: 2px solid #7b3525;
  border-bottom: 2px solid #7b3525;

  line-height: 1.42;
}

.user-css .background-card .background-details p {
  margin: 0;
  padding: 0;
}

.user-css .background-card .background-details strong,
.user-css .background-card .background-details b {
  color: #64251c;
  font-weight: 700;
}

.user-css .background-card p {
  margin: 0 0 11px;
  padding: 0;
}

.user-css .background-card p:last-child,
.user-css .background-card > *:last-child {
  margin-bottom: 0;
}

.user-css .background-card strong,
.user-css .background-card b {
  color: #5f2119;
  font-weight: 700;
}

.user-css .background-card em,
.user-css .background-card i {
  color: #2c1c14;
}

.user-css .background-card h6 {
  margin: 18px 0 7px;
  padding: 0 0 4px;

  color: #6f251c;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-size: 1.24em;
  font-weight: 700;
  font-variant: small-caps;
  line-height: 1.15;
  letter-spacing: .02em;

  border-bottom: 1px solid rgba(111, 37, 28, .65);
}

.user-css .background-card .table-responsive {
  width: 100%;
  margin: 0 0 16px;

  overflow-x: auto;
}

.user-css .background-card table {
  width: 100%;
  margin: 0 0 16px;

  border-collapse: collapse;
  border-spacing: 0;

  background: transparent;

  color: #21170f;

  font-family:
    var(--font-),
    Georgia,
    serif;

  font-size: .9em;
  line-height: 1.32;
}

.user-css .background-card table thead,
.user-css .background-card table tr:first-child {
  border-top: 2px solid #7b3525;
  border-bottom: 2px solid #7b3525;
}

.user-css .background-card table th {
  padding: 6px 8px;

  background: rgba(122, 67, 36, .12);
  color: #64251c;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-weight: 700;
  font-variant: small-caps;
  letter-spacing: .02em;

  text-align: left;
  vertical-align: bottom;
}

.user-css .background-card table td {
  padding: 6px 8px;

  background: transparent;
  border-bottom: 1px solid rgba(93, 54, 31, .35);

  text-align: left;
  vertical-align: top;
}

.user-css .background-card table t tr:nth-child(odd) td {
  background: rgba(137, 91, 45, .07);
}

.user-css .background-card table t tr:last-child td {
  border-bottom: 2px solid #7b3525;
}

.user-css .background-card table,
.user-css .background-card table tr,
.user-css .background-card table td,
.user-css .background-card table th {
  box-shadow: none;
}

.user-css .background-card table th:first-child,
.user-css .background-card table td:first-child {
  width: 54px;
  white-space: nowrap;
  text-align: center;
}

.user-css .background-card .background-rule {
  height: 2px;

  margin: 16px 0;

  background:
    linear-gradient(
      to right,
      transparent,
      #8a4b2d 12%,
      #8a4b2d 88%,
      transparent
    );
}

/* BACKGROUND STAT CARD â€” RESPONSIVE */

@media screen and (max-width: 600px) {
  .user-css .background-card {
    width: 98%;
    min-height: 0;

    margin: 20px auto;
    padding: 62px 48px 72px;

    font-size: 13px;
    line-height: 1.4;
  }

  .user-css .background-card h5 {
    font-size: 1.65em;
  }

  .user-css .background-card .background-details {
    padding: 7px 8px;
  }

  .user-css .background-card table {
    font-size: .82em;
  }

  .user-css .background-card table th,
  .user-css .background-card table td {
    padding: 5px 4px;
  }

  .user-css .background-card table th:first-child,
  .user-css .background-card table td:first-child {
    width: 38px;
  }
}

/* TREASURE PARCHMENT */

.user-css .treasure-parchment {
  background-image: url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/05dc9ca04ddf4307f8563b32f659fd2e.png);
  background-repeat: no-repeat;
  background-size: contain;
  background-position: center center;
  width: min(100%, 920px);
  aspect-ratio: 3 / 4;
  margin: 24px auto;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: clamp(24px, 5vw, 64px);
  box-sizing: border-box;
  color: #2a1b10;
  text-align: center;
  text-shadow: 0 0 1px rgba(0, 0, 0, 0.25);
}

.user-css .treasure-parchment .tp-wrap {
  position: relative;
  width: 80%;
  height: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-css .treasure-parchment .tp-front,
.user-css .treasure-parchment .tp-back {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  font-family: var(--font-quote);
  font-size: clamp(28px, 4vw, 52px);
  line-height: 1.4;
  text-align: center;
}

.user-css .treasure-parchment .tp-front {
  color: #2a1b10;
  transform: translate(-40%, 25%) rotate(-1.5deg);
  opacity: 1;
  animation: tp-front-out 16s ease forwards;
}

.user-css .treasure-parchment .tp-back {
  transform: translate(-40%, 75%) rotate(-1.5deg);
}

.user-css .treasure-parchment .tp-line1 {
  color: #2a1b10;
  margin-bottom: 20px;
  opacity: 0;
  animation: tp-line1-in 16s ease forwards;
}

.user-css .treasure-parchment .tp-line2 {
  color: #5a1a12;
  font-style: italic;
  text-shadow: 0 0 5px rgba(48, 0, 0, 0.25);
  opacity: 0;
  animation: tp-line2-in 16s ease forwards;
}

.user-css .treasure-parchment .burn-wrapper {
  cursor: help;
}

.user-css .treasure-parchment .burn-wrapper:hover {
  cursor: pointer;
}

@media only screen and (max-width: 768px) {
  .user-css .parchment {
    width: 100%;
    margin: 18px 0 26px;
    padding: 26px 22px;
    font-size: 17px;
    line-height: 1.62;
  }
}

/* HOMEPAGE TITLE DISPLAY */

.user-css.page-world-homepage .world-title,
.user-css.page-world-homepage .world-subtitle,
.user-css.page-world-homepage .heading > h1.world-title {
  display: none !important;
}

.user-css.page-world-homepage .heading h1,
.user-css.page-world-homepage h1.world-title,
.user-css.page-world-homepage .world-title,
.user-css.page-world-homepage .world-subtitle {
  display: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* ================================================================
   HOMEPAGE MEDALLION CUBE ARCHIVE
   ALTERNATING TWO-COLUMN SCROLL SUITE
   END-RUNWAY CORRECTION
   COMPLETE REPLACEMENT
   ================================================================ */


/* ---------------------------------------------------------------
   MEDALLION SCROLL MOVEMENT
   --------------------------------------------------------------- */

@keyframes medallionCubeFaceMiddle {
  0% {
    visibility: hidden;
    opacity: 0;

    filter:
      brightness(0.62)
      drop-shadow(0 7px 9px rgba(0, 0, 0, 0.28));

    transform:
      translate3d(
        var(--cube-enter-x),
        var(--cube-enter-y),
        -110px
      )
      rotateX(var(--cube-enter-rx))
      rotateY(var(--cube-enter-ry))
      scale(0.92);
  }

  1% {
    visibility: visible;
  }

  14% {
    visibility: visible;
    opacity: 0.42;
  }

  27% {
    visibility: visible;
    opacity: 1;

    filter:
      brightness(0.98)
      drop-shadow(0 20px 18px rgba(0, 0, 0, 0.54));

    transform:
      translate3d(0, 0, 0)
      rotateX(0deg)
      rotateY(0deg)
      scale(1);
  }

  69% {
    visibility: visible;
    opacity: 1;

    filter:
      brightness(0.98)
      drop-shadow(0 20px 18px rgba(0, 0, 0, 0.54));

    transform:
      translate3d(0, 0, 0)
      rotateX(0deg)
      rotateY(0deg)
      scale(1);
  }

  84% {
    visibility: visible;
    opacity: 1;
  }

  98% {
    visibility: visible;
    opacity: 0;

    filter:
      brightness(0.62)
      drop-shadow(0 7px 9px rgba(0, 0, 0, 0.28));

    transform:
      translate3d(
        var(--cube-exit-x),
        var(--cube-exit-y),
        -110px
      )
      rotateX(var(--cube-exit-rx))
      rotateY(var(--cube-exit-ry))
      scale(0.92);
  }

  99%,
  100% {
    visibility: hidden;
    opacity: 0;

    transform:
      translate3d(
        var(--cube-exit-x),
        var(--cube-exit-y),
        -110px
      )
      rotateX(var(--cube-exit-rx))
      rotateY(var(--cube-exit-ry))
      scale(0.92);
  }
}


@keyframes medallionCubeFaceFirst {
  0%,
  69% {
    visibility: visible;
    opacity: 1;

    filter:
      brightness(0.98)
      drop-shadow(0 20px 18px rgba(0, 0, 0, 0.54));

    transform:
      translate3d(0, 0, 0)
      rotateX(0deg)
      rotateY(0deg)
      scale(1);
  }

  84% {
    visibility: visible;
    opacity: 1;
  }

  98% {
    visibility: visible;
    opacity: 0;

    filter:
      brightness(0.62)
      drop-shadow(0 7px 9px rgba(0, 0, 0, 0.28));

    transform:
      translate3d(
        var(--cube-exit-x),
        var(--cube-exit-y),
        -110px
      )
      rotateX(var(--cube-exit-rx))
      rotateY(var(--cube-exit-ry))
      scale(0.92);
  }

  99%,
  100% {
    visibility: hidden;
    opacity: 0;

    transform:
      translate3d(
        var(--cube-exit-x),
        var(--cube-exit-y),
        -110px
      )
      rotateX(var(--cube-exit-rx))
      rotateY(var(--cube-exit-ry))
      scale(0.92);
  }
}


@keyframes medallionCubeFaceLast {
  0% {
    visibility: hidden;
    opacity: 0;

    filter:
      brightness(0.62)
      drop-shadow(0 7px 9px rgba(0, 0, 0, 0.28));

    transform:
      translate3d(
        var(--cube-enter-x),
        var(--cube-enter-y),
        -110px
      )
      rotateX(var(--cube-enter-rx))
      rotateY(var(--cube-enter-ry))
      scale(0.92);
  }

  1% {
    visibility: visible;
  }

  14% {
    visibility: visible;
    opacity: 0.42;
  }

  27%,
  100% {
    visibility: visible;
    opacity: 1;

    filter:
      brightness(0.98)
      drop-shadow(0 20px 18px rgba(0, 0, 0, 0.54));

    transform:
      translate3d(0, 0, 0)
      rotateX(0deg)
      rotateY(0deg)
      scale(1);
  }
}


/* ---------------------------------------------------------------
   INFORMATION CARD MOVEMENT
   --------------------------------------------------------------- */

@keyframes medallionCubeCardMiddle {
  0%,
  31% {
    visibility: hidden;
    opacity: 0;

    transform:
      translateX(var(--card-enter-x))
      scale(0.96);
  }

  32% {
    visibility: visible;
  }

  45% {
    visibility: visible;
    opacity: 1;

    transform:
      translateX(0)
      scale(1);
  }

  64% {
    visibility: visible;
    opacity: 1;

    transform:
      translateX(0)
      scale(1);
  }

  77% {
    visibility: visible;
    opacity: 0;

    transform:
      translateX(var(--card-exit-x))
      scale(0.97);
  }

  78%,
  100% {
    visibility: hidden;
    opacity: 0;

    transform:
      translateX(var(--card-exit-x))
      scale(0.97);
  }
}


@keyframes medallionCubeCardFirst {
  0%,
  64% {
    visibility: visible;
    opacity: 1;

    transform:
      translateX(0)
      scale(1);
  }

  77% {
    visibility: visible;
    opacity: 0;

    transform:
      translateX(var(--card-exit-x))
      scale(0.97);
  }

  78%,
  100% {
    visibility: hidden;
    opacity: 0;

    transform:
      translateX(var(--card-exit-x))
      scale(0.97);
  }
}


@keyframes medallionCubeCardLast {
  0%,
  31% {
    visibility: hidden;
    opacity: 0;

    transform:
      translateX(var(--card-enter-x))
      scale(0.96);
  }

  32% {
    visibility: visible;
  }

  45%,
  100% {
    visibility: visible;
    opacity: 1;

    transform:
      translateX(0)
      scale(1);
  }
}


/* ---------------------------------------------------------------
   CLEAN ARCHIVE EXIT

   The final scene settles before the sticky  reaches the
   end of its containing block. The whole stage then fades while it
   releases, preventing the last scenes from visibly dropping.
   --------------------------------------------------------------- */

@keyframes medallionArchiveStageExit {
  0%,
  22% {
    opacity: 1;
  }

  72% {
    opacity: 0.38;
  }

  100% {
    opacity: 0;
  }
}


/* ---------------------------------------------------------------
   MEDALLION HOVER BOB
   --------------------------------------------------------------- */

@keyframes medallionHoverBob {
  0% {
    top: 0;
  }

  14% {
    top: -3px;
  }

  31% {
    top: -11px;
  }

  47% {
    top: -6px;
  }

  66% {
    top: -15px;
  }

  82% {
    top: -4px;
  }

  100% {
    top: 0;
  }
}


/* ---------------------------------------------------------------
   COMPLETE GALLERY
   --------------------------------------------------------------- */

html 
.user-css.page-world-homepage
.medallion-cube-gallery,

html 
.user-css.page-world-homepage
.medallion-cube-gallery
* {
  box-sizing: border-box;
}


/* ---------------------------------------------------------------
   WORLD ANVIL GENERATED SPACER RESET

   World Anvil inserted BR and .line-spacer nodes into scenes 01-09
   but not scenes 10-11. As direct grid children, those nodes created
   extra implicit rows and shifted the first nine scenes into a
   different vertical coordinate system. Removing them gives every
   scene one identical grid row and one shared visual stage.
   --------------------------------------------------------------- */

html 
.user-css.page-world-homepage
.medallion-cube-gallery
> br,

html 
.user-css.page-world-homepage
.medallion-cube-gallery
> .line-spacer,

html 
.user-css.page-world-homepage
.medallion-cube-stage
> br,

html 
.user-css.page-world-homepage
.medallion-cube-stage
> .line-spacer,

html 
.user-css.page-world-homepage
.medallion-cube-scene
> br,

html 
.user-css.page-world-homepage
.medallion-cube-scene
> .line-spacer {
  display: none !important;
  visibility: hidden !important;

  width: 0 !important;
  height: 0 !important;
  min-width: 0 !important;
  min-height: 0 !important;

  margin: 0 !important;
  padding: 0 !important;

  overflow: hidden !important;

  opacity: 0 !important;

  border: 0 !important;
  box-shadow: none !important;

  pointer-events: none !important;
}


html 
.user-css.page-world-homepage
.medallion-cube-gallery {
  position: relative;
  isolation: isolate;

  display: block;

  width: min(1500px, 100%);

  margin: 24px auto 0;
  padding: 0;

  overflow: visible;

  background: transparent;
  background-color: transparent;
  background-image: none;

  border: 0;
  border-radius: 0;

  box-shadow: none;
}


html 
.user-css.page-world-homepage
.medallion-cube-stage {
  position: relative;

  display: block;

  width: 100%;

  margin: 0;
  padding: 0;

  overflow: visible;

  background:
    radial-gradient(
      ellipse at center,
      rgba(20, 61, 67, 0.16) 0%,
      rgba(7, 24, 31, 0.055) 47%,
      transparent 76%
    );

  border: 0;
  border-radius: 0;

  box-shadow: none;
}


/* ---------------------------------------------------------------
   SCENE STRUCTURE
   --------------------------------------------------------------- */

html 
.user-css.page-world-homepage
.medallion-cube-scene {
  --cube-enter-x: 76px;
  --cube-enter-y: 0;

  --cube-exit-x: -76px;
  --cube-exit-y: 0;

  --cube-enter-rx: 0deg;
  --cube-enter-ry: 86deg;

  --cube-exit-rx: 0deg;
  --cube-exit-ry: -86deg;

  --card-enter-x: -170px;
  --card-exit-x: -105px;

  position: relative;

  display: grid;

  grid-template-columns:
    minmax(300px, 1fr)
    minmax(300px, 1fr);

  align-items: center;
  justify-items: center;

  column-gap:
    clamp(
      42px,
      6vw,
      110px
    );

  width: 100%;
  min-height: 690px;

  margin: 0 0 44px;

  padding:
    34px
    clamp(18px, 3vw, 50px)
    48px;

  overflow: visible;

  perspective: 1900px;
  transform-style: preserve-3d;

  background: transparent;
  background-color: transparent;
  background-image: none;

  border: 0;
  border-radius: 0;

  box-shadow: none;
}


/* ---------------------------------------------------------------
   ALTERNATING TWO-COLUMN COMPOSITION
   --------------------------------------------------------------- */

html 
.user-css.page-world-homepage
.medallion-left
.medallion-cube-object {
  grid-column: 1;
  grid-row: 1;

  justify-self: end;
}


html 
.user-css.page-world-homepage
.medallion-left
.medallion-cube-info {
  grid-column: 2;
  grid-row: 1;

  justify-self: start;

  --card-enter-x: 170px;
  --card-exit-x: 105px;

  border-right-width: 4px;
}


html 
.user-css.page-world-homepage
.medallion-right
.medallion-cube-info {
  grid-column: 1;
  grid-row: 1;

  justify-self: end;

  --card-enter-x: -170px;
  --card-exit-x: -105px;

  border-left-width: 4px;
}


html 
.user-css.page-world-homepage
.medallion-right
.medallion-cube-object {
  grid-column: 2;
  grid-row: 1;

  justify-self: start;
}


/* ---------------------------------------------------------------
   FOUR-DIRECTION MEDALLION TURNS
   --------------------------------------------------------------- */


/* RIGHT TO LEFT */

html 
.user-css.page-world-homepage
.medallion-cube-01,

html 
.user-css.page-world-homepage
.medallion-cube-05,

html 
.user-css.page-world-homepage
.medallion-cube-09 {
  --cube-enter-x: 76px;
  --cube-enter-y: 0;

  --cube-exit-x: -76px;
  --cube-exit-y: 0;

  --cube-enter-rx: 0deg;
  --cube-enter-ry: 86deg;

  --cube-exit-rx: 0deg;
  --cube-exit-ry: -86deg;
}


/* BOTTOM TO TOP */

html 
.user-css.page-world-homepage
.medallion-cube-02,

html 
.user-css.page-world-homepage
.medallion-cube-06,

html 
.user-css.page-world-homepage
.medallion-cube-10 {
  --cube-enter-x: 0;
  --cube-enter-y: 76px;

  --cube-exit-x: 0;
  --cube-exit-y: -76px;

  --cube-enter-rx: -86deg;
  --cube-enter-ry: 0deg;

  --cube-exit-rx: 86deg;
  --cube-exit-ry: 0deg;
}


/* LEFT TO RIGHT */

html 
.user-css.page-world-homepage
.medallion-cube-03,

html 
.user-css.page-world-homepage
.medallion-cube-07,

html 
.user-css.page-world-homepage
.medallion-cube-11 {
  --cube-enter-x: -76px;
  --cube-enter-y: 0;

  --cube-exit-x: 76px;
  --cube-exit-y: 0;

  --cube-enter-rx: 0deg;
  --cube-enter-ry: -86deg;

  --cube-exit-rx: 0deg;
  --cube-exit-ry: 86deg;
}


/* TOP TO BOTTOM */

html 
.user-css.page-world-homepage
.medallion-cube-04,

html 
.user-css.page-world-homepage
.medallion-cube-08 {
  --cube-enter-x: 0;
  --cube-enter-y: -76px;

  --cube-exit-x: 0;
  --cube-exit-y: 76px;

  --cube-enter-rx: 86deg;
  --cube-enter-ry: 0deg;

  --cube-exit-rx: -86deg;
  --cube-exit-ry: 0deg;
}


/* ---------------------------------------------------------------
   INFORMATION CARD
   --------------------------------------------------------------- */

html 
.user-css.page-world-homepage
.medallion-cube-info {
  position: relative;
  z-index: 20;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-self: center;

  width:
    min(
      440px,
      100%
    );

  max-height:
    calc(
      100svh - 170px
    );

  min-height: 0;

  margin: 0;

  padding:
    clamp(28px, 4vh, 42px)
    clamp(27px, 3vw, 44px)
    clamp(27px, 3.7vh, 39px);

  overflow-x: hidden;
  overflow-y: auto;

  scrollbar-width: thin;

  scrollbar-color:
    rgba(217, 167, 111, 0.5)
    rgba(0, 0, 0, 0.2);

  color: var(--color-text);
  -webkit-text-fill-color: initial;

  background:
    linear-gradient(
      145deg,
      rgba(4, 13, 19, 0.985) 0%,
      rgba(9, 35, 41, 0.975) 52%,
      rgba(3, 11, 17, 0.99) 100%
    );

  border: 1px solid var(--color-border);
  border-radius: 3px;

  box-shadow:
    0 25px 52px rgba(0, 0, 0, 0.56),
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    inset 0 0 36px rgba(217, 167, 111, 0.04);

  transform-origin: center center;
}


html 
.user-css.page-world-homepage
.medallion-cube-info::before {
  content: &quot;&quot;;

  position: absolute;
  inset: 10px;
  z-index: 0;

  display: block;

  border:
    1px solid
    rgba(217, 167, 111, 0.21);

  border-radius: 1px;

  pointer-events: none;
}


html 
.user-css.page-world-homepage
.medallion-cube-info::after {
  content: &quot;&quot;;

  position: absolute;
  left: 38px;
  right: 38px;
  bottom: 27px;
  z-index: 0;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(217, 167, 111, 0.62),
      transparent
    );

  pointer-events: none;
}


html 
.user-css.page-world-homepage
.medallion-cube-info
&gt; * {
  position: relative;
  z-index: 2;
}


/* HIDE THE VOLUME LABEL */

html 
.user-css.page-world-homepage
.medallion-cube-kicker {
  display: none !important;
  visibility: hidden !important;

  width: 0 !important;
  height: 0 !important;

  margin: 0 !important;
  padding: 0 !important;

  overflow: hidden !important;

  opacity: 0 !important;
}


/* INFORMATION CARD TITLE */

html 
.user-css.page-world-homepage
.medallion-cube-title {
  display: block;

  width: 100%;

  margin: 0 0 15px;
  padding: 0 0 11px;

  overflow: visible;

  color: #f0c38e;
  -webkit-text-fill-color: #f0c38e;

  background: transparent;

  border: 0;
  border-bottom:
    1px solid
    rgba(217, 167, 111, 0.42);

  box-shadow: none;

  font-family:
    var(--font-header, Georgia, serif);

  font-size:
    clamp(
      29px,
      4.4vh,
      48px
    );

  font-style: normal;
  font-weight: 400;
  line-height: 1.08;
  letter-spacing: 0.02em;

  text-align: left;
  text-decoration: none;
  text-transform: none;

  overflow-wrap: normal;
  word-break: normal;

  text-shadow:
    0 2px 3px rgba(0, 0, 0, 0.9),
    0 0 14px rgba(217, 167, 111, 0.14);
}


/* INFORMATION CARD COPY */

html 
.user-css.page-world-homepage
.medallion-cube-copy {
  display: block;

  width: 100%;

  margin: 0;
  padding: 0 0 15px;

  color: #ddd5c7;
  -webkit-text-fill-color: #ddd5c7;

  background: transparent;

  border: 0;

  box-shadow: none;

  font-family:
    var(--font-, Georgia, serif);

  font-size:
    clamp(
      14px,
      1.9vh,
      19px
    );

  font-style: normal;
  font-weight: 400;
  line-height: 1.52;
  letter-spacing: 0;

  text-align: left;
  text-decoration: none;
  text-transform: none;

  overflow-wrap: normal;
  word-break: normal;

  text-shadow:
    0 1px 2px rgba(0, 0, 0, 0.9);
}


/* ---------------------------------------------------------------
   CENTRAL MEDALLION OBJECT
   --------------------------------------------------------------- */

html 
.user-css.page-world-homepage
.medallion-cube-object {
  position: relative;
  z-index: 10;
  isolation: isolate;

  display: flex;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;

  width:
    min(
      540px,
      44vw,
      calc(100svh - 180px)
    );

  max-width: 540px;

  max-height:
    calc(
      100svh - 180px
    );

  aspect-ratio: 1 / 1;

  margin: 0;
  padding: 0;

  overflow: visible;

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 0 !important;
  border-width: 0 !important;
  border-style: none !important;
  border-color: transparent !important;
  border-radius: 0 !important;

  outline: 0 !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  perspective: 1900px;
  transform-style: preserve-3d;
  transform-origin: center center;

  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}


/* REMOVE ALL MEDALLION BACKING ELEMENTS */

html 
.user-css.page-world-homepage
.medallion-cube-object::before,

html 
.user-css.page-world-homepage
.medallion-cube-object::after {
  content: none !important;

  display: none !important;

  width: 0 !important;
  height: 0 !important;

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 0 !important;
  border-radius: 0 !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  filter: none !important;

  pointer-events: none !important;
}


/* ---------------------------------------------------------------
   WORLD ANVIL BOOK WIDGET RESET
   --------------------------------------------------------------- */

html 
.user-css.page-world-homepage
.medallion-cube-object
.bookcover {
  position: absolute !important;
  inset: 0 !important;
  z-index: 3 !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;

  width: 100% !important;
  max-width: none !important;

  height: 100% !important;
  min-height: 0 !important;
  max-height: none !important;

  margin: 0 !important;
  padding: 0 !important;

  overflow: visible !important;

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 0 !important;
  border-width: 0 !important;
  border-style: none !important;
  border-color: transparent !important;
  border-radius: 0 !important;

  outline: 0 !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  text-align: center !important;

  transform: none !important;
  transform-style: preserve-3d !important;

  animation: none !important;
  transition: none !important;
}


/* REMOVE OLD BOOKCOVER DECORATION */

html 
.user-css.page-world-homepage
.medallion-cube-object
.bookcover::before,

html 
.user-css.page-world-homepage
.medallion-cube-object
.bookcover::after {
  content: none !important;

  display: none !important;

  width: 0 !important;
  height: 0 !important;

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 0 !important;
  border-radius: 0 !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  filter: none !important;

  pointer-events: none !important;
}


/* HIDE WORLD ANVIL EDIT CONTROLS */

html 
.user-css.page-world-homepage
.medallion-cube-object
.float-bottom-right,

html 
.user-css.page-world-homepage
.medallion-cube-object
.world-editor-link {
  display: none !important;
}


/* HIDE NATIVE BOOK TITLE AND EXCERPT */

html 
.user-css.page-world-homepage
.medallion-cube-object
.booktitle,

html 
.user-css.page-world-homepage
.medallion-cube-object
.excerpt {
  display: none !important;
  visibility: hidden !important;

  width: 0 !important;
  height: 0 !important;

  margin: 0 !important;
  padding: 0 !important;

  opacity: 0 !important;

  pointer-events: none !important;
}


/* REMOVE AUTOMATIC WORLD ANVIL SPACING */

html 
.user-css.page-world-homepage
.medallion-cube-object
&gt; br,

html 
.user-css.page-world-homepage
.medallion-cube-object
&gt; .line-spacer {
  display: none !important;
}


/* CATEGORY LINK */

html 
.user-css.page-world-homepage
.medallion-cube-object
.bookcover
&gt; a {
  position: relative !important;
  z-index: 5 !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;

  width: 100% !important;
  height: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  color: inherit !important;

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 0 !important;
  border-radius: 0 !important;

  outline: 0 !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  text-decoration: none !important;

  transform: none !important;

  animation: none !important;
  transition: none !important;
}


/* ---------------------------------------------------------------
   MEDALLION ARTWORK
   --------------------------------------------------------------- */

html 
.user-css.page-world-homepage
.medallion-cube-object
.bookcover
img,

html 
.user-css.page-world-homepage
.medallion-cube-object
.bookcover
.img-responsive,

html 
.user-css.page-world-homepage
.medallion-cube-object
.bookcover
.img-fluid,

html 
.user-css.page-world-homepage
.medallion-cube-object
.bookcover
.img-responsive.img-fluid {
  position: relative !important;
  top: 0;
  z-index: 6 !important;

  display: block !important;

  width:
    min(
      100%,
      540px
    ) !important;

  max-width: 100% !important;

  height: auto !important;

  max-height:
    calc(
      100svh - 180px
    ) !important;

  margin: 0 auto !important;
  padding: 0 !important;

  object-fit: contain !important;
  object-position: center center !important;

  opacity: 1 !important;

  cursor: pointer !important;

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 0 !important;
  border-image: none !important;
  border-radius: 0 !important;

  outline: 0 !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  filter:
    brightness(0.98)
    drop-shadow(0 17px 15px rgba(0, 0, 0, 0.55))
    drop-shadow(0 0 20px rgba(217, 167, 111, 0.15)) !important;

  transform: none !important;
  transform-origin: center center !important;

  backface-visibility: hidden !important;
  -webkit-backface-visibility: hidden !important;

  animation: none !important;

  transition:
    filter 0.32s ease !important;

  will-change:
    top,
    filter;
}


/* ---------------------------------------------------------------
   MEDALLION-ONLY HOVER
   --------------------------------------------------------------- */

html 
.user-css.page-world-homepage
.medallion-cube-object
.bookcover
img:hover,

html 
.user-css.page-world-homepage
.medallion-cube-object
.bookcover
.img-responsive:hover,

html 
.user-css.page-world-homepage
.medallion-cube-object
.bookcover
.img-fluid:hover,

html 
.user-css.page-world-homepage
.medallion-cube-object
.bookcover
.img-responsive.img-fluid:hover {
  filter:
    brightness(1.1)
    drop-shadow(0 18px 17px rgba(0, 0, 0, 0.62))
    drop-shadow(0 0 14px rgba(240, 195, 142, 0.76))
    drop-shadow(0 0 32px rgba(217, 167, 111, 0.58))
    drop-shadow(0 0 58px rgba(143, 79, 45, 0.46)) !important;

  animation:
    medallionHoverBob
    4.4s
    cubic-bezier(0.42, 0, 0.35, 1)
    infinite !important;
}


/* ================================================================
   DESKTOP SCROLL VERSION
   ================================================================ */

@supports (animation-timeline: view()) {

  @media only screen and (min-width: 981px) {

    html 
    .user-css.page-world-homepage
    .medallion-cube-gallery {
      min-height: 1600vh;

      margin-top: 24px;
      margin-bottom: 0;

      view-timeline-name: --medallion-cube-timeline;
      view-timeline-axis: block;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-stage {
      position: sticky;
      top: 0;

      width: 100%;

      height: 100vh;
      height: 100svh;
      min-height: 600px;

      margin: 0;
      padding: 0;

      overflow: visible;

      perspective: 2100px;
      transform-style: preserve-3d;

      animation-name:
        medallionArchiveStageExit;

      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;

      animation-timeline:
        --medallion-cube-timeline;

      animation-range:
        cover 93.1%
        cover 100%;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-scene {
      position: absolute;

      top:
        clamp(
          94px,
          11vh,
          124px
        );

      right: 0;

      bottom:
        clamp(
          24px,
          4vh,
          48px
        );

      left: 0;

      grid-template-columns:
        minmax(300px, 1fr)
        minmax(300px, 1fr);

      align-items: center;

      width: 100%;
      height: auto;
      min-height: 0;

      margin: 0;

      padding:
        0
        clamp(22px, 3vw, 54px);

      overflow: visible;

      background: transparent;
      background-color: transparent;
      background-image: none;

      transform-style: preserve-3d;

      pointer-events: none;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-object,

    html 
    .user-css.page-world-homepage
    .medallion-cube-info {
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --medallion-cube-timeline;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-object {
      visibility: hidden;
      opacity: 0;

      animation-name:
        medallionCubeFaceMiddle;

      pointer-events: auto;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-info {
      visibility: hidden;
      opacity: 0;

      animation-name:
        medallionCubeCardMiddle;

      pointer-events: auto;
    }


    /* FIRST SCENE */

    html 
    .user-css.page-world-homepage
    .medallion-cube-01
    .medallion-cube-object {
      animation-name:
        medallionCubeFaceFirst;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-01
    .medallion-cube-info {
      animation-name:
        medallionCubeCardFirst;
    }


    /* LAST SCENE */

    html 
    .user-css.page-world-homepage
    .medallion-cube-11
    .medallion-cube-object {
      animation-name:
        medallionCubeFaceLast;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-11
    .medallion-cube-info {
      animation-name:
        medallionCubeCardLast;
    }


    /* -----------------------------------------------------------
       COMPRESSED SCENE RANGES

       Every scene finishes before the sticky stage reaches its
       physical release zone. The final portion of the gallery is
       reserved exclusively for the controlled stage fade.
       ----------------------------------------------------------- */

    html 
    .user-css.page-world-homepage
    .medallion-cube-01
    :is(
      .medallion-cube-object,
      .medallion-cube-info
    ) {
      animation-range:
        cover 0%
        cover 10.1%;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-02
    :is(
      .medallion-cube-object,
      .medallion-cube-info
    ) {
      animation-range:
        cover 8.3%
        cover 18.4%;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-03
    :is(
      .medallion-cube-object,
      .medallion-cube-info
    ) {
      animation-range:
        cover 16.6%
        cover 26.7%;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-04
    :is(
      .medallion-cube-object,
      .medallion-cube-info
    ) {
      animation-range:
        cover 24.9%
        cover 35%;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-05
    :is(
      .medallion-cube-object,
      .medallion-cube-info
    ) {
      animation-range:
        cover 33.2%
        cover 43.3%;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-06
    :is(
      .medallion-cube-object,
      .medallion-cube-info
    ) {
      animation-range:
        cover 41.5%
        cover 51.6%;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-07
    :is(
      .medallion-cube-object,
      .medallion-cube-info
    ) {
      animation-range:
        cover 49.8%
        cover 59.9%;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-08
    :is(
      .medallion-cube-object,
      .medallion-cube-info
    ) {
      animation-range:
        cover 58.1%
        cover 68.2%;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-09
    :is(
      .medallion-cube-object,
      .medallion-cube-info
    ) {
      animation-range:
        cover 66.4%
        cover 76.5%;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-10
    :is(
      .medallion-cube-object,
      .medallion-cube-info
    ) {
      animation-range:
        cover 74.7%
        cover 84.8%;
    }


    html 
    .user-css.page-world-homepage
    .medallion-cube-11
    :is(
      .medallion-cube-object,
      .medallion-cube-info
    ) {
      animation-range:
        cover 83%
        cover 93.1%;
    }


    /* INCOMING SCENES ABOVE OUTGOING SCENES */

    html 
    .user-css.page-world-homepage
    .medallion-cube-01 {
      z-index: 1;
    }

    html 
    .user-css.page-world-homepage
    .medallion-cube-02 {
      z-index: 2;
    }

    html 
    .user-css.page-world-homepage
    .medallion-cube-03 {
      z-index: 3;
    }

    html 
    .user-css.page-world-homepage
    .medallion-cube-04 {
      z-index: 4;
    }

    html 
    .user-css.page-world-homepage
    .medallion-cube-05 {
      z-index: 5;
    }

    html 
    .user-css.page-world-homepage
    .medallion-cube-06 {
      z-index: 6;
    }

    html 
    .user-css.page-world-homepage
    .medallion-cube-07 {
      z-index: 7;
    }

    html 
    .user-css.page-world-homepage
    .medallion-cube-08 {
      z-index: 8;
    }

    html 
    .user-css.page-world-homepage
    .medallion-cube-09 {
      z-index: 9;
    }

    html 
    .user-css.page-world-homepage
    .medallion-cube-10 {
      z-index: 10;
    }

    html 
    .user-css.page-world-homepage
    .medallion-cube-11 {
      z-index: 11;
    }
  }
}


