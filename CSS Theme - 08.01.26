/* RACE / SPECIES STAT CARD */

.user-css .race-card {
  position: relative;
  isolation: isolate;
  box-sizing: border-box;

  width: min(920px, 96%);
  min-height: 1235px;

  margin: 30px auto;
  padding: 84px 88px 96px;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/8e60a76449eae43203dde2ac7c45dc5d.png);
  background-position: center center;
  background-size: 100% 100%;
  background-repeat: no-repeat;

  color: #21170f;

  font-family:
    var(--font-),
    Georgia,
    serif;

  font-size: 15px;
  line-height: 1.46;

  border: none;
  border-radius: 0;

  box-shadow:
    0 8px 24px rgba(0, 0, 0, .45);

  overflow: hidden;
  overflow-wrap: break-word;
  hyphens: auto;
}

.user-css .race-card > * {
  position: relative;
  z-index: 2;
}

.user-css .race-card :is(
  p,
  section,
  li,
  td,
  th,
  span,
  strong,
  b,
  em,
  i
) {
  color: #21170f !important;
  -webkit-text-fill-color: #21170f !important;
  text-shadow: none !important;
  filter: none !important;
}

.user-css .race-card .race-card-title {
  margin: 0 0 8px;
  padding: 0 0 8px;

  color: #6f251c !important;
  -webkit-text-fill-color: #6f251c !important;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-size: clamp(44px, 6vw, 70px);
  font-weight: 700;
  font-variant: small-caps;
  line-height: 1;
  letter-spacing: .025em;
  text-align: left;

  border-bottom: 2px solid #8b4a2f;
}

.user-css .race-card .race-card-flavor {
  margin: 0 0 18px;
  padding: 0;

  font-size: 1em;
  font-style: italic;
  line-height: 1.48;
}

.user-css .race-card .race-card-paragraph {
  margin: 0 0 10px;
  padding: 0;
}

.user-css .race-card .race-card-summary {
  margin: 16px 0 20px;
  padding: 10px 12px;

  background: rgba(122, 67, 36, .08);

  border-top: 2px solid #7b3525;
  border-bottom: 2px solid #7b3525;

  line-height: 1.44;
}

.user-css .race-card .race-card-summary > *:last-child {
  margin-bottom: 0;
}

.user-css .race-card .race-card-columns {
  column-count: 2;
  column-gap: 34px;
  column-rule: 1px solid rgba(111, 37, 28, .28);
}

.user-css .race-card .race-card-section-title {
  margin: 16px 0 6px;
  padding: 0 0 4px;

  color: #6f251c !important;
  -webkit-text-fill-color: #6f251c !important;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-size: 1.48em;
  font-weight: 700;
  font-variant: small-caps;
  line-height: 1.12;
  letter-spacing: .02em;

  border-bottom: 1px solid rgba(111, 37, 28, .65);

  break-after: avoid-column;
  page-break-after: avoid;
}

.user-css .race-card .race-card-section-title:first-child {
  margin-top: 0;
}

.user-css .race-card .race-card-intro {
  margin: 0 0 9px;
  padding: 0;

  font-style: italic;
  line-height: 1.4;

  break-after: avoid-column;
  page-break-after: avoid;
}

.user-css .race-card .race-card-rule {
  position: relative;

  margin: 0 0 9px;
  padding: 0 0 0 1.05em;

  line-height: 1.42;

  break-inside: avoid-column;
  page-break-inside: avoid;
}

.user-css .race-card .race-card-rule::before {
  content: "◆";

  position: absolute;
  top: .12em;
  left: 0;

  color: #6f251c;

  font-size: .64em;
  line-height: 1;
}

.user-css .race-card .race-card-rule strong,
.user-css .race-card .race-card-rule b {
  color: #5f2119 !important;
  -webkit-text-fill-color: #5f2119 !important;
  font-weight: 700;
}

.user-css .race-card .race-card-note {
  margin: 12px 0 0;
  padding: 9px 11px;

  background: rgba(122, 67, 36, .07);
  border-left: 3px solid #7b3525;

  font-size: .94em;
  line-height: 1.42;

  break-inside: avoid-column;
  page-break-inside: avoid;
}

.user-css .race-card a {
  color: #6f251c !important;
  -webkit-text-fill-color: #6f251c !important;
  text-decoration-color: rgba(111, 37, 28, .45);
}

.user-css .race-card a:hover {
  color: #8b2e21 !important;
  -webkit-text-fill-color: #8b2e21 !important;
  text-shadow: none !important;
}

@media screen and (max-width: 760px) {
  .user-css .race-card {
    width: 98%;
    min-height: 0;

    margin: 20px auto;
    padding: 62px 44px 72px;

    font-size: 13px;
    line-height: 1.4;
  }

  .user-css .race-card .race-card-title {
    font-size: clamp(38px, 12vw, 56px);
  }

  .user-css .race-card .race-card-columns {
    column-count: 1;
    column-gap: 0;
    column-rule: none;
  }

  .user-css .race-card .race-card-section-title {
    font-size: 1.4em;
  }
}

@media screen and (max-width: 460px) {
  .user-css .race-card {
    width: 100%;
    padding: 52px 32px 60px;

    font-size: 12px;
  }
}

/* UNKNOWN SHORES — CINEMATIC CREDITS */

@keyframes usCreditsFade {
  0% {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(8px);
    filter: blur(2px);
  }

  0.45% {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateY(0);
    filter: none;
  }

  3.2% {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateY(0);
    filter: none;
  }

  4% {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(-8px);
    filter: blur(2px);
  }

  100% {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(-8px);
    filter: blur(2px);
  }
}


/* STONE CREDITS FRAME */

.user-css .team-credits-rotator {
  position: relative !important;

  display: block !important;

  box-sizing: border-box !important;

  width: min(720px, 100%) !important;
  max-width: 720px !important;

  aspect-ratio: 635 / 238 !important;
  min-height: 0 !important;

  margin: 32px auto !important;
  padding: 0 !important;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/805dc962ecc714e271f0a236a47794c7.png) !important;

  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;

  border: 0 !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  filter:
    drop-shadow(0 10px 10px rgba(0, 0, 0, 0.45)) !important;

  overflow: hidden !important;
}


/* SHARED CREDIT CARD POSITION */

.user-css .team-credits-rotator .team-credit {
  position: absolute !important;

  top: 24% !important;
  right: 13% !important;
  bottom: 22% !important;
  left: 13% !important;

  z-index: 2 !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;

  width: auto !important;
  max-width: none !important;

  height: auto !important;
  max-height: none !important;

  margin: 0 !important;
  padding: 6px 14px !important;

  color: #fff0c9 !important;
  -webkit-text-fill-color: #fff0c9 !important;

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 0 !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  font-family: var(--font-header) !important;
  font-size: clamp(22px, 2.35vw, 32px) !important;
  font-style: normal !important;
  font-weight: 400 !important;
  line-height: 1.15 !important;

  text-align: center !important;

  -webkit-text-stroke: 0.3px #180a04 !important;
  paint-order: stroke fill !important;

  text-shadow:
    0 2px 3px rgba(0, 0, 0, 0.96),
    0 0 7px rgba(0, 0, 0, 0.76) !important;

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transform: translateY(8px);

  animation-name: usCreditsFade !important;
  animation-duration: 125s !important;
  animation-timing-function: ease-in-out !important;
  animation-iteration-count: infinite !important;
  animation-fill-mode: both !important;

  transition: none !important;
}


/* WORLD ANVIL CONTENT RESET */

.user-css .team-credits-rotator .team-credit p {
  margin: 0 !important;
  padding: 0 !important;

  color: inherit !important;
  -webkit-text-fill-color: inherit !important;

  background: transparent !important;

  font: inherit !important;
  line-height: inherit !important;

  text-align: inherit !important;
  text-shadow: inherit !important;
}


/* CREDIT ROLE LABELS */

.user-css .team-credits-rotator .team-credit b,
.user-css .team-credits-rotator .team-credit strong {
  display: inline !important;

  margin: 0 0.25em 0 0 !important;
  padding: 0 !important;

  color: #d9a76f !important;
  -webkit-text-fill-color: #d9a76f !important;

  background: transparent !important;

  font-family: var(--font-meta) !important;
  font-size: 0.42em !important;
  font-weight: 700 !important;
  line-height: 1.2 !important;
  letter-spacing: 0.08em !important;

  text-transform: uppercase !important;

  -webkit-text-stroke: 0 !important;

  text-shadow:
    0 1px 2px rgba(0, 0, 0, 0.94) !important;
}


/* CREDIT LINKS */

.user-css .team-credits-rotator a {
  color: #d9a76f !important;
  -webkit-text-fill-color: #d9a76f !important;

  background: transparent !important;

  font-family: inherit !important;
  font-size: inherit !important;
  font-weight: inherit !important;

  text-decoration: none !important;

  text-shadow:
    0 2px 3px rgba(0, 0, 0, 0.96),
    0 0 6px rgba(0, 0, 0, 0.7) !important;

  transform: none !important;
}

.user-css .team-credits-rotator a:hover,
.user-css .team-credits-rotator a:focus {
  color: #ffffff !important;
  -webkit-text-fill-color: #ffffff !important;

  background: transparent !important;

  text-decoration: underline !important;

  filter:
    brightness(1.12)
    drop-shadow(0 0 4px rgba(217, 167, 111, 0.42)) !important;

  transform: none !important;
}


/* OPENING CREDITS TITLE */

.user-css .team-credits-rotator .team-credit-title {
  display: block !important;

  width: 100% !important;
  max-width: 100% !important;

  margin: 0 auto !important;
  padding: 0 !important;

  color: #fff0c9 !important;
  -webkit-text-fill-color: #fff0c9 !important;

  background: transparent !important;

  font-family: var(--font-display) !important;
  font-size: clamp(36px, 4.8vw, 62px) !important;
  font-weight: 400 !important;
  line-height: 1 !important;
  letter-spacing: 0.06em !important;

  text-align: center !important;

  -webkit-text-stroke: 0.45px #180a04 !important;

  text-shadow:
    0 3px 4px rgba(0, 0, 0, 0.96),
    0 0 10px rgba(217, 167, 111, 0.22) !important;
}


/* LEGAL CARDS */

.user-css .team-credits-rotator .team-credit-legal {
  width: 100% !important;
  max-width: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  color: #e6e1d8 !important;
  -webkit-text-fill-color: #e6e1d8 !important;

  background: transparent !important;

  font-family: var(--font-meta) !important;
  font-size: clamp(11px, 1.2vw, 15px) !important;
  font-weight: 400 !important;
  line-height: 1.42 !important;
  letter-spacing: 0.01em !important;

  text-align: center !important;

  -webkit-text-stroke: 0 !important;

  text-shadow:
    0 1px 2px rgba(0, 0, 0, 0.96) !important;
}


/* THANK-YOU CARD */

.user-css .team-credits-rotator .team-credit-thanks {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;

  width: 100% !important;
  height: 100% !important;

  margin: 0 !important;
  padding: 4px 18px 8px !important;

  background: transparent !important;

  text-align: center !important;
}

.user-css
.team-credits-rotator
.team-credit-thanks
.team-credit-title {
  display: block !important;

  width: 100% !important;
  max-width: 92% !important;

  margin: 0 auto !important;
  padding: 0 !important;

  color: #fff0c9 !important;
  -webkit-text-fill-color: #fff0c9 !important;

  font-family: var(--font-display) !important;
  font-size: clamp(25px, 2.8vw, 39px) !important;
  font-weight: 400 !important;
  line-height: 0.98 !important;
  letter-spacing: 0.018em !important;

  white-space: normal !important;
  text-align: center !important;

  -webkit-text-stroke: 0.35px #180a04 !important;

  text-shadow:
    0 2px 3px rgba(0, 0, 0, 0.96),
    0 0 8px rgba(217, 167, 111, 0.2) !important;

  transform: none !important;
}


/* FINAL FAREWELL CARD */

.user-css .team-credits-rotator .team-credit-farewell {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;

  width: 100% !important;
  height: 100% !important;

  margin: 0 !important;
  padding: 0 18px !important;

  background: transparent !important;

  text-align: center !important;
}

.user-css .team-credits-rotator .team-credit-farewell em,
.user-css .team-credits-rotator .team-credit-farewell i {
  margin: 0 !important;
  padding: 0 !important;

  color: #d9a76f !important;
  -webkit-text-fill-color: #d9a76f !important;

  background: transparent !important;

  font-family: var(--font-) !important;
  font-size: clamp(20px, 2.2vw, 30px) !important;
  font-style: italic !important;
  font-weight: 400 !important;
  line-height: 1.2 !important;

  text-align: center !important;

  -webkit-text-stroke: 0 !important;

  text-shadow:
    0 1px 2px rgba(0, 0, 0, 0.94),
    0 0 6px rgba(0, 0, 0, 0.55) !important;
}


/* 25 CARDS — FIVE SECONDS EACH */

.team-credits-rotator .team-credit:nth-of-type(1) {
  animation-delay: 0s !important;
}

.team-credits-rotator .team-credit:nth-of-type(2) {
