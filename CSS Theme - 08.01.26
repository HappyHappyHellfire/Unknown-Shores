  transform: translateY(-3px);
}




/* RSS FEED — STONE SLAB BUTTON */
html  .user-css.page-world-homepage a:has(.fa-rss),
html  .page-world-homepage a:has(.fa-rss) {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;

  width: 160px !important;
  max-width: 100% !important;
  aspect-ratio: 292 / 186 !important;

  margin: 18px auto 10px !important;
  padding: 18px 18px 15px !important;

  color: #fff3cf !important;
  -webkit-text-fill-color: #fff3cf !important;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/4bd15c6af034ec8b5af86caac57b6edd.png) !important;

  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;

  border: 0 !important;
  border-color: transparent !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  font-family: var(--font-display) !important;
  font-size: 16px !important;
  font-style: normal !important;
  font-weight: 700 !important;
  line-height: 1.05 !important;
  letter-spacing: 0.025em !important;

  text-align: center !important;
  text-decoration: none !important;
  text-transform: none !important;

  -webkit-text-stroke: 0.65px #170b04 !important;
  paint-order: stroke fill !important;

  text-shadow:
    -1px -1px 0 #170b04,
     1px -1px 0 #170b04,
    -1px  1px 0 #170b04,
     1px  1px 0 #170b04,
     0 2px 3px rgba(0, 0, 0, 0.95),
     0 0 5px rgba(0, 0, 0, 0.8) !important;

  overflow: hidden !important;

  filter: none !important;
  transform: none !important;

  transition:
    transform 0.25s ease,
    filter 0.25s ease !important;
}


/* Preserve the slab on hover and focus. */

html  .user-css.page-world-homepage a:has(.fa-rss):hover,
html  .user-css.page-world-homepage a:has(.fa-rss):focus,
html  .page-world-homepage a:has(.fa-rss):hover,
html  .page-world-homepage a:has(.fa-rss):focus {
  color: #ffffff !important;
  -webkit-text-fill-color: #ffffff !important;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/4bd15c6af034ec8b5af86caac57b6edd.png) !important;

  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;

  border: 0 !important;
  border-color: transparent !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  text-decoration: none !important;

  filter:
    brightness(1.08)
    drop-shadow(0 5px 5px rgba(0, 0, 0, 0.42)) !important;

  transform: translateY(-2px) scale(1.025) !important;
}


/* Hide the small RSS icon but retain it as the selector hook. */

html  .user-css.page-world-homepage a:has(.fa-rss) .fa-rss,
html  .page-world-homepage a:has(.fa-rss) .fa-rss {
  display: none !important;
}




/* SUPPORT BUTTONS — INDIVIDUAL STONE FRAMES */

html  .article-social-media .row:first-child {
  display: flex !important;
  flex-wrap: nowrap !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;

  width: 100% !important;
  max-width: 100% !important;

  gap: 20px !important;

  margin: 18px auto 10px !important;
  padding: 0 !important;

  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;

  text-align: center !important;
}


/* Each Bootstrap column becomes one complete framed button. */

html  .article-social-media .row:first-child .col-md-6 {
  position: relative !important;

  display: flex !important;
  flex: 0 1 300px !important;
  align-items: stretch !important;
  justify-content: stretch !important;

  float: none !important;

  box-sizing: border-box !important;

  width: 300px !important;
  max-width: calc(50% - 10px) !important;

  aspect-ratio: 552 / 182 !important;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;

  border-style: solid !important;
  border-color: transparent !important;

  /*
    Scaled from the original 552 × 182 image:

    top:    51px
    right:  56px
    bottom: 42px
    left:   55px
  */

  border-width:
    28px
    30px
    23px
    30px !important;

  border-image-source:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/ef3fbd04e55902f4801cd7b7d54c5817.png) !important;

  border-image-slice:
    51
    56
    42
    55 !important;

  border-image-width:
    28px
    30px
    23px
    30px !important;

  border-image-outset: 0 !important;
  border-image-repeat: stretch !important;

  border-radius: 0 !important;
  box-shadow: none !important;

  overflow: visible !important;

  text-align: center !important;
}


/* The clickable link fills only the opening inside the frame. */

html  .article-social-media .row:first-child .col-md-6 a {
  position: relative !important;

  display: flex !important;
  flex: 1 1 auto !important;
  align-items: stretch !important;
  justify-content: stretch !important;

  box-sizing: border-box !important;

  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;

  height: 100% !important;
  min-height: 0 !important;
  max-height: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;

  border: 0 !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  opacity: 1 !important;
  visibility: visible !important;

  transform: none !important;
  animation: none !important;
}


/* Patreon and Ko-Fi images fill the framed opening. */

html  .article-social-media .row:first-child .col-md-6 a img {
  position: relative !important;

  display: block !important;
  flex: 1 1 auto !important;

  box-sizing: border-box !important;

  width: 100% !important;
  min-width: 100% !important;
  max-width: 100% !important;

  height: 100% !important;
  min-height: 100% !important;
  max-height: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  object-fit: fill !important;

  background: transparent !important;

  border: 0 !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  opacity: 1 !important;
  visibility: visible !important;

  filter: none !important;
  transform: none !important;
  animation: none !important;
}


/* Remove the old alternate-label layers. */

html  .article-social-media .row:first-child .col-md-6 a::before,
html  .article-social-media .row:first-child .col-md-6 a::after {
  content: none !important;
  display: none !important;
}


/* Mobile */

@media only screen and (max-width: 680px) {
  html  .article-social-media .row:first-child {
    flex-wrap: wrap !important;
    gap: 12px !important;
  }

  html  .article-social-media .row:first-child .col-md-6 {
    flex-basis: 300px !important;

    width: min(300px, 100%) !important;
    max-width: 100% !important;
  }
}

/* CINEMATIC OPENING */

.user-css.page-world-homepage .opening-v6 {
  position: relative;
  isolation: isolate;
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  margin: 0 auto 46px;
  overflow: visible;
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

.user-css.page-world-homepage .opening-v6::before {
  content: none !important;
}

.user-css.page-world-homepage .stage-v6 {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: clamp(38px, 5vh, 64px) clamp(18px, 3vw, 48px);
  overflow: hidden;
  background: transparent !important;
}

/* OPENING PARAGRAPHS */

.user-css.page-world-homepage .scene1-v6,
.user-css.page-world-homepage .scene2-v6,
.user-css.page-world-homepage .scene3-v6 {
  box-sizing: border-box;
  width: 96% !important;
  max-width: 1240px !important;
  margin: 0 auto;
  color: #f2ddba;
  font-family: Lora, Georgia, serif !important;
  font-size: clamp(29px, 2.15vw, 40px);
  font-weight: 400;
  line-height: 1.68 !important;
  letter-spacing: 0.018em !important;
  word-spacing: 0.1em !important;
  text-align: center;
  text-wrap: wrap !important;
}

.user-css.page-world-homepage .w6 {
  display: inline-flex;
  white-space: nowrap;
  font-family: inherit !important;
  font-size: inherit;
  font-style: inherit;
  font-weight: inherit;
  line-height: inherit;
  letter-spacing: inherit;
  text-transform: inherit;
}

.user-css.page-world-homepage .l6 {
  display: inline-block;
  color: transparent !important;
  font-family: inherit !important;
  font-size: inherit !important;
  font-style: inherit !important;
  font-weight: inherit !important;
  line-height: inherit !important;
  letter-spacing: inherit;
  background: linear-gradient(
    180deg,
    #fff5df 0%,
    #efd2a2 52%,
    #c58a51 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent !important;
  text-shadow:
    0 2px 3px rgba(0, 0, 0, 0.92),
    0 0 16px rgba(217, 167, 111, 0.09);
  transform-origin: 50% 55%;
  will-change: transform, opacity;
}

.user-css.page-world-homepage .scene1-v6 .w6:first-child .l6,
.user-css.page-world-homepage .scene2-v6 .w6:first-child .l6,
.user-css.page-world-homepage .scene3-v6 .w6:first-child .l6 {
  font-family: CinzelDecorative, Georgia, serif !important;
  font-size: 1.1em !important;
  letter-spacing: 0.045em;
  text-transform: uppercase;
}

/* WELCOME TITLE */

.user-css.page-world-homepage .welcome-v6 {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.22em;
  width: min(1100px, 96%);
  margin: 0;
  font-family: JimNightshade, cursive !important;
  font-size: clamp(60px, 6.5vw, 100px);
  font-style: normal !important;
  font-weight: 400 !important;
  line-height: 1;
  letter-spacing: 0.025em;
  text-align: center;
  text-transform: none;
}

.user-css.page-world-homepage .welcome-v6 .w6,
.user-css.page-world-homepage .welcome-v6 .welcome-letter-v6 {
  font-family: JimNightshade, cursive !important;
  font-style: normal !important;
  font-weight: 400 !important;
  text-transform: none !important;
}

.user-css.page-world-homepage .welcome-v6 .welcome-letter-v6 {
  display: inline-block;
  color: transparent !important;
  font-family: JimNightshade, cursive !important;
  font-size: inherit !important;
  font-style: normal !important;
  font-weight: 400 !important;
  line-height: inherit !important;
  letter-spacing: inherit;
  background: linear-gradient(
    180deg,
    #f8d9a7 0%,
    #c88345 56%,
    #71391f 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent !important;
  text-shadow: none !important;
  -webkit-text-stroke: 0 transparent !important;
  filter: none !important;
  transform-origin: 50% 55%;
  will-change: transform, opacity;
}

/* WORLD TITLE */

.user-css.page-world-homepage .title-v6 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.08em;
  width: min(1240px, 98%) !important;
  margin: 0;
  font-family: CinzelDecorative, Georgia, serif !important;
  font-size: clamp(92px, 11vw, 170px) !important;
  font-style: normal;
  font-weight: 400;
  line-height: 0.98 !important;
  letter-spacing: 0.045em;
  text-align: center;
  text-transform: uppercase;
}

.user-css.page-world-homepage .title-v6 .l6 {
  background: linear-gradient(
    180deg,
    #fff6d9 0%,
    #efc477 34%,
    #cc843f 66%,
    #854123 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent !important;
  text-shadow:
    0 2px 2px rgba(70, 34, 16, 0.82),
    0 5px 10px rgba(0, 0, 0, 0.48),
    0 0 22px rgba(239, 196, 119, 0.30),
    0 0 46px rgba(179, 116, 77, 0.14);
}

/* LETTER FLIGHT */

.user-css.page-world-homepage .l6,
.user-css.page-world-homepage .welcome-letter-v6 {
  --fly-y: -50vh;
  --fly-r: -12deg;
}

.user-css.page-world-homepage .l6:nth-child(6n + 1),
.user-css.page-world-homepage .welcome-letter-v6:nth-child(6n + 1) {
  --fly-y: -42vh;
  --fly-r: -18deg;
}

.user-css.page-world-homepage .l6:nth-child(6n + 2),
.user-css.page-world-homepage .welcome-letter-v6:nth-child(6n + 2) {
  --fly-y: -58vh;
  --fly-r: 22deg;
}

.user-css.page-world-homepage .l6:nth-child(6n + 3),
.user-css.page-world-homepage .welcome-letter-v6:nth-child(6n + 3) {
  --fly-y: -48vh;
  --fly-r: -26deg;
}

.user-css.page-world-homepage .l6:nth-child(6n + 4),
.user-css.page-world-homepage .welcome-letter-v6:nth-child(6n + 4) {
  --fly-y: -66vh;
  --fly-r: 17deg;
}

.user-css.page-world-homepage .l6:nth-child(6n + 5),
.user-css.page-world-homepage .welcome-letter-v6:nth-child(6n + 5) {
  --fly-y: -54vh;
  --fly-r: -23deg;
}

.user-css.page-world-homepage .l6:nth-child(6n + 6),
.user-css.page-world-homepage .welcome-letter-v6:nth-child(6n + 6) {
  --fly-y: -72vh;
  --fly-r: 28deg;
}

/* PARAGRAPH VISIBILITY */

@keyframes v6Scene1Visibility {
  0%, 2% {
    opacity: 0;
  }

  7%, 18% {
    opacity: 1;
  }

  25%, 100% {
    opacity: 0;
  }
}

@keyframes v6Scene2Visibility {
  0%, 28% {
    opacity: 0;
  }

  35%, 44% {
    opacity: 1;
  }

  51%, 100% {
    opacity: 0;
  }
}

@keyframes v6Scene3Visibility {
  0%, 54% {
    opacity: 0;
  }

  61%, 70% {
    opacity: 1;
  }

  77%, 100% {
    opacity: 0;
  }
}

/* PARAGRAPH SCATTER */

@keyframes v6Scene1Letter {
  0%, 18% {
    opacity: 1;
    transform: translateY(0) rotate(0) scale(1);
  }

  25%, 100% {
    opacity: 0;
    transform:
      translateY(var(--fly-y))
      rotate(var(--fly-r))
      scale(0.72);
  }
}

@keyframes v6Scene2Letter {
  0%, 44% {
    opacity: 1;
    transform: translateY(0) rotate(0) scale(1);
  }

  51%, 100% {
    opacity: 0;
    transform:
      translateY(var(--fly-y))
      rotate(var(--fly-r))
      scale(0.72);
  }
}

@keyframes v6Scene3Letter {
  0%, 70% {
    opacity: 1;
    transform: translateY(0) rotate(0) scale(1);
  }

  77%, 100% {
    opacity: 0;
    transform:
      translateY(var(--fly-y))
      rotate(var(--fly-r))
      scale(0.72);
  }
}

/* WELCOME FADE AND SCATTER */

@keyframes v6WelcomeScatter {
  0%, 76% {
    opacity: 0;
    transform: translateY(0) rotate(0) scale(1);
  }

  80%, 84% {
    opacity: 1;
    transform: translateY(0) rotate(0) scale(1);
  }

  89%, 100% {
    opacity: 0;
    transform:
      translateY(var(--fly-y))
      rotate(var(--fly-r))
      scale(0.72);
  }
}

/* WORLD TITLE FADE AND SCATTER */

@keyframes v6TitleScatter {
  0%, 91% {
    opacity: 0;
    transform: translateY(0) rotate(0) scale(1);
  }

  94%, 96.8% {
    opacity: 1;
    transform: translateY(0) rotate(0) scale(1);
  }

  99.2%, 100% {
    opacity: 0;
    transform:
      translateY(var(--fly-y))
      rotate(var(--fly-r))
      scale(0.72);
  }
}

/* SCROLL TIMELINE */

@supports (animation-timeline: view()) {
  .user-css.page-world-homepage .opening-v6 {
    min-height: 700vh;
    view-timeline-name: --opening-v6-timeline;
    view-timeline-axis: block;
  }

  .user-css.page-world-homepage .stage-v6 {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 100vh;
  }

  .user-css.page-world-homepage .scene1-v6,
  .user-css.page-world-homepage .scene2-v6,
  .user-css.page-world-homepage .scene3-v6 {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: 0;
    translate: -50% -50%;
    opacity: 0;
    animation-duration: auto;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: --opening-v6-timeline;
    animation-range: contain 0% contain 100%;
  }

  .user-css.page-world-homepage .scene1-v6 {
    animation-name: v6Scene1Visibility;
  }

  .user-css.page-world-homepage .scene2-v6 {
    animation-name: v6Scene2Visibility;
  }

  .user-css.page-world-homepage .scene3-v6 {
    animation-name: v6Scene3Visibility;
  }

  .user-css.page-world-homepage .welcome-v6,
  .user-css.page-world-homepage .title-v6 {
    position: absolute;
    left: 50%;
    margin: 0;
    translate: -50% -50%;
    opacity: 1;
    animation: none !important;
  }

  .user-css.page-world-homepage .welcome-v6 {
    top: calc(50% - 82px);
  }

  .user-css.page-world-homepage .title-v6 {
    top: calc(50% + 88px);
  }

  .user-css.page-world-homepage .l6,
  .user-css.page-world-homepage .welcome-letter-v6 {
    animation-duration: auto;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: --opening-v6-timeline;
    animation-range: contain 0% contain 100%;
  }

  .user-css.page-world-homepage .scene1-v6 .l6 {
    animation-name: v6Scene1Letter;
  }

  .user-css.page-world-homepage .scene2-v6 .l6 {
    animation-name: v6Scene2Letter;
  }

  .user-css.page-world-homepage .scene3-v6 .l6 {
    animation-name: v6Scene3Letter;
  }

  .user-css.page-world-homepage .welcome-v6 .welcome-letter-v6 {
    animation-name: v6WelcomeScatter;
  }

  .user-css.page-world-homepage .title-v6 .l6 {
    animation-name: v6TitleScatter;
  }
}

/* CINEMATIC RESPONSIVE LAYOUT */

@media only screen and (max-width: 900px) {
  .user-css.page-world-homepage .scene1-v6,
  .user-css.page-world-homepage .scene2-v6,
  .user-css.page-world-homepage .scene3-v6 {
    width: 96% !important;
    max-width: 860px !important;
    font-size: clamp(25px, 3.8vw, 34px);
    line-height: 1.62 !important;
  }
}

@media only screen and (max-width: 768px) {
  .user-css.page-world-homepage .stage-v6 {
    padding: 34px 14px;
  }

  .user-css.page-world-homepage .scene1-v6,
  .user-css.page-world-homepage .scene2-v6,
  .user-css.page-world-homepage .scene3-v6 {
    width: 98% !important;
    font-size: clamp(20px, 4.9vw, 29px);
    line-height: 1.55 !important;
    letter-spacing: 0.012em !important;
    word-spacing: 0.05em !important;
  }

  .user-css.page-world-homepage .welcome-v6 {
    width: 98%;
    font-size: clamp(48px, 12vw, 72px);
    top: calc(50% - 58px);
  }

  .user-css.page-world-homepage .title-v6 {
    width: 98% !important;
    font-size: clamp(64px, 16vw, 100px) !important;
    top: calc(50% + 72px);
  }
}

/* ================================================================
   LEARN MORE — OPEN BOOK DIRECTORY
   COMPLETE REPLACEMENT
   ================================================================ */

.user-css .learn-book,
.user-css .learn-book * {
  box-sizing: border-box;
}

.user-css .learn-book {
  position: relative;
  isolation: isolate;
  width: min(1240px, 100%);
  aspect-ratio: 2048 / 1224;
  margin: 24px auto 42px;
  overflow: hidden;

  background:
    url(https://wa-cdn.nyc3.cdn.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/5b5b59aa3294fd0020cba4f84d0131a1.png)
    center / 100% 100% no-repeat !important;

  border: 0 !important;
  box-shadow: none !important;
}

/* Paper/grime layer over the article blocks. */

.user-css .learn-book::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 20;
  display: block;
  pointer-events: none;

  background:
    url(https://wa-cdn.nyc3.cdn.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/5b5b59aa3294fd0020cba4f84d0131a1.png)
    center / 100% 100% no-repeat !important;

  opacity: 0.24;
  mix-blend-mode: multiply;
  filter: saturate(0.72) contrast(1.16);
}

/* Position the two columns over the book pages. */

.user-css .learn-book-left,
.user-css .learn-book-right {
  position: absolute;
  z-index: 2;
  top: 9%;
  bottom: 9%;

  display: grid;
  grid-template-rows: repeat(3, minmax(0, 1fr));
  gap: 2.2%;

  width: 38.5%;
  min-width: 0;

  margin: 0 !important;
  padding: 0 !important;
}

.user-css .learn-book-left {
  left: 8.5%;
}

.user-css .learn-book-right {
  right: 8.5%;
}

.user-css .learn-book-left > br,
.user-css .learn-book-right > br {
  display: none !important;
}

/* Flat article panels: no lines, fills, shadows, or movement. */

html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover {
  position: relative !important;
  z-index: 1 !important;

  display: block !important;
  width: 100% !important;
  min-width: 0 !important;
  max-width: none !important;
  height: 100% !important;
  min-height: 0 !important;

  margin: 0 !important;
  padding: clamp(4px, 0.55vw, 8px) !important;
  overflow: hidden !important;

  color: #38281b !important;
  background: transparent !important;
  background-color: transparent !important;

  border: 0 !important;
  border-radius: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;

  filter: none !important;
  opacity: 1 !important;
  transform: none !important;
  animation: none !important;
  transition: none !important;
}

/* Remove the theme's solid teal hover cover. */

html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel::before,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel::after,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover::before,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover::after {
  content: none !important;
  display: none !important;

  background: none !important;
  opacity: 0 !important;

  filter: none !important;
  transform: none !important;
  animation: none !important;
  transition: none !important;
}

/* Remove the theme's second animated excerpt cover. */

html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .details p,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .details p.excerpt,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover .details p,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover .details p.excerpt {
  display: none !important;
  visibility: hidden !important;

  background: none !important;
  opacity: 0 !important;

  filter: none !important;
  transform: none !important;
  animation: none !important;
  transition: none !important;
}

/* Normalize World Anvil's article-block structure. */

.user-css .learn-book .article-panel > a,
.user-css .learn-book .article-panel .panel-,
.user-css .learn-book .article-panel .row {
  width: 100% !important;
  max-width: none !important;
  height: 100% !important;
  min-height: 0 !important;

  margin: 0 !important;
  padding: 0 !important;

  color: #38281b !important;
  background: transparent !important;

  border: 0 !important;
  box-shadow: none !important;

  transform: none !important;
  animation: none !important;
  transition: none !important;
}

.user-css .learn-book .article-panel > a {
  display: flex !important;
  flex-direction: column !important;
  align-items: stretch !important;
  justify-content: flex-start !important;

  text-decoration: none !important;
}

.user-css .learn-book .article-panel .row {
  display: flex !important;
  flex-direction: column !important;
  flex-wrap: nowrap !important;
  align-items: stretch !important;
}

.user-css .learn-book .article-panel [class*="col-"] {
  flex: 0 0 auto !important;

  width: 100% !important;
  max-width: 100% !important;
  min-height: 0 !important;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

.user-css .learn-book .article-panel [class*="col-"]:first-child {
  flex: 1 1 auto !important;
  overflow: hidden !important;
}

/* Images: faded edges, parchment blending, no frame or hover effect. */

html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel img,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel img:hover,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover img,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .img-responsive,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .img-fluid,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .max-width-100 {
  display: block !important;

  width: 100% !important;
  max-width: none !important;
  height: clamp(54px, 6.1vw, 92px) !important;

  margin: 0 !important;
  padding: 0 !important;

  object-fit: cover !important;
  object-position: center !important;

  background: transparent !important;

  border: 0 !important;
  border-image: none !important;
  border-radius: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;

  opacity: 0.84 !important;

  filter:
    sepia(0.38)
    saturate(0.72)
    contrast(0.90)
    brightness(0.97) !important;

  mix-blend-mode: multiply !important;

  transform: none !important;
  animation: none !important;
  transition: none !important;

  -webkit-mask-image:
    radial-gradient(
      ellipse 100% 100% at center,
      #000 0%,
      #000 64%,
      rgba(0, 0, 0, 0.84) 76%,
      rgba(0, 0, 0, 0.34) 91%,
      transparent 100%
    ) !important;

  mask-image:
    radial-gradient(
      ellipse 100% 100% at center,
      #000 0%,
      #000 64%,
      rgba(0, 0, 0, 0.84) 76%,
      rgba(0, 0, 0, 0.34) 91%,
      transparent 100%
    ) !important;

  -webkit-mask-position: center !important;
  mask-position: center !important;

  -webkit-mask-repeat: no-repeat !important;
  mask-repeat: no-repeat !important;

  -webkit-mask-size: 100% 100% !important;
  mask-size: 100% 100% !important;
}

/* Jim Nightshade titles, including hover state. */

html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .heading,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .heading a,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel h5,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel h5 a,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover .heading,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover .heading a,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover h5,
html  .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover h5 a {
  position: static !important;

  display: block !important;
  width: 100% !important;
  max-width: none !important;

  margin: clamp(3px, 0.45vw, 7px) 0 0 !important;
  padding: 0 !important;
  overflow: visible !important;

  color: #4b2d1b !important;
  background: none !important;
  background-image: none !important;

  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;

  font-family: JimNightshade, Georgia, cursive !important;
  font-size: clamp(23px, 2.35vw, 35px) !important;
  font-style: normal !important;
  font-weight: 400 !important;
  line-height: 1 !important;
  letter-spacing: 0.015em !important;

  text-align: center !important;
  text-decoration: none !important;
  text-transform: none !important;

  text-shadow:
    0 1px rgba(255, 246, 219, 0.50),
    0 0 5px rgba(88, 49, 24, 0.08) !important;

  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  -webkit-text-fill-color: #4b2d1b !important;

  filter: none !important;
  transform: none !important;
  animation: none !important;
  transition: none !important;
}

/* Hide excerpts, metadata, and subheadings. */

.user-css .learn-book .article-panel .subheading,
.user-css .learn-book .article-panel p,
.user-css .learn-book .article-panel small,
.user-css .learn-book .article-panel .text-muted {
  display: none !important;
}

/* MOBILE: two readable parchment sheets. */

@media only screen and (max-width: 760px) {
  .user-css .learn-book {
    display: grid;
    gap: 18px;

    width: 100%;
    aspect-ratio: auto;

    margin: 18px auto 32px;
    padding: 0;
    overflow: visible;

    background: none !important;
  }

  .user-css .learn-book::after {
    content: none !important;
    display: none !important;
  }

  .user-css .learn-book-left,
  .user-css .learn-book-right {
    position: relative;
    inset: auto;

    display: grid;
    grid-template-rows: repeat(3, minmax(150px, auto));
    gap: 12px;

    width: 100%;
    padding: 24px 20px !important;

    background:
      radial-gradient(
        circle at 50% 20%,
        rgba(255, 252, 230, 0.54),
        transparent 60%
      ),
      #dfcfaa !important;

    border: 1px solid #6f4528 !important;

    box-shadow:
      0 10px 22px rgba(0, 0, 0, 0.34),
      inset 0 0 30px rgba(81, 48, 26, 0.20) !important;
  }

  html  .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel,
  html  .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel:hover {
    min-height: 150px !important;
    padding: 8px !important;
  }

  html  .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel img,
  html  .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel .img-responsive,
  html  .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel .img-fluid {
    height: 92px !important;
  }

  html  .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel .heading,
  html  .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel .heading a,
