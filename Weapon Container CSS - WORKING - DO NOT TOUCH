/* ==========================================
   PHB-STYLE WEAPON STAT CARD
   WORLD ANVIL CONTAINER: [container:weapon-card]
========================================== */

.user-css .weapon-card {
  position: relative;
  box-sizing: border-box;

  width: min(920px, 96%);
  min-height: 440px;

  margin: 30px auto;
  padding: 68px 76px 66px;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/c9d5ca29575b5b7d32d8162d8e599e6a.png);
  background-position: center center;
  background-size: 100% 100%;
  background-repeat: no-repeat;

  color: #21170f;

  font-family:
    var(--font-body),
    Georgia,
    serif;

  font-size: 15px;
  line-height: 1.46;

  border: none;
  border-radius: 0;

  box-shadow:
    0 8px 24px rgba(0, 0, 0, .45);

  overflow-wrap: break-word;
  hyphens: auto;
}

/* Keeps card content above decorative layers */

.user-css .weapon-card > * {
  position: relative;
  z-index: 2;
}

/* ==========================================
   WEAPON NAME
========================================== */

.user-css .weapon-card h5 {
  margin: 0 0 4px;
  padding: 0 0 5px;

  color: #6f251c;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-size: 2em;
  font-weight: 700;
  font-variant: small-caps;
  line-height: 1.05;
  letter-spacing: .025em;

  text-align: left;

  border-bottom: 2px solid #8b4a2f;
}

/* ==========================================
   WEAPON CLASSIFICATION LINE
========================================== */

.user-css .weapon-card .weapon-meta {
  margin: 0 0 13px;
  padding: 0;

  color: #342218;

  font-size: .94em;
  font-style: italic;
  line-height: 1.3;
  text-align: left;
}

.user-css .weapon-card .weapon-meta p,
.user-css .weapon-card .weapon-meta .text-left {
  margin: 0;
  padding: 0;

  text-align: left;
}

/* ==========================================
   OPENING DESCRIPTION
========================================== */

.user-css .weapon-card .weapon-introduction {
  margin: 0 0 14px;
  padding: 0;

  font-style: italic;
  line-height: 1.45;
}

/* ==========================================
   BODY TEXT
========================================== */

.user-css .weapon-card p {
  margin: 0 0 10px;
  padding: 0;
}

.user-css .weapon-card p:last-child,
.user-css .weapon-card > *:last-child {
  margin-bottom: 0;
}

.user-css .weapon-card strong,
.user-css .weapon-card b {
  color: #5f2119;
  font-weight: 700;
}

.user-css .weapon-card em,
.user-css .weapon-card i {
  color: #2c1c14;
}

/* ==========================================
   OPTIONAL SECTION HEADINGS
========================================== */

.user-css .weapon-card h6 {
  margin: 16px 0 6px;
  padding: 0 0 3px;

  color: #6f251c;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-size: 1.22em;
  font-weight: 700;
  font-variant: small-caps;
  line-height: 1.15;
  letter-spacing: .02em;

  border-bottom: 1px solid rgba(111, 37, 28, .65);
}

/* ==========================================
   WEAPON STAT TABLE
========================================== */

.user-css .weapon-card .table-responsive {
  width: 100%;
  margin: 0 0 14px;

  overflow-x: auto;
}

.user-css .weapon-card table {
  width: 100%;
  margin: 0 0 14px;

  border-collapse: collapse;
  border-spacing: 0;

  background: transparent;

  color: #21170f;

  font-family:
    var(--font-body),
    Georgia,
    serif;

  font-size: .92em;
  line-height: 1.3;
}

.user-css .weapon-card table thead,
.user-css .weapon-card table tr:first-child {
  border-top: 2px solid #7b3525;
  border-bottom: 2px solid #7b3525;
}

.user-css .weapon-card table th {
  padding: 6px 8px;

  background: rgba(122, 67, 36, .12);
  color: #64251c;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-weight: 700;
  font-variant: small-caps;
  letter-spacing: .02em;
  text-align: left;
  vertical-align: bottom;
}

.user-css .weapon-card table td {
  padding: 6px 8px;

  background: transparent;
  border-bottom: 1px solid rgba(93, 54, 31, .35);

  text-align: left;
  vertical-align: top;
}

.user-css .weapon-card table tbody tr:nth-child(odd) td {
  background: rgba(137, 91, 45, .07);
}

.user-css .weapon-card table tbody tr:last-child td {
  border-bottom: 2px solid #7b3525;
}

/* Overrides unwanted World Anvil table decoration */

.user-css .weapon-card table,
.user-css .weapon-card table tr,
.user-css .weapon-card table td,
.user-css .weapon-card table th {
  box-shadow: none;
}

/* ==========================================
   OPTIONAL RULE DIVIDER
========================================== */

.user-css .weapon-card .weapon-rule {
  height: 2px;

  margin: 14px 0;

  background:
    linear-gradient(
      to right,
      transparent,
      #8a4b2d 12%,
      #8a4b2d 88%,
      transparent
    );
}

/* ==========================================
   MOBILE
========================================== */

@media screen and (max-width: 600px) {
  .user-css .weapon-card {
    width: 98%;
    min-height: 0;

    margin: 20px auto;
    padding: 44px 38px 46px;

    font-size: 13px;
    line-height: 1.4;
  }

  .user-css .weapon-card h5 {
    font-size: 1.65em;
  }

  .user-css .weapon-card table {
    font-size: .84em;
  }

  .user-css .weapon-card table th,
  .user-css .weapon-card table td {
    padding: 5px 4px;
  }
}
