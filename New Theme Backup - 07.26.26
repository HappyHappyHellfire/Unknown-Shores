}

.user-css .magic-item-card .table-responsive {
  width: 100%;
  margin: 0 0 14px;

  overflow-x: auto;
}

.user-css .magic-item-card table {
  width: 100%;
  margin: 0 0 14px;

  border-collapse: collapse;
  border-spacing: 0;

  background: transparent;

  color: #21170f;

  font-family:
    var(--font-body),
    Georgia,
    serif;

  font-size: .92em;
  line-height: 1.3;
}

.user-css .magic-item-card table thead,
.user-css .magic-item-card table tr:first-child {
  border-top: 2px solid #7b3525;
  border-bottom: 2px solid #7b3525;
}

.user-css .magic-item-card table th {
  padding: 6px 8px;

  background: rgba(122, 67, 36, .12);
  color: #64251c;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-weight: 700;
  font-variant: small-caps;
  letter-spacing: .02em;
  text-align: left;
  vertical-align: bottom;
}

.user-css .magic-item-card table td {
  padding: 6px 8px;

  background: transparent;
  border-bottom: 1px solid rgba(93, 54, 31, .35);

  text-align: left;
  vertical-align: top;
}

.user-css .magic-item-card table tbody tr:nth-child(odd) td {
  background: rgba(137, 91, 45, .07);
}

.user-css .magic-item-card table tbody tr:last-child td {
  border-bottom: 2px solid #7b3525;
}

.user-css .magic-item-card table,
.user-css .magic-item-card table tr,
.user-css .magic-item-card table td,
.user-css .magic-item-card table th {
  box-shadow: none;
}

.user-css .magic-item-card .magic-item-rule {
  height: 2px;

  margin: 14px 0;

  background:
    linear-gradient(
      to right,
      transparent,
      #8a4b2d 12%,
      #8a4b2d 88%,
      transparent
    );
}

