/* TREASURE PARCHMENT */

.user-css .treasure-parchment {
  background-image: url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/05dc9ca04ddf4307f8563b32f659fd2e.png);
  background-repeat: no-repeat;
  background-size: contain;
  background-position: center center;
  width: min(100%, 920px);
  aspect-ratio: 3 / 4;
  margin: 24px auto;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: clamp(24px, 5vw, 64px);
  box-sizing: border-box;
  color: #2a1b10;
  text-align: center;
  text-shadow: 0 0 1px rgba(0, 0, 0, 0.25);
}

.user-css .treasure-parchment .tp-wrap {
  position: relative;
  width: 80%;
  height: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-css .treasure-parchment .tp-front,
.user-css .treasure-parchment .tp-back {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  font-family: var(--font-quote);
  font-size: clamp(28px, 4vw, 52px);
  line-height: 1.4;
  text-align: center;
}

.user-css .treasure-parchment .tp-front {
  color: #2a1b10;
  transform: translate(-40%, 25%) rotate(-1.5deg);
  opacity: 1;
  animation: tp-front-out 16s ease forwards;
}

.user-css .treasure-parchment .tp-back {
  transform: translate(-40%, 75%) rotate(-1.5deg);
}

.user-css .treasure-parchment .tp-line1 {
  color: #2a1b10;
  margin-bottom: 20px;
  opacity: 0;
  animation: tp-line1-in 16s ease forwards;
}

.user-css .treasure-parchment .tp-line2 {
  color: #5a1a12;
  font-style: italic;
  text-shadow: 0 0 5px rgba(48, 0, 0, 0.25);
  opacity: 0;
  animation: tp-line2-in 16s ease forwards;
}

.user-css .treasure-parchment .burn-wrapper {
  cursor: help;
}

.user-css .treasure-parchment .burn-wrapper:hover {
  cursor: pointer;
}

@media only screen and (max-width: 768px) {
  .user-css .parchment {
    width: 100%;
    margin: 18px 0 26px;
    padding: 26px 22px;
    font-size: 17px;
    line-height: 1.62;
  }
}

/* HOMEPAGE TITLE DISPLAY */

.user-css.page-world-homepage .world-title,
.user-css.page-world-homepage .world-subtitle,
.user-css.page-world-homepage .heading > h1.world-title {
  display: none !important;
}

.user-css.page-world-homepage .heading h1,
.user-css.page-world-homepage h1.world-title,
.user-css.page-world-homepage .world-title,
.user-css.page-world-homepage .world-subtitle {
  display: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* HOMEPAGE MEDALLIONS AND BOOK COVERS */

@keyframes book-twisterInDown {
  0% {
    opacity: 0;
    transform-origin: 0 100%;
    transform: scale(0) rotate(360deg) translateY(-100%);
  }

  100% {
    opacity: 1;
    transform-origin: 100% 100%;
    transform: scale(1.3) rotate(0deg) translateY(-25px);
  }
}

@keyframes book-twisterInUp {
  0% {
    opacity: 0;
    transform-origin: 100% 0;
    transform: scale(0) rotate(360deg) translateY(100%);
  }

  100% {
    opacity: 1;
    transform-origin: 0 0;
    transform: scale(1.3) rotate(0deg) translateY(-25px);
  }
}

.user-css.page-world-homepage .bookcover {
  position: relative;
  z-index: 1;
  display: inline-block;
  width: min(300px, 100%);
  height: 400px;
  margin: 0 auto;
  overflow: visible;
  background: transparent;
  text-align: center;
  transition: z-index 0s 0.4s;
}

.user-css.page-world-homepage .bookcover:hover {
  z-index: 100;
  transition: z-index 0s;
}

.user-css.page-world-homepage .bookcover img,
.user-css.page-world-homepage .bookcover .img-responsive,
.user-css.page-world-homepage .bookcover .img-fluid,
.user-css.page-world-homepage .bookcover .img-responsive.img-fluid {
  display: inline-block;
  max-width: 100%;
  height: auto;
  object-fit: contain;
  opacity: 1 !important;
  filter: brightness(70%) !important;
  -webkit-mask-image: none !important;
  mask-image: none !important;
  border: none !important;
  border-image: none !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  transform: translateY(0) scale(1);
  transition:
    transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
    filter 0.4s ease !important;
}

.user-css.page-world-homepage .bookcover::before {
  content: "";
  position: absolute;
  bottom: -30px;
  left: 50%;
  z-index: -1;
  width: 0;
  height: 0;
  opacity: 0;
  background: radial-gradient(ellipse, rgba(0, 0, 0, 0.5), transparent);
  filter: blur(10px);
  transform: translateX(-50%);
  transition: width 0.5s ease, height 0.5s ease, bottom 0.5s ease, opacity 0.5s ease;
  pointer-events: none;
}

.user-css.page-world-homepage .bookcover:hover::before {
  bottom: -60px;
  width: 60%;
  height: 15px;
  opacity: 0.3;
}

.user-css.page-world-homepage .bookcover:hover img,
.user-css.page-world-homepage .bookcover:hover .img-responsive,
.user-css.page-world-homepage .bookcover:hover .img-fluid,
.user-css.page-world-homepage .bookcover:hover .img-responsive.img-fluid {
  filter:
    brightness(1)
    drop-shadow(0 0 20px rgba(233, 170, 92, 0.7))
    drop-shadow(0 0 40px rgba(205, 127, 50, 0.5))
    drop-shadow(0 0 60px rgba(139, 69, 19, 0.4)) !important;
  animation: bookFloat 3s ease-in-out infinite;
}

.user-css.page-world-homepage .col-md-6:first-child .bookcover:hover img,
.user-css.page-world-homepage .col-md-6:first-child .bookcover:hover .img-responsive,
.user-css.page-world-homepage .col-md-6:first-child .bookcover:hover .img-fluid {
  animation:
    book-twisterInDown 0.7s ease-out,
    bookFloat 3s ease-in-out 0.7s infinite;
}

.user-css.page-world-homepage .col-md-6:last-child .bookcover:hover img,
.user-css.page-world-homepage .col-md-6:last-child .bookcover:hover .img-responsive,
.user-css.page-world-homepage .col-md-6:last-child .bookcover:hover .img-fluid {
  animation:
    book-twisterInUp 0.7s ease-out,
    bookFloat 3s ease-in-out 0.7s infinite;
}

.user-css.page-world-homepage .booktitle {
  position: relative;
  top: 0;
  left: 0;
  color: transparent;
  background: linear-gradient(45deg, #4a2c1a 0%, #a85c32 15%, #d98e5f 65%, #a85c32 85%, #4a2c1a 95%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  font-family: var(--font-quote);
  font-size: clamp(24px, 3vw, 35px);
  font-weight: 400;
  letter-spacing: 1px;
  text-transform: capitalize;
  text-shadow: var(--color-shadow);
}

.user-css.page-world-homepage .bookcover .excerpt {
  display: none;
}

@media only screen and (max-width: 768px) {
  .user-css.page-world-homepage .bookcover {
    width: min(280px, 100%);
    height: auto;
    min-height: 330px;
  }

  .user-css.page-world-homepage .bookcover img,
  .user-css.page-world-homepage .bookcover .img-responsive,
  .user-css.page-world-homepage .bookcover .img-fluid {
    max-width: 90%;
  }
}

/* HOMEPAGE AWARD BADGES */

.user-css.page-world-homepage .user-custom-content-3 img,
.user-css.page-world-homepage .user-custom-content-3 .img-responsive,
.user-css.page-world-homepage .user-custom-content-3 .img-fluid,
.user-css.page-world-homepage .user-custom-content-3 .img-responsive.img-fluid {
  display: block;
  max-width: 100%;
  height: auto;
  margin-left: auto;
  margin-right: auto;
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  border-image: none !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  filter: none !important;
  -webkit-mask-image: none !important;
  mask-image: none !important;
  transform: none !important;
}

.user-css.page-world-homepage .user-custom-content-3 img:hover,
.user-css.page-world-homepage .user-custom-content-3 .img-responsive:hover,
.user-css.page-world-homepage .user-custom-content-3 .img-fluid:hover,
.user-css.page-world-homepage .user-custom-content-3 .img-responsive.img-fluid:hover {
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  border-image: none !important;
  box-shadow: none !important;
  filter: none !important;
  transform: none !important;
}
.user-css.page-world-homepage .user-custom-content-3 figure,
.user-css.page-world-homepage .user-custom-content-3 .thumbnail,
.user-css.page-world-homepage .user-custom-content-3 .imageblock,
.user-css.page-world-homepage .user-custom-content-3 .image-block {
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

/* HOMEPAGE COMMUNITY AND DISCUSSION BUTTONS */

.user-css.page-world-homepage .btn,
.user-css.page-world-homepage a.btn,
.user-css.page-world-homepage .btn-primary,
.user-css.page-world-homepage .btn-danger,
.user-css.page-world-homepage .btn-default,
.user-css.page-world-homepage .btn-secondary {
  color: var(--color-link-light) !important;
  background:
    linear-gradient(180deg, rgba(18, 48, 56, 0.98), rgba(5, 19, 25, 0.98)) !important;
  border: 1px solid var(--color-border) !important;
  border-radius: 4px !important;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.04),
    0 4px 12px rgba(0, 0, 0, 0.32) !important;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8) !important;
}

.user-css.page-world-homepage .btn:hover,
.user-css.page-world-homepage a.btn:hover,
.user-css.page-world-homepage .btn-primary:hover,
.user-css.page-world-homepage .btn-danger:hover,
.user-css.page-world-homepage .btn-default:hover,
.user-css.page-world-homepage .btn-secondary:hover,
.user-css.page-world-homepage .btn:focus,
.user-css.page-world-homepage a.btn:focus {
  color: #ffe2bf !important;
  background:
    linear-gradient(180deg, rgba(28, 68, 76, 0.99), rgba(8, 29, 36, 0.99)) !important;
  border-color: var(--color-accent) !important;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.06),
    0 7px 18px rgba(0, 0, 0, 0.4),
    0 0 10px rgba(217, 167, 111, 0.16) !important;
}

/* FOOTER CREDITS */

.user-css .credits {
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  margin: 12px auto;
  padding: 16px 22px;
  color: var(--color-text);
  background:
    linear-gradient(180deg, rgba(8, 25, 32, 0.98), rgba(3, 12, 18, 0.98));
  border: 1px solid var(--color-border);
  border-radius: 8px;
  box-shadow:
    0 8px 22px rgba(0, 0, 0, 0.38),
    inset 0 1px 0 rgba(255, 255, 255, 0.035);
  font-family: var(--font-meta);
  font-size: clamp(12px, 1vw, 15px);
  line-height: 1.55;
  text-align: center;
  transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
}

.user-css .credits:hover {
  transform: translateY(-2px);
  border-color: var(--color-accent);
  box-shadow:
    0 12px 28px rgba(0, 0, 0, 0.46),
    0 0 12px rgba(217, 167, 111, 0.16),
    inset 0 1px 0 rgba(255, 255, 255, 0.045);
}

.user-css .credits p,
.user-css .credits li,
.user-css .credits span,
.user-css .credits strong,
.user-css .credits b {
  color: var(--color-text) !important;
  font-family: var(--font-meta);
  line-height: 1.55;
  text-shadow: none !important;
}

.user-css .credits p:last-child {
  margin-bottom: 0;
}

.user-css .credits a {
  color: var(--color-link);
  font-family: var(--font-meta);
  font-size: inherit;
  text-decoration: none;
}

.user-css .credits a:hover {
  color: var(--color-link-light);
  text-decoration: underline;
}

@media only screen and (max-width: 768px) {
  .user-css .credits {
    width: 100%;
    padding: 12px 14px;
    font-size: 12px;
  }
}

/* COMMISSIONED ART GALLERY */

.user-css .art-gallery {
  box-sizing: border-box;
  width: 100%;
  max-width: none;
  margin: 36px auto 60px;
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
}

.user-css .art-gallery .art-artist {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  margin: 38px auto;
  padding: clamp(20px, 3vw, 34px);
  overflow: hidden;
  color: var(--color-text);
  background:
    radial-gradient(circle at 50% 0%, rgba(217, 167, 111, 0.09), transparent 34%),
    linear-gradient(180deg, rgba(8, 25, 32, 0.98), rgba(3, 12, 18, 0.98));
  border: 1px solid var(--color-border);
  border-radius: 18px;
  box-shadow:
    0 18px 42px rgba(0, 0, 0, 0.46),
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    inset 0 0 44px rgba(0, 0, 0, 0.28);
}

.user-css .art-gallery .art-artist::before {
  content: "";
  position: absolute;
  top: 0;
  left: 10%;
  width: 80%;
  height: 1px;
  pointer-events: none;
  background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  opacity: 0.8;
}

.user-css .art-gallery .art-artist > h1,
.user-css .art-gallery .art-artist > h2 {
  margin: 0 0 6px !important;
  padding: 0 0 10px !important;
  text-align: center !important;
  font-family: var(--font-display) !important;
  font-size: clamp(34px, 4vw, 54px) !important;
  line-height: 1.15 !important;
  letter-spacing: 0.025em;
  background: var(--color-header) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  border-bottom: 1px solid var(--color-border-soft) !important;
}

.user-css .art-gallery .artist-link {
  margin: 8px auto 24px;
  text-align: center;
  color: var(--color-muted);
  font-family: var(--font-meta);
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.user-css .art-gallery .artist-link center {
  margin: 0;
}

.user-css .art-gallery .artist-link a {
  color: var(--color-link-light);
  font-family: var(--font-meta);
  font-size: inherit;
  text-decoration: none;
}

.user-css .art-gallery .artist-link a:hover {
  color: #ffe2bf;
  text-decoration: underline;
}

.user-css .art-gallery .art-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(18px, 2.2vw, 28px);
  align-items: start;
  width: 100%;
}

.user-css .art-gallery .art-piece,
.user-css .art-gallery .art-piece-wide {
  position: relative;
  box-sizing: border-box;
  min-width: 0;
  padding: 14px;
  overflow: hidden;
  color: var(--color-text);
  background: linear-gradient(180deg, #071820 0%, #041016 100%);
  border: 1px solid rgba(179, 116, 77, 0.68);
  border-radius: 12px;
  box-shadow:
    0 12px 26px rgba(0, 0, 0, 0.42),
    inset 0 1px 0 rgba(255, 255, 255, 0.025);
  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}

.user-css .art-gallery .art-piece-wide {
  grid-column: 1 / -1;
}

.user-css .art-gallery .art-piece:hover,
.user-css .art-gallery .art-piece-wide:hover {
  transform: translateY(-4px);
  border-color: var(--color-accent);
  box-shadow:
    0 18px 38px rgba(0, 0, 0, 0.54),
    0 0 15px rgba(217, 167, 111, 0.14),
    inset 0 1px 0 rgba(255, 255, 255, 0.035);
}

.user-css .art-gallery .piece-title {
  margin: 0 0 12px;
  padding: 9px 12px 10px;
  text-align: center;
  color: var(--color-link-light);
  background: linear-gradient(180deg, rgba(18, 48, 57, 0.96), rgba(7, 27, 34, 0.96));
  border: 1px solid rgba(179, 116, 77, 0.48);
  border-radius: 8px;
  box-shadow: inset 0 0 18px rgba(0, 0, 0, 0.28);
  font-family: var(--font-header);
  font-size: clamp(24px, 2.6vw, 34px);
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: 0.02em;
}

.user-css .art-gallery .piece-title i,
.user-css .art-gallery .piece-title em {
  color: inherit;
  font-style: normal;
}

.user-css .art-gallery .piece-note {
  margin: 12px 2px 0;
  padding: 10px 12px;
  color: var(--color-muted);
  background: rgba(2, 8, 12, 0.78);
  border-left: 3px solid var(--color-border);
  border-radius: 4px;
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.5;
  text-align: left;
}

.user-css .art-gallery .piece-note a {
  color: var(--color-link-light);
}

.user-css .art-gallery .art-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  align-items: stretch;
  width: 100%;
}

.user-css .art-gallery img,
.user-css .art-gallery .img-responsive,
.user-css .art-gallery .img-fluid,
.user-css .art-gallery .img-responsive.img-fluid,
.user-css .art-gallery .max-width-100 {
  display: block !important;
  float: none !important;
  width: auto !important;
  max-width: 100% !important;
  height: auto !important;
  max-height: 760px;
  margin: 0 auto !important;
  padding: 0 !important;
  object-fit: contain !important;
  opacity: 1 !important;
  filter: none !important;
  transform: none !important;
  -webkit-mask-image: none !important;
  mask-image: none !important;
  border: 1px solid rgba(217, 167, 111, 0.24) !important;
  border-image: none !important;
  border-radius: 6px !important;
  background: #020609;
  box-shadow: 0 9px 22px rgba(0, 0, 0, 0.5) !important;
  transition: transform 0.35s ease, box-shadow 0.35s ease, filter 0.35s ease !important;
}

.user-css .art-gallery .art-pair img,
.user-css .art-gallery .art-pair .img-responsive,
.user-css .art-gallery .art-pair .img-fluid {
  width: 100% !important;
  height: 100% !important;
  max-height: 560px;
  object-fit: contain !important;
}

.user-css .art-gallery .art-piece:hover img,
.user-css .art-gallery .art-piece-wide:hover img {
  transform: scale(1.012) !important;
  filter: brightness(1.03) !important;
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.58) !important;
}

.user-css .art-gallery .art-piece .spoiler-button,
.user-css .art-gallery .art-piece-wide .spoiler-button {
  margin-top: 4px;
}

.user-css .art-gallery .art-piece .spoiler-content,
.user-css .art-gallery .art-piece-wide .spoiler-content {
  text-align: center;
}

.user-css .art-gallery .art-piece .spoiler-content img,
.user-css .art-gallery .art-piece-wide .spoiler-content img {
  margin: 14px auto !important;
}

@media only screen and (max-width: 850px) {
  .user-css .art-gallery .art-grid {
    grid-template-columns: 1fr;
  }

  .user-css .art-gallery .art-piece-wide {
    grid-column: auto;
  }
}

@media only screen and (max-width: 560px) {
  .user-css .art-gallery .art-artist {
    margin: 24px auto;
    padding: 16px;
    border-radius: 12px;
  }

  .user-css .art-gallery .art-grid {
    gap: 16px;
  }

  .user-css .art-gallery .art-piece,
  .user-css .art-gallery .art-piece-wide {
    padding: 10px;
  }

  .user-css .art-gallery .art-pair {
    grid-template-columns: 1fr;
  }

  .user-css .art-gallery .piece-title {
    font-size: 25px;
  }
}

/* ART GALLERY TEXT */

.user-css .article-content-left .art-gallery .piece-title,
.user-css .article-content-left .art-gallery .piece-title i,
.user-css .article-content-left .art-gallery .piece-title em {
  color: #f3c990 !important;
  -webkit-text-fill-color: #f3c990 !important;
  text-shadow:
    0 2px 3px rgba(0, 0, 0, 0.95),
    0 0 10px rgba(217, 167, 111, 0.18) !important;
}

.user-css .article-content-left .art-gallery .piece-note,
.user-css .article-content-left .art-gallery .piece-note p,
.user-css .article-content-left .art-gallery .piece-note strong,
.user-css .article-content-left .art-gallery .piece-note b {
  color: #ddd5c7 !important;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9) !important;
}

.user-css .article-content-left .art-gallery .piece-note i,
.user-css .article-content-left .art-gallery .piece-note em {
  color: #f0c38e !important;
  -webkit-text-fill-color: #f0c38e !important;
  font-style: italic;
  font-weight: 600;
  text-shadow:
    0 1px 2px rgba(0, 0, 0, 0.95),
    0 0 8px rgba(217, 167, 111, 0.16) !important;
}

/* ARTICLE TYPOGRAPHY */

.user-css h1,
.user-css-extended h1,
.user-css h2,
.user-css-extended h2,
.user-css h3,
.user-css-extended h3,
.user-css h4,
.user-css-extended h4,
.user-css h5,
.user-css-extended h5 {
  text-shadow: 0 1px 0 rgba(0, 0, 0, 0.72) !important;
  filter: none !important;
}

.user-css .parchment h1,
.user-css .parchment h2,
.user-css .parchment h3,
.user-css .parchment h4,
.user-css .parchment h5,
.user-css .bordered-cardbg h1,
.user-css .bordered-cardbg h2,
.user-css .bordered-cardbg h3,
.user-css .bordered-cardbg h4,
.user-css .bordered-cardbg h5,
.user-css .border-card h1,
.user-css .border-card h2,
.user-css .border-card h3,
.user-css .border-card h4,
.user-css .border-card h5,
.user-css .side-card h1,
.user-css .side-card h2,
.user-css .side-card h3,
.user-css .side-card h4,
.user-css .side-card h5,
.user-css .parchment2 h1,
.user-css .parchment2 h2,
.user-css .parchment2 h3,
.user-css .parchment2 h4,
.user-css .parchment2 h5,
.user-css .weapon-card h1,
.user-css .weapon-card h2,
.user-css .weapon-card h3,
.user-css .weapon-card h4,
.user-css .weapon-card h5,
.user-css .gear-card h1,
.user-css .gear-card h2,
.user-css .gear-card h3,
.user-css .gear-card h4,
.user-css .gear-card h5,
.user-css .spell-card h1,
.user-css .spell-card h2,
.user-css .spell-card h3,
.user-css .spell-card h4,
.user-css .spell-card h5,
.user-css .magic-item-card h1,
.user-css .magic-item-card h2,
.user-css .magic-item-card h3,
.user-css .magic-item-card h4,
.user-css .magic-item-card h5,
.user-css .background-card h1,
.user-css .background-card h2,
.user-css .background-card h3,
.user-css .background-card h4,
.user-css .background-card h5 {
  background: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  -webkit-text-fill-color: #2b1710 !important;
  color: #2b1710 !important;
  text-shadow: none !important;
  filter: none !important;
}

/* ARTICLE METADATA */

.user-css-extended .page {
  min-height: 0 !important;
  height: auto !important;
  margin: 18px auto 30px !important;
  padding: 14px 26px 18px !important;
  overflow: visible !important;
}

.user-css-extended .nav-tabs {
  margin: 0 !important;
}

.user-css-extended .tab-content,
.user-css-extended .tab-pane,
.user-css-extended .tab-content > .active {
  min-height: 0 !important;
  height: auto !important;
}

.user-css-extended .tab-content:empty,
.user-css-extended .tab-pane:empty {
  display: none !important;
}

@media only screen and (max-width: 768px) {
  .user-css-extended .page {
    margin: 10px auto 20px !important;
    padding: 10px 14px 14px !important;
  }
}

/* CREDIT CARDS */

.user-css .credit-card .credit-bio,
.user-css .credit-card .credit-bio p,
.user-css .credit-card .credit-bio span {
  color: #ddd5c7 !important;
  text-shadow: none !important;
}

.user-css .credit-card .credit-bio i,
.user-css .credit-card .credit-bio em,
.user-css .credit-card .credit-bio strong,
.user-css .credit-card .credit-bio b {
  color: #f0c38e !important;
  -webkit-text-fill-color: #f0c38e !important;
  font-weight: 600;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9) !important;
}

.user-css .credit-card .credit-links a {
  color: var(--color-link-light) !important;
}

.user-css .credit-card .credit-links a:hover {
  color: #ffe2bf !important;
}

/* ARTICLE IMAGE FRAMES */

.user-css .article-content img.img-responsive.img-fluid:not(.bookcover img):not(.raw-image img):not(.container-raw-image img):not(.art-gallery img):not(.user-custom-content-3 img),
.user-css .article-content img.max-width-100:not(.bookcover img):not(.raw-image img):not(.container-raw-image img):not(.art-gallery img):not(.user-custom-content-3 img) {
  display: block;
  box-sizing: border-box;
  max-width: 100%;
  height: auto;
  margin-left: auto;
  margin-right: auto;
  padding: 0;
  background: transparent !important;
  border: 40px solid transparent !important;
  border-image-source: url(https://www.worldanvil.com/i/6986890/render) !important;
  border-image-slice: 30 !important;
  border-image-repeat: stretch !important;
  border-radius: 0 !important;
  -webkit-mask-image: none !important;
  mask-image: none !important;
  outline: none !important;
  box-shadow: none !important;
  transform: none !important;
  backface-visibility: hidden;
  filter: sepia(1) contrast(1.1) brightness(0.7);
  transition: filter 0.65s ease, opacity 0.65s ease;
}

.user-css .article-content img.img-responsive.img-fluid:not(.bookcover img):not(.raw-image img):not(.container-raw-image img):not(.art-gallery img):not(.user-custom-content-3 img):hover,
.user-css .article-content img.max-width-100:not(.bookcover img):not(.raw-image img):not(.container-raw-image img):not(.art-gallery img):not(.user-custom-content-3 img):hover {
  box-shadow: none !important;
  transform: none !important;
  filter: sepia(0) contrast(1.05) brightness(1);
}

@media only screen and (max-width: 600px) {
  .user-css .article-content img.img-responsive.img-fluid:not(.bookcover img):not(.raw-image img):not(.container-raw-image img):not(.art-gallery img):not(.user-custom-content-3 img),
  .user-css .article-content img.max-width-100:not(.bookcover img):not(.raw-image img):not(.container-raw-image img):not(.art-gallery img):not(.user-custom-content-3 img) {
    border-width: 24px !important;
  }
}

.user-css .article-content .imageblock,
.user-css .article-content .image-block,
.user-css .article-content figure:has(> img.img-responsive.img-fluid),
.user-css .article-content figure:has(> img.max-width-100),
.user-css .article-content a:has(> img.img-responsive.img-fluid),
.user-css .article-content a:has(> img.max-width-100) {
  transform: none !important;
  transition: none !important;
  will-change: auto !important;
}

@media (hover: hover) and (pointer: fine) {
  .user-css .article-content img.img-responsive.img-fluid:not(.bookcover img):not(.raw-image img):not(.container-raw-image img):not(.art-gallery img):not(.user-custom-content-3 img),
  .user-css .article-content img.max-width-100:not(.bookcover img):not(.raw-image img):not(.container-raw-image img):not(.art-gallery img):not(.user-custom-content-3 img) {
    transform: rotate(-0.8deg) translateY(0) scale(1) !important;
    transform-origin: center center !important;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    will-change: transform, filter;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      filter 3s ease-in-out !important;
  }

  .user-css .article-content img.img-responsive.img-fluid:not(.bookcover img):not(.raw-image img):not(.container-raw-image img):not(.art-gallery img):not(.user-custom-content-3 img):hover,
  .user-css .article-content img.max-width-100:not(.bookcover img):not(.raw-image img):not(.container-raw-image img):not(.art-gallery img):not(.user-custom-content-3 img):hover {
    transform: rotate(0.85deg) translateY(-8px) scale(1.014) !important;
  }
}

@media (hover: none), (pointer: coarse) {
  .user-css .article-content img.img-responsive.img-fluid:not(.bookcover img):not(.raw-image img):not(.container-raw-image img):not(.art-gallery img):not(.user-custom-content-3 img),
  .user-css .article-content img.max-width-100:not(.bookcover img):not(.raw-image img):not(.container-raw-image img):not(.art-gallery img):not(.user-custom-content-3 img) {
    transform: none !important;
  }
}
.user-css .article-title h1,
.user-css .article-title .m-b-0,
.user-css .article-title .m-b-0 h1 {
  font-family: var(--font-display) !important;
}

/* ARTICLE HEADING HIERARCHY */

.user-css .article-content-left > h2,
.user-css .article-content-left > h3,
.user-css .article-content-left > h4,
.user-css .article-content-left > h5 {
  font-family: var(--font-display) !important;
  font-weight: 400 !important;
  font-style: normal !important;
  font-variant: normal !important;
  text-transform: none !important;
  filter: none !important;
  -webkit-text-stroke: 0.25px rgba(245, 190, 124, 0.16);
}

.user-css .article-content-left > h2,
.user-css .article-content-left > h3 {
  letter-spacing: 0.018em;
}

.user-css .article-content-left > h2 {
  color: #bd7542 !important;
  background: linear-gradient(
    180deg,
    #d7a066 0%,
    #c17a43 38%,
    #9f542e 72%,
    #c9824b 100%
  ) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  font-size: clamp(31px, 3.3vw, 48px);
  line-height: 1.18;
  border-bottom-color: rgba(193, 122, 67, 0.72) !important;
  text-shadow:
    0 1px 0 rgba(24, 9, 3, 0.98),
    1px 0 0 rgba(24, 9, 3, 0.45) !important;
}
.user-css .article-content-left > h3 {
  color: #d0925b !important;
  background: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  -webkit-text-fill-color: #d0925b !important;
  font-size: clamp(27px, 2.8vw, 40px);
  line-height: 1.2;
  text-shadow: 0 1px 0 rgba(24, 9, 3, 0.95) !important;
}

.user-css .article-content-left > h4 {
  color: #c98855 !important;
  background: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  -webkit-text-fill-color: #c98855 !important;
  text-shadow: 0 1px 0 rgba(24, 9, 3, 0.92) !important;
}

.user-css .article-content-left > h5 {
  color: #bf7b49 !important;
  background: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  -webkit-text-fill-color: #bf7b49 !important;
  text-shadow: 0 1px 0 rgba(24, 9, 3, 0.9) !important;
}

/* RAW IMAGE COMPATIBILITY */

.user-css .raw-image,
.user-css .container-raw-image,
.user-css [class~="raw-image"],
.user-css-extended .raw-image,
.user-css-extended .container-raw-image,
.user-css-extended [class~="raw-image"] {
  box-sizing: border-box !important;
  width: 100% !important;
  max-width: 100% !important;
  margin-inline: auto !important;
  padding: 0 !important;
  background: transparent !important;
  border: 0 !important;
  border-image: none !important;
  border-radius: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  filter: none !important;
  transform: none !important;
}

.user-css .raw-image::before,
.user-css .raw-image::after,
.user-css .container-raw-image::before,
.user-css .container-raw-image::after,
.user-css [class~="raw-image"]::before,
.user-css [class~="raw-image"]::after,
.user-css-extended .raw-image::before,
.user-css-extended .raw-image::after,
.user-css-extended .container-raw-image::before,
.user-css-extended .container-raw-image::after,
.user-css-extended [class~="raw-image"]::before,
.user-css-extended [class~="raw-image"]::after {
  content: none !important;
  display: none !important;
}

.user-css :is(.raw-image, .container-raw-image, [class~="raw-image"])
  :is(.imageblock, .image-block, figure, picture, a, span),
.user-css-extended :is(.raw-image, .container-raw-image, [class~="raw-image"])
  :is(.imageblock, .image-block, figure, picture, a, span) {
  box-sizing: border-box !important;
  max-width: 100% !important;
  margin-inline: auto !important;
  padding: 0 !important;
  background: transparent !important;
  border: 0 !important;
  border-image: none !important;
  border-radius: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  filter: none !important;
  transform: none !important;
}

.user-css :is(.raw-image, .container-raw-image, [class~="raw-image"])
  :is(.imageblock, .image-block, figure, picture, a, span)::before,
.user-css :is(.raw-image, .container-raw-image, [class~="raw-image"])
  :is(.imageblock, .image-block, figure, picture, a, span)::after,
.user-css-extended :is(.raw-image, .container-raw-image, [class~="raw-image"])
  :is(.imageblock, .image-block, figure, picture, a, span)::before,
.user-css-extended :is(.raw-image, .container-raw-image, [class~="raw-image"])
  :is(.imageblock, .image-block, figure, picture, a, span)::after {
  content: none !important;
  display: none !important;
}

.user-css :is(.raw-image, .container-raw-image, [class~="raw-image"]) img,
.user-css img.raw-image,
.user-css img.container-raw-image,
.user-css-extended :is(.raw-image, .container-raw-image, [class~="raw-image"]) img,
.user-css-extended img.raw-image,
.user-css-extended img.container-raw-image {
  display: block !important;
  box-sizing: border-box !important;
  width: auto !important;
  max-width: 100% !important;
  height: auto !important;
  margin: 0 auto !important;
  padding: 0 !important;
  background: transparent !important;
  border: 0 !important;
  border-image: none !important;
  border-radius: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  filter: none !important;
  -webkit-mask-image: none !important;
  mask-image: none !important;
  opacity: 1 !important;
  transform: none !important;
  transition: none !important;
  animation: none !important;
}

.user-css :is(.raw-image, .container-raw-image, [class~="raw-image"]) img:hover,
.user-css img.raw-image:hover,
.user-css img.container-raw-image:hover,
.user-css-extended :is(.raw-image, .container-raw-image, [class~="raw-image"]) img:hover,
.user-css-extended img.raw-image:hover,
.user-css-extended img.container-raw-image:hover {
  border: 0 !important;
  border-image: none !important;
  box-shadow: none !important;
  filter: none !important;
  opacity: 1 !important;
  transform: none !important;
}

/* JOURNAL PAGE NAVIGATION */

:root {
  --navigation-journal-page-image: none;
}

.user-css-presentation #world-navigation-sidebar {
  box-sizing: border-box;
  height: fit-content !important;
  min-height: 0 !important;
  max-height: calc(100vh - 80px) !important;
  overflow-x: hidden !important;
  overflow-y: auto !important;
  padding: 22px 20px 24px;

  color: #281a11;
  text-align: left !important;

  background-color: #bba580;
  background-image:
    linear-gradient(90deg, rgba(54, 31, 16, 0.16) 0%, transparent 7%, transparent 93%, rgba(54, 31, 16, 0.16) 100%),
    linear-gradient(180deg, rgba(255, 244, 214, 0.18) 0%, transparent 18%, transparent 82%, rgba(69, 39, 20, 0.12) 100%),
    radial-gradient(circle at 18% 14%, rgba(84, 51, 25, 0.11) 0 2px, transparent 3px),
    radial-gradient(circle at 78% 67%, rgba(84, 51, 25, 0.08) 0 1px, transparent 2px),
    var(--navigation-journal-page-image);
  background-position: center, center, center, center, center;
  background-size: 100% 100%, 100% 100%, 120px 120px, 95px 95px, 100% 100%;
  background-repeat: no-repeat, no-repeat, repeat, repeat, no-repeat;

  border: 1px solid #765036;
  border-top: 1px solid #765036;
  border-radius: 5px 12px 8px 4px;
  box-shadow:
    0 14px 32px rgba(0, 0, 0, 0.48),
    inset 0 0 28px rgba(67, 39, 20, 0.16),
    inset 0 0 0 1px rgba(242, 220, 176, 0.24);

  scrollbar-color: #8d5f3c rgba(65, 40, 23, 0.14);
}

.user-css-presentation #world-navigation-sidebar,
.user-css-presentation #world-navigation-sidebar .world-navigation-custom-content,
.user-css-presentation #world-navigation-sidebar .category-list,
.user-css-presentation #world-navigation-sidebar ul,
.user-css-presentation #world-navigation-sidebar li,
.user-css-presentation #world-navigation-sidebar p {
  text-align: left !important;
}

.user-css-presentation #world-navigation-sidebar .world-navigation-custom-content,
.user-css-presentation #world-navigation-sidebar .category-list,
.user-css-presentation #world-navigation-sidebar > *:last-child {
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
}

.user-css .world-navigation-custom-content h2,
.user-css-presentation #world-navigation-sidebar h2 {
  margin: 0 0 12px;
  padding: 0 0 8px;
  color: #4f2b1b;
  text-align: left !important;
  background: none;
  -webkit-background-clip: border-box;
  background-clip: border-box;
  -webkit-text-fill-color: #4f2b1b;
  text-shadow: none;
  border-bottom: 1px solid rgba(91, 55, 31, 0.58);
}

.user-css-presentation #world-navigation-sidebar a,
.user-css .world-navigation-custom-content a {
  color: #5e321f;
  text-align: left !important;
  text-shadow: none;
  transform-origin: left center;
}

.user-css-presentation #world-navigation-sidebar a:hover,
.user-css .world-navigation-custom-content a:hover {
  color: #8b482b;
  text-shadow: none;
  transform: translateX(4px);
}

.user-css-presentation #world-navigation-sidebar::-webkit-scrollbar {
  width: 7px;
}

.user-css-presentation #world-navigation-sidebar::-webkit-scrollbar-track {
  background: rgba(65, 40, 23, 0.12);
}

.user-css-presentation #world-navigation-sidebar::-webkit-scrollbar-thumb {
  background: #8d5f3c;
  border: 1px solid rgba(53, 31, 18, 0.48);
  border-radius: 999px;
}

@media only screen and (max-width: 500px) {
  .user-css-presentation #world-navigation-sidebar {
    height: fit-content !important;
    min-height: 0 !important;
    max-height: calc(100vh - 110px) !important;
    padding: 18px 16px 20px;
    background-size: 100% 100%, 100% 100%, 100px 100px, 80px 80px, 100% 100%;
  }
}

/* HOMEPAGE LOWER DECK */

:root {
  --homepage-ledger-paper-image: none;
}

/* STICKER SECTION — CLEAN RESET WITH STONE BACKGROUND */

.user-css.page-world-homepage .stickers-article-collection,
.page-world-homepage .stickers-article-collection {
  position: relative !important;
  display: flex !important;
  flex-wrap: wrap !important;
  justify-content: center !important;
  align-items: center !important;
  gap: 12px !important;

  box-sizing: border-box !important;
  width: min(340px, 100%) !important;
  min-height: 240px !important;

  margin: 18px auto !important;
  padding: 34px 20px 22px 20px !important;

  background-color: transparent !important;
  background-image: url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/4bd15c6af034ec8b5af86caac57b6edd.png) !important;
  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;

  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;

  overflow: visible !important;
}


/* Kill the old fake headings / labels */

.user-css.page-world-homepage .stickers-article-collection::before,
.user-css.page-world-homepage .stickers-article-collection::after,
.page-world-homepage .stickers-article-collection::before,
.page-world-homepage .stickers-article-collection::after {
  content: none !important;
  display: none !important;
}


/* Undo the old hidden-heading trick */

.user-css.page-world-homepage .stickers-article-collection h4,
.page-world-homepage .stickers-article-collection h4 {
  position: static !important;
  width: auto !important;
  height: auto !important;
  margin: 0 0 10px 0 !important;
  padding: 0 !important;
  overflow: visible !important;
  clip: auto !important;
  white-space: normal !important;
}


/* Neutral sticker item reset — no hover gimmicks, no forced transforms */

.user-css.page-world-homepage .stickers-article-collection .sticker-collection-sticker,
.page-world-homepage .stickers-article-collection .sticker-collection-sticker {
  position: relative !important;
  display: inline-block !important;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;

  transform: none !important;
  transition: none !important;
}


/* Sticker images themselves stay untouched for now */

.user-css.page-world-homepage .stickers-article-collection .sticker-collection-sticker img,
.user-css.page-world-homepage .stickers-article-collection img.sticker-collection-sticker,
.page-world-homepage .stickers-article-collection .sticker-collection-sticker img,
.page-world-homepage .stickers-article-collection img.sticker-collection-sticker {
  display: block !important;

  width: auto !important;
  max-width: 100% !important;
  height: auto !important;
  max-height: 120px !important;

  margin: 0 auto !important;
  padding: 0 !important;

  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;

  transform: none !important;
  transition: none !important;
  filter: none !important;
}


/* Kill the old hover behavior completely */

.user-css.page-world-homepage .stickers-article-collection .sticker-collection-sticker:hover,
.user-css.page-world-homepage .stickers-article-collection .sticker-collection-sticker:hover img,
.user-css.page-world-homepage .stickers-article-collection img.sticker-collection-sticker:hover,
.page-world-homepage .stickers-article-collection .sticker-collection-sticker:hover,
.page-world-homepage .stickers-article-collection .sticker-collection-sticker:hover img,
.page-world-homepage .stickers-article-collection img.sticker-collection-sticker:hover {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
  transform: none !important;
  filter: none !important;
}


/* Mobile */

@media only screen and (max-width: 768px) {
  .user-css.page-world-homepage .stickers-article-collection,
  .page-world-homepage .stickers-article-collection {
    width: min(320px, 100%) !important;
    min-height: 225px !important;
    padding: 30px 16px 20px 16px !important;
  }

  .user-css.page-world-homepage .stickers-article-collection .sticker-collection-sticker img,
  .user-css.page-world-homepage .stickers-article-collection img.sticker-collection-sticker,
  .page-world-homepage .stickers-article-collection .sticker-collection-sticker img,
  .page-world-homepage .stickers-article-collection img.sticker-collection-sticker {
    max-height: 100px !important;
  }
}
.user-css.page-world-homepage .btn-danger,
.user-css.page-world-homepage .btn-info,
.user-css.page-world-homepage .btn-sticker,
.user-css.page-world-homepage #likes-indicator.text-danger,
.page-world-homepage .btn-danger,
.page-world-homepage .btn-info,
.page-world-homepage .btn-sticker,
.page-world-homepage #likes-indicator.text-danger {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  min-height: 30px;
  margin: 3px 2px !important;
  padding: 6px 11px !important;
  color: #ddbd86 !important;
  background: linear-gradient(180deg, #17282c, #071114) !important;
  border: 1px solid #81512f !important;
  border-radius: 2px !important;
  box-shadow: inset 0 0 0 2px rgba(182, 118, 68, 0.06), 0 4px 9px rgba(0, 0, 0, 0.31) !important;
  font-family: var(--font-meta) !important;
  font-size: 9px !important;
  font-weight: 700 !important;
  letter-spacing: 0.07em;
  line-height: 1 !important;
  text-shadow: none !important;
  text-transform: uppercase;
  transition: transform 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease !important;
}

.user-css.page-world-homepage .btn-danger:hover,
.user-css.page-world-homepage .btn-info:hover,
.user-css.page-world-homepage .btn-sticker:hover,
.user-css.page-world-homepage #likes-indicator.text-danger:hover,
.page-world-homepage .btn-danger:hover,
.page-world-homepage .btn-info:hover,
.page-world-homepage .btn-sticker:hover,
.page-world-homepage #likes-indicator.text-danger:hover {
  color: #ffe0aa !important;
  border-color: #c68c53 !important;
  box-shadow: 0 7px 13px rgba(0, 0, 0, 0.38), 0 0 10px rgba(198, 140, 83, 0.14) !important;
  transform: translateY(-3px);
}




/* RSS FEED — STONE SLAB BUTTON */

html body .user-css a.rss-feed-link,
html body .user-css a.btn-rss,
html body .page-world-homepage a.rss-feed-link,
html body .page-world-homepage a.btn-rss {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;

  width: 160px !important;
  max-width: 100% !important;
  aspect-ratio: 292 / 186 !important;

  margin: 18px auto 10px !important;
  padding: 18px 18px 15px !important;

  color: #fff3cf !important;
  -webkit-text-fill-color: #fff3cf !important;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/4bd15c6af034ec8b5af86caac57b6edd.png) !important;

  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;

  border: 0 !important;
  border-color: transparent !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  font-family: var(--font-display) !important;
  font-size: 16px !important;
  font-weight: 700 !important;
  line-height: 1.05 !important;
  letter-spacing: 0.025em !important;

  text-align: center !important;
  text-decoration: none !important;
  text-transform: none !important;

  -webkit-text-stroke: 0.65px #170b04 !important;
  paint-order: stroke fill !important;

  text-shadow:
    -1px -1px 0 #170b04,
     1px -1px 0 #170b04,
    -1px  1px 0 #170b04,
     1px  1px 0 #170b04,
     0 2px 3px rgba(0, 0, 0, 0.95),
     0 0 5px rgba(0, 0, 0, 0.8) !important;

  overflow: hidden !important;

  transform: none !important;

  transition:
    transform 0.25s ease,
    filter 0.25s ease !important;
}


/* Keep nested text bright. */

html body .user-css a.rss-feed-link span,
html body .user-css a.btn-rss span,
html body .page-world-homepage a.rss-feed-link span,
html body .page-world-homepage a.btn-rss span {
  color: inherit !important;
  -webkit-text-fill-color: inherit !important;

  background: transparent !important;

  font: inherit !important;
  line-height: inherit !important;

  text-shadow: inherit !important;
}


/* Hover and keyboard focus */

html body .user-css a.rss-feed-link:hover,
html body .user-css a.rss-feed-link:focus,
html body .user-css a.btn-rss:hover,
html body .user-css a.btn-rss:focus,
html body .page-world-homepage a.rss-feed-link:hover,
html body .page-world-homepage a.rss-feed-link:focus,
html body .page-world-homepage a.btn-rss:hover,
html body .page-world-homepage a.btn-rss:focus {
  color: #ffffff !important;
  -webkit-text-fill-color: #ffffff !important;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/4bd15c6af034ec8b5af86caac57b6edd.png) !important;

  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;

  border: 0 !important;
  border-color: transparent !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  text-decoration: none !important;

  filter:
    brightness(1.08)
    drop-shadow(0 5px 5px rgba(0, 0, 0, 0.42)) !important;

  transform: translateY(-2px) scale(1.025) !important;
}


/* Remove the small RSS icon. */

html body .user-css a.rss-feed-link .fa-rss,
html body .user-css a.btn-rss .fa-rss,
html body .page-world-homepage a.rss-feed-link .fa-rss,
html body .page-world-homepage a.btn-rss .fa-rss {
  display: none !important;
}

/* SUPPORT BUTTONS — INDIVIDUAL STONE FRAMES */

html body .article-social-media .row:first-child {
  display: flex !important;
  flex-wrap: nowrap !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;

  width: 100% !important;
  max-width: 100% !important;

  gap: 20px !important;

  margin: 18px auto 10px !important;
  padding: 0 !important;

  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;

  text-align: center !important;
}


/* Each Bootstrap column becomes one complete framed button. */

html body .article-social-media .row:first-child .col-md-6 {
  position: relative !important;

  display: flex !important;
  flex: 0 1 300px !important;
  align-items: stretch !important;
  justify-content: stretch !important;

  float: none !important;

  box-sizing: border-box !important;

  width: 300px !important;
  max-width: calc(50% - 10px) !important;

  aspect-ratio: 552 / 182 !important;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;

  border-style: solid !important;
  border-color: transparent !important;

  /*
    Scaled from the original 552 × 182 image:

    top:    51px
    right:  56px
    bottom: 42px
    left:   55px
  */

  border-width:
    28px
    30px
    23px
    30px !important;

  border-image-source:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/ef3fbd04e55902f4801cd7b7d54c5817.png) !important;

  border-image-slice:
    51
    56
    42
    55 !important;

  border-image-width:
    28px
    30px
    23px
    30px !important;

  border-image-outset: 0 !important;
  border-image-repeat: stretch !important;

  border-radius: 0 !important;
  box-shadow: none !important;

  overflow: visible !important;

  text-align: center !important;
}


/* The clickable link fills only the opening inside the frame. */

html body .article-social-media .row:first-child .col-md-6 a {
  position: relative !important;

  display: flex !important;
  flex: 1 1 auto !important;
  align-items: stretch !important;
  justify-content: stretch !important;

  box-sizing: border-box !important;

  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;

  height: 100% !important;
  min-height: 0 !important;
  max-height: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;

  border: 0 !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  opacity: 1 !important;
  visibility: visible !important;

  transform: none !important;
  animation: none !important;
}


/* Patreon and Ko-Fi images fill the framed opening. */

html body .article-social-media .row:first-child .col-md-6 a img {
  position: relative !important;

  display: block !important;
  flex: 1 1 auto !important;

  box-sizing: border-box !important;

  width: 100% !important;
  min-width: 100% !important;
  max-width: 100% !important;

  height: 100% !important;
  min-height: 100% !important;
  max-height: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  object-fit: fill !important;

  background: transparent !important;

  border: 0 !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  opacity: 1 !important;
  visibility: visible !important;

  filter: none !important;
  transform: none !important;
  animation: none !important;
}


/* Remove the old alternate-label layers. */

html body .article-social-media .row:first-child .col-md-6 a::before,
html body .article-social-media .row:first-child .col-md-6 a::after {
  content: none !important;
  display: none !important;
}


/* Mobile */

@media only screen and (max-width: 680px) {
  html body .article-social-media .row:first-child {
    flex-wrap: wrap !important;
    gap: 12px !important;
  }

  html body .article-social-media .row:first-child .col-md-6 {
    flex-basis: 300px !important;

    width: min(300px, 100%) !important;
    max-width: 100% !important;
  }
}

/* CINEMATIC OPENING */

.user-css.page-world-homepage .opening-v6 {
  position: relative;
  isolation: isolate;
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  margin: 0 auto 46px;
  overflow: visible;
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

.user-css.page-world-homepage .opening-v6::before {
  content: none !important;
}

.user-css.page-world-homepage .stage-v6 {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: clamp(38px, 5vh, 64px) clamp(18px, 3vw, 48px);
  overflow: hidden;
  background: transparent !important;
}

/* OPENING PARAGRAPHS */

.user-css.page-world-homepage .scene1-v6,
.user-css.page-world-homepage .scene2-v6,
.user-css.page-world-homepage .scene3-v6 {
  box-sizing: border-box;
  width: 96% !important;
  max-width: 1240px !important;
  margin: 0 auto;
  color: #f2ddba;
  font-family: Lora, Georgia, serif !important;
  font-size: clamp(29px, 2.15vw, 40px);
  font-weight: 400;
  line-height: 1.68 !important;
  letter-spacing: 0.018em !important;
  word-spacing: 0.1em !important;
  text-align: center;
  text-wrap: wrap !important;
}

.user-css.page-world-homepage .w6 {
  display: inline-flex;
  white-space: nowrap;
  font-family: inherit !important;
  font-size: inherit;
  font-style: inherit;
  font-weight: inherit;
  line-height: inherit;
  letter-spacing: inherit;
  text-transform: inherit;
}

.user-css.page-world-homepage .l6 {
  display: inline-block;
  color: transparent !important;
  font-family: inherit !important;
  font-size: inherit !important;
  font-style: inherit !important;
  font-weight: inherit !important;
  line-height: inherit !important;
  letter-spacing: inherit;
  background: linear-gradient(
    180deg,
    #fff5df 0%,
    #efd2a2 52%,
    #c58a51 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent !important;
  text-shadow:
    0 2px 3px rgba(0, 0, 0, 0.92),
    0 0 16px rgba(217, 167, 111, 0.09);
  transform-origin: 50% 55%;
  will-change: transform, opacity, filter;
}

.user-css.page-world-homepage .scene1-v6 .w6:first-child .l6,
.user-css.page-world-homepage .scene2-v6 .w6:first-child .l6,
.user-css.page-world-homepage .scene3-v6 .w6:first-child .l6 {
  font-family: CinzelDecorative, Georgia, serif !important;
  font-size: 1.1em !important;
  letter-spacing: 0.045em;
  text-transform: uppercase;
}

/* WELCOME TITLE */

.user-css.page-world-homepage .welcome-v6 {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.22em;
  width: min(1100px, 96%);
  margin: 0;
  font-family: JimNightshade, cursive !important;
  font-size: clamp(60px, 6.5vw, 100px);
  font-style: normal !important;
  font-weight: 400 !important;
  line-height: 1;
  letter-spacing: 0.025em;
  text-align: center;
  text-transform: none;
}

.user-css.page-world-homepage .welcome-v6 .w6,
.user-css.page-world-homepage .welcome-v6 .welcome-letter-v6 {
  font-family: JimNightshade, cursive !important;
  font-style: normal !important;
  font-weight: 400 !important;
  text-transform: none !important;
}

.user-css.page-world-homepage .welcome-v6 .welcome-letter-v6 {
  display: inline-block;
  color: transparent !important;
  font-family: JimNightshade, cursive !important;
  font-size: inherit !important;
  font-style: normal !important;
  font-weight: 400 !important;
  line-height: inherit !important;
  letter-spacing: inherit;
  background: linear-gradient(
    180deg,
    #f8d9a7 0%,
    #c88345 56%,
    #71391f 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent !important;
  text-shadow: none !important;
  -webkit-text-stroke: 0 transparent !important;
  filter: none !important;
  transform-origin: 50% 55%;
  will-change: transform, opacity, filter;
}

/* WORLD TITLE */

.user-css.page-world-homepage .title-v6 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.08em;
  width: min(1240px, 98%) !important;
  margin: 0;
  font-family: CinzelDecorative, Georgia, serif !important;
  font-size: clamp(92px, 11vw, 170px) !important;
  font-style: normal;
  font-weight: 400;
  line-height: 0.98 !important;
  letter-spacing: 0.045em;
  text-align: center;
  text-transform: uppercase;
}

.user-css.page-world-homepage .title-v6 .l6 {
  background: linear-gradient(
    180deg,
    #fff6d9 0%,
    #efc477 34%,
    #cc843f 66%,
    #854123 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent !important;
  text-shadow:
    0 2px 2px rgba(70, 34, 16, 0.82),
    0 5px 10px rgba(0, 0, 0, 0.48),
    0 0 22px rgba(239, 196, 119, 0.30),
    0 0 46px rgba(179, 116, 77, 0.14);
}

/* LETTER FLIGHT */

.user-css.page-world-homepage .l6,
.user-css.page-world-homepage .welcome-letter-v6 {
  --fly-y: -50vh;
  --fly-r: -12deg;
}

.user-css.page-world-homepage .l6:nth-child(6n + 1),
.user-css.page-world-homepage .welcome-letter-v6:nth-child(6n + 1) {
  --fly-y: -42vh;
  --fly-r: -18deg;
}

.user-css.page-world-homepage .l6:nth-child(6n + 2),
.user-css.page-world-homepage .welcome-letter-v6:nth-child(6n + 2) {
  --fly-y: -58vh;
  --fly-r: 22deg;
}

.user-css.page-world-homepage .l6:nth-child(6n + 3),
.user-css.page-world-homepage .welcome-letter-v6:nth-child(6n + 3) {
  --fly-y: -48vh;
  --fly-r: -26deg;
}

.user-css.page-world-homepage .l6:nth-child(6n + 4),
.user-css.page-world-homepage .welcome-letter-v6:nth-child(6n + 4) {
  --fly-y: -66vh;
  --fly-r: 17deg;
}

.user-css.page-world-homepage .l6:nth-child(6n + 5),
.user-css.page-world-homepage .welcome-letter-v6:nth-child(6n + 5) {
  --fly-y: -54vh;
  --fly-r: -23deg;
}

.user-css.page-world-homepage .l6:nth-child(6n + 6),
.user-css.page-world-homepage .welcome-letter-v6:nth-child(6n + 6) {
  --fly-y: -72vh;
  --fly-r: 28deg;
}

/* PARAGRAPH VISIBILITY */

@keyframes v6Scene1Visibility {
  0%, 2% {
    opacity: 0;
  }

  7%, 18% {
    opacity: 1;
  }

  25%, 100% {
    opacity: 0;
  }
}

@keyframes v6Scene2Visibility {
  0%, 28% {
    opacity: 0;
  }

  35%, 44% {
    opacity: 1;
  }

  51%, 100% {
    opacity: 0;
  }
}

@keyframes v6Scene3Visibility {
  0%, 54% {
    opacity: 0;
  }

  61%, 70% {
    opacity: 1;
  }

  77%, 100% {
    opacity: 0;
  }
}

/* PARAGRAPH SCATTER */

@keyframes v6Scene1Letter {
  0%, 18% {
    opacity: 1;
    filter: none;
    transform: translateY(0) rotate(0) scale(1);
  }

  25%, 100% {
    opacity: 0;
    filter: blur(6px);
    transform:
      translateY(var(--fly-y))
      rotate(var(--fly-r))
      scale(0.72);
  }
}

@keyframes v6Scene2Letter {
  0%, 44% {
    opacity: 1;
    filter: none;
    transform: translateY(0) rotate(0) scale(1);
  }

  51%, 100% {
    opacity: 0;
    filter: blur(6px);
    transform:
      translateY(var(--fly-y))
      rotate(var(--fly-r))
      scale(0.72);
  }
}

@keyframes v6Scene3Letter {
  0%, 70% {
    opacity: 1;
    filter: none;
    transform: translateY(0) rotate(0) scale(1);
  }

  77%, 100% {
    opacity: 0;
    filter: blur(6px);
    transform:
      translateY(var(--fly-y))
      rotate(var(--fly-r))
      scale(0.72);
  }
}

/* WELCOME FADE AND SCATTER */

@keyframes v6WelcomeScatter {
  0%, 76% {
    opacity: 0;
    filter: none;
    transform: translateY(0) rotate(0) scale(1);
  }

  80%, 84% {
    opacity: 1;
    filter: none;
    transform: translateY(0) rotate(0) scale(1);
  }

  89%, 100% {
    opacity: 0;
    filter: blur(6px);
    transform:
      translateY(var(--fly-y))
      rotate(var(--fly-r))
      scale(0.72);
  }
}

/* WORLD TITLE FADE AND SCATTER */

@keyframes v6TitleScatter {
  0%, 91% {
    opacity: 0;
    filter: none;
    transform: translateY(0) rotate(0) scale(1);
  }

  94%, 96.8% {
    opacity: 1;
    filter: none;
    transform: translateY(0) rotate(0) scale(1);
  }

  99.2%, 100% {
    opacity: 0;
    filter: blur(6px);
    transform:
      translateY(var(--fly-y))
      rotate(var(--fly-r))
      scale(0.72);
  }
}

/* SCROLL TIMELINE */

@supports (animation-timeline: view()) {
  .user-css.page-world-homepage .opening-v6 {
    min-height: 700vh;
    view-timeline-name: --opening-v6-timeline;
    view-timeline-axis: block;
  }

  .user-css.page-world-homepage .stage-v6 {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 100vh;
  }

  .user-css.page-world-homepage .scene1-v6,
  .user-css.page-world-homepage .scene2-v6,
  .user-css.page-world-homepage .scene3-v6 {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: 0;
    translate: -50% -50%;
    opacity: 0;
    animation-duration: auto;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: --opening-v6-timeline;
    animation-range: contain 0% contain 100%;
  }

  .user-css.page-world-homepage .scene1-v6 {
    animation-name: v6Scene1Visibility;
  }

  .user-css.page-world-homepage .scene2-v6 {
    animation-name: v6Scene2Visibility;
  }

  .user-css.page-world-homepage .scene3-v6 {
    animation-name: v6Scene3Visibility;
  }

  .user-css.page-world-homepage .welcome-v6,
  .user-css.page-world-homepage .title-v6 {
    position: absolute;
    left: 50%;
    margin: 0;
    translate: -50% -50%;
    opacity: 1;
    animation: none !important;
  }

  .user-css.page-world-homepage .welcome-v6 {
    top: calc(50% - 82px);
  }

  .user-css.page-world-homepage .title-v6 {
    top: calc(50% + 88px);
  }

  .user-css.page-world-homepage .l6,
  .user-css.page-world-homepage .welcome-letter-v6 {
    animation-duration: auto;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: --opening-v6-timeline;
    animation-range: contain 0% contain 100%;
  }

  .user-css.page-world-homepage .scene1-v6 .l6 {
    animation-name: v6Scene1Letter;
  }

  .user-css.page-world-homepage .scene2-v6 .l6 {
    animation-name: v6Scene2Letter;
  }

  .user-css.page-world-homepage .scene3-v6 .l6 {
    animation-name: v6Scene3Letter;
  }

  .user-css.page-world-homepage .welcome-v6 .welcome-letter-v6 {
    animation-name: v6WelcomeScatter;
  }

  .user-css.page-world-homepage .title-v6 .l6 {
    animation-name: v6TitleScatter;
  }
}

/* CINEMATIC RESPONSIVE LAYOUT */

@media only screen and (max-width: 900px) {
  .user-css.page-world-homepage .scene1-v6,
  .user-css.page-world-homepage .scene2-v6,
  .user-css.page-world-homepage .scene3-v6 {
    width: 96% !important;
    max-width: 860px !important;
    font-size: clamp(25px, 3.8vw, 34px);
    line-height: 1.62 !important;
  }
}

@media only screen and (max-width: 768px) {
  .user-css.page-world-homepage .stage-v6 {
    padding: 34px 14px;
  }

  .user-css.page-world-homepage .scene1-v6,
  .user-css.page-world-homepage .scene2-v6,
  .user-css.page-world-homepage .scene3-v6 {
    width: 98% !important;
    font-size: clamp(20px, 4.9vw, 29px);
    line-height: 1.55 !important;
    letter-spacing: 0.012em !important;
    word-spacing: 0.05em !important;
  }

  .user-css.page-world-homepage .welcome-v6 {
    width: 98%;
    font-size: clamp(48px, 12vw, 72px);
    top: calc(50% - 58px);
  }

  .user-css.page-world-homepage .title-v6 {
    width: 98% !important;
    font-size: clamp(64px, 16vw, 100px) !important;
    top: calc(50% + 72px);
  }
}

/* ================================================================
   LEARN MORE — OPEN BOOK DIRECTORY
   COMPLETE REPLACEMENT
   ================================================================ */

.user-css .learn-book,
.user-css .learn-book * {
  box-sizing: border-box;
}

.user-css .learn-book {
  position: relative;
  isolation: isolate;
  width: min(1240px, 100%);
  aspect-ratio: 2048 / 1224;
  margin: 24px auto 42px;
  overflow: hidden;

  background:
    url(https://wa-cdn.nyc3.cdn.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/5b5b59aa3294fd0020cba4f84d0131a1.png)
    center / 100% 100% no-repeat !important;

  border: 0 !important;
  box-shadow: none !important;
}

/* Paper/grime layer over the article blocks. */

.user-css .learn-book::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 20;
  display: block;
  pointer-events: none;

  background:
    url(https://wa-cdn.nyc3.cdn.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/5b5b59aa3294fd0020cba4f84d0131a1.png)
    center / 100% 100% no-repeat !important;

  opacity: 0.24;
  mix-blend-mode: multiply;
  filter: saturate(0.72) contrast(1.16);
}

/* Position the two columns over the book pages. */

.user-css .learn-book-left,
.user-css .learn-book-right {
  position: absolute;
  z-index: 2;
  top: 9%;
  bottom: 9%;

  display: grid;
  grid-template-rows: repeat(3, minmax(0, 1fr));
  gap: 2.2%;

  width: 38.5%;
  min-width: 0;

  margin: 0 !important;
  padding: 0 !important;
}

.user-css .learn-book-left {
  left: 8.5%;
}

.user-css .learn-book-right {
  right: 8.5%;
}

.user-css .learn-book-left > br,
.user-css .learn-book-right > br {
  display: none !important;
}

/* Flat article panels: no lines, fills, shadows, or movement. */

html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover {
  position: relative !important;
  z-index: 1 !important;

  display: block !important;
  width: 100% !important;
  min-width: 0 !important;
  max-width: none !important;
  height: 100% !important;
  min-height: 0 !important;

  margin: 0 !important;
  padding: clamp(4px, 0.55vw, 8px) !important;
  overflow: hidden !important;

  color: #38281b !important;
  background: transparent !important;
  background-color: transparent !important;

  border: 0 !important;
  border-radius: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;

  filter: none !important;
  opacity: 1 !important;
  transform: none !important;
  animation: none !important;
  transition: none !important;
}

/* Remove the theme's solid teal hover cover. */

html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel::before,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel::after,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover::before,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover::after {
  content: none !important;
  display: none !important;

  background: none !important;
  opacity: 0 !important;

  filter: none !important;
  transform: none !important;
  animation: none !important;
  transition: none !important;
}

/* Remove the theme's second animated excerpt cover. */

html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .details p,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .details p.excerpt,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover .details p,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover .details p.excerpt {
  display: none !important;
  visibility: hidden !important;

  background: none !important;
  opacity: 0 !important;

  filter: none !important;
  transform: none !important;
  animation: none !important;
  transition: none !important;
}

/* Normalize World Anvil's article-block structure. */

.user-css .learn-book .article-panel > a,
.user-css .learn-book .article-panel .panel-body,
.user-css .learn-book .article-panel .row {
  width: 100% !important;
  max-width: none !important;
  height: 100% !important;
  min-height: 0 !important;

  margin: 0 !important;
  padding: 0 !important;

  color: #38281b !important;
  background: transparent !important;

  border: 0 !important;
  box-shadow: none !important;

  transform: none !important;
  animation: none !important;
  transition: none !important;
}

.user-css .learn-book .article-panel > a {
  display: flex !important;
  flex-direction: column !important;
  align-items: stretch !important;
  justify-content: flex-start !important;

  text-decoration: none !important;
}

.user-css .learn-book .article-panel .row {
  display: flex !important;
  flex-direction: column !important;
  flex-wrap: nowrap !important;
  align-items: stretch !important;
}

.user-css .learn-book .article-panel [class*="col-"] {
  flex: 0 0 auto !important;

  width: 100% !important;
  max-width: 100% !important;
  min-height: 0 !important;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

.user-css .learn-book .article-panel [class*="col-"]:first-child {
  flex: 1 1 auto !important;
  overflow: hidden !important;
}

/* Images: faded edges, parchment blending, no frame or hover effect. */

html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel img,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel img:hover,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover img,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .img-responsive,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .img-fluid,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .max-width-100 {
  display: block !important;

  width: 100% !important;
  max-width: none !important;
  height: clamp(54px, 6.1vw, 92px) !important;

  margin: 0 !important;
  padding: 0 !important;

  object-fit: cover !important;
  object-position: center !important;

  background: transparent !important;

  border: 0 !important;
  border-image: none !important;
  border-radius: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;

  opacity: 0.84 !important;

  filter:
    sepia(0.38)
    saturate(0.72)
    contrast(0.90)
    brightness(0.97) !important;

  mix-blend-mode: multiply !important;

  transform: none !important;
  animation: none !important;
  transition: none !important;

  -webkit-mask-image:
    radial-gradient(
      ellipse 100% 100% at center,
      #000 0%,
      #000 64%,
      rgba(0, 0, 0, 0.84) 76%,
      rgba(0, 0, 0, 0.34) 91%,
      transparent 100%
    ) !important;

  mask-image:
    radial-gradient(
      ellipse 100% 100% at center,
      #000 0%,
      #000 64%,
      rgba(0, 0, 0, 0.84) 76%,
      rgba(0, 0, 0, 0.34) 91%,
      transparent 100%
    ) !important;

  -webkit-mask-position: center !important;
  mask-position: center !important;

  -webkit-mask-repeat: no-repeat !important;
  mask-repeat: no-repeat !important;

  -webkit-mask-size: 100% 100% !important;
  mask-size: 100% 100% !important;
}

/* Jim Nightshade titles, including hover state. */

html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .heading,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel .heading a,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel h5,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel h5 a,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover .heading,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover .heading a,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover h5,
html body .user-css.page-world-homepage
.learn-book.learn-book .article-panel.article-panel:hover h5 a {
  position: static !important;

  display: block !important;
  width: 100% !important;
  max-width: none !important;

  margin: clamp(3px, 0.45vw, 7px) 0 0 !important;
  padding: 0 !important;
  overflow: visible !important;

  color: #4b2d1b !important;
  background: none !important;
  background-image: none !important;

  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;

  font-family: JimNightshade, Georgia, cursive !important;
  font-size: clamp(23px, 2.35vw, 35px) !important;
  font-style: normal !important;
  font-weight: 400 !important;
  line-height: 1 !important;
  letter-spacing: 0.015em !important;

  text-align: center !important;
  text-decoration: none !important;
  text-transform: none !important;

  text-shadow:
    0 1px rgba(255, 246, 219, 0.50),
    0 0 5px rgba(88, 49, 24, 0.08) !important;

  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  -webkit-text-fill-color: #4b2d1b !important;

  filter: none !important;
  transform: none !important;
  animation: none !important;
  transition: none !important;
}

/* Hide excerpts, metadata, and subheadings. */

.user-css .learn-book .article-panel .subheading,
.user-css .learn-book .article-panel p,
.user-css .learn-book .article-panel small,
.user-css .learn-book .article-panel .text-muted {
  display: none !important;
}

/* MOBILE: two readable parchment sheets. */

@media only screen and (max-width: 760px) {
  .user-css .learn-book {
    display: grid;
    gap: 18px;

    width: 100%;
    aspect-ratio: auto;

    margin: 18px auto 32px;
    padding: 0;
    overflow: visible;

    background: none !important;
  }

  .user-css .learn-book::after {
    content: none !important;
    display: none !important;
  }

  .user-css .learn-book-left,
  .user-css .learn-book-right {
    position: relative;
    inset: auto;

    display: grid;
    grid-template-rows: repeat(3, minmax(150px, auto));
    gap: 12px;

    width: 100%;
    padding: 24px 20px !important;

    background:
      radial-gradient(
        circle at 50% 20%,
        rgba(255, 252, 230, 0.54),
        transparent 60%
      ),
      #dfcfaa !important;

    border: 1px solid #6f4528 !important;

    box-shadow:
      0 10px 22px rgba(0, 0, 0, 0.34),
      inset 0 0 30px rgba(81, 48, 26, 0.20) !important;
  }

  html body .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel,
  html body .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel:hover {
    min-height: 150px !important;
    padding: 8px !important;
  }

  html body .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel img,
  html body .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel .img-responsive,
  html body .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel .img-fluid {
    height: 92px !important;
  }

  html body .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel .heading,
  html body .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel .heading a,
  html body .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel h5,
  html body .user-css.page-world-homepage
  .learn-book.learn-book .article-panel.article-panel h5 a {
    font-size: clamp(24px, 7vw, 32px) !important;
  }
}

/* ================================================================
   PARCHMENT PAGE
   ================================================================ */

.user-css .parchment-page,
.user-css-extended .parchment-page {
  position: relative !important;
  isolation: isolate;
  box-sizing: border-box !important;

  display: block !important;
  width: 100% !important;
  max-width: 1100px !important;
  min-height: 260px !important;

  margin: 30px auto 45px !important;
  padding: 34px 46px !important;
  overflow: visible !important;

  color: #3d2b1e !important;
  background: transparent !important;

  border: 52px solid transparent !important;

  border-image-source:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/a10fa12150a520e1953d3e1440db0ba3.png) !important;

  border-image-slice: 95 fill !important;
  border-image-width: 1 !important;
  border-image-outset: 0 !important;
  border-image-repeat: stretch !important;

  border-radius: 0 !important;
  box-shadow: none !important;

  filter:
    drop-shadow(0 10px 8px rgba(0, 0, 0, 0.28))
    drop-shadow(0 20px 24px rgba(0, 0, 0, 0.18)) !important;

  font-family:
    Cardo,
    EBGaramond,
    Garamond,
    serif !important;

  font-size: clamp(16px, 1.35vw, 20px) !important;
  line-height: 1.65 !important;

  text-align: left !important;
  text-shadow: none !important;
}

/* Ordinary text */

.user-css .parchment-page p,
.user-css .parchment-page li,
.user-css .parchment-page span,
.user-css .parchment-page strong,
.user-css .parchment-page b,
.user-css .parchment-page em,
.user-css .parchment-page figcaption,
.user-css-extended .parchment-page p,
.user-css-extended .parchment-page li,
.user-css-extended .parchment-page span,
.user-css-extended .parchment-page strong,
.user-css-extended .parchment-page b,
.user-css-extended .parchment-page em,
.user-css-extended .parchment-page figcaption {
  color: #3d2b1e !important;
  background: transparent !important;
  text-shadow: none !important;
}

.user-css .parchment-page :is(p, li, td, blockquote) i,
.user-css-extended .parchment-page :is(p, li, td, blockquote) i {
  color: #3d2b1e !important;
  text-shadow: none !important;
}

.user-css .parchment-page small,
.user-css .parchment-page .text-muted,
.user-css .parchment-page .author,
.user-css-extended .parchment-page small,
.user-css-extended .parchment-page .text-muted,
.user-css-extended .parchment-page .author {
  color: #6b4a34 !important;
  background: transparent !important;
  text-shadow: none !important;
}

/* Headings */

.user-css .parchment-page h1,
.user-css .parchment-page h2,
.user-css .parchment-page h3,
.user-css .parchment-page h4,
.user-css .parchment-page h5,
.user-css-extended .parchment-page h1,
.user-css-extended .parchment-page h2,
.user-css-extended .parchment-page h3,
.user-css-extended .parchment-page h4,
.user-css-extended .parchment-page h5 {
  color: #542b18 !important;
  background: none !important;

  border-color: rgba(94, 49, 25, 0.38) !important;
  box-shadow: none !important;

  font-family:
    JimNightshade,
    Georgia,
    serif !important;

  font-weight: 400 !important;
  line-height: 1.1 !important;
  letter-spacing: 0.015em !important;

  text-align: left !important;
  text-transform: none !important;

  text-shadow:
    0 1px rgba(255, 247, 224, 0.72),
    0 0 4px rgba(83, 43, 23, 0.08) !important;

  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  -webkit-text-fill-color: #542b18 !important;
}

/* Links */

.user-css .parchment-page a,
.user-css-extended .parchment-page a {
  color: #7b3f20 !important;
  background: transparent !important;

  font-weight: 600 !important;
  text-decoration-color: rgba(123, 63, 32, 0.45) !important;
  text-shadow: none !important;

  -webkit-text-fill-color: #7b3f20 !important;

  transition: color 180ms ease !important;
}

.user-css .parchment-page a:hover,
.user-css .parchment-page a:focus,
.user-css-extended .parchment-page a:hover,
.user-css-extended .parchment-page a:focus {
  color: #a24e22 !important;
  text-decoration-color: #a24e22 !important;
  -webkit-text-fill-color: #a24e22 !important;
}

/* Quotations */

.user-css .parchment-page blockquote,
.user-css-extended .parchment-page blockquote {
  margin: 24px 18px !important;
  padding: 16px 20px !important;

  color: #4a3020 !important;
  background: rgba(112, 68, 34, 0.07) !important;

  border: 0 !important;
  border-left: 3px solid rgba(126, 71, 34, 0.62) !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  animation: none !important;
  font-size: 1.05em !important;

  font-family:
    Cardo,
    EBGaramond,
    Garamond,
    serif !important;

  text-shadow: none !important;
}

.user-css .parchment-page blockquote::before,
.user-css-extended .parchment-page blockquote::before {
  content: none !important;
  display: none !important;
}

/* Dividers */

.user-css .parchment-page hr,
.user-css-extended .parchment-page hr {
  height: 1px !important;
  margin: 28px auto !important;

  background: rgba(103, 56, 29, 0.45) !important;

  border: 0 !important;
  box-shadow: none !important;
}

/* Tables */

.user-css .parchment-page table,
.user-css-extended .parchment-page table {
  color: #3d2b1e !important;
  background: rgba(111, 67, 34, 0.045) !important;

  border-color: rgba(103, 56, 29, 0.38) !important;
  box-shadow: none !important;
}

.user-css .parchment-page th,
.user-css .parchment-page td,
.user-css-extended .parchment-page th,
.user-css-extended .parchment-page td {
  color: #3d2b1e !important;
  background: transparent !important;

  border-color: rgba(103, 56, 29, 0.28) !important;
  text-shadow: none !important;
}

.user-css .parchment-page th,
.user-css-extended .parchment-page th {
  background: rgba(111, 67, 34, 0.09) !important;
}

/* Mobile */

@media only screen and (max-width: 760px) {
  .user-css .parchment-page,
  .user-css-extended .parchment-page {
    width: 100% !important;
    min-height: 180px !important;

    margin: 20px auto 32px !important;
    padding: 18px 20px !important;

    border-width: 28px !important;

    font-size: 16px !important;
    line-height: 1.55 !important;

    filter:
      drop-shadow(0 7px 6px rgba(0, 0, 0, 0.24))
      drop-shadow(0 12px 15px rgba(0, 0, 0, 0.14)) !important;
  }

  .user-css .parchment-page blockquote,
  .user-css-extended .parchment-page blockquote {
    margin: 18px 4px !important;
    padding: 12px 14px !important;
  }
}

@media only screen and (max-width: 500px) {
  
}

