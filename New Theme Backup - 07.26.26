/* Unknown Shores 2.2 — World Anvil Theme - Don't Fuck This Up */
/* SolomonJack · UnknownShoresRPG.com */

/* FONTS */

@font-face {
  font-family: CinzelDecorative;
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/cinzeldecorative/v6/daaCSScvJGqLYhG8nNt8KPPswUAPni7TTMw.woff2);
}

@font-face {
  font-family: EBGaramond;
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/ebgaramond/v9/SlGUmQSNjdsmc35JDF1K5GR7SDktYw.woff2);
}

@font-face {
  font-family: Lora;
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/lora/v12/4vqKRIwnQQGUQQh-PnvdMA.woff2);
}

@font-face {
  font-family: JimNightshade;
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/jimnightshade/v20/PlIkFlu9Pb08Q8HLM1PxmB0g-NS_XXs.woff2);
}

@font-face {
  font-family: Cardo;
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/cardo/v20/wlp_gwjKBV1pqhv43IE.woff2);
}

@font-face {
  font-family: IslandMoments;
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/islandmoments/v7/NaPBcZfVGvBdxIt7Ar0qzkXJF9TBKIk.woff2);
}

@font-face {
  font-family: Montserrat;
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/montserrat/v30/JTUSjIg1_i6t8kCHKm459Wlhyw.woff2);
}

/* VARIABLES */

:root {
  --font-header: JimNightshade, Georgia, Times New Roman, serif;
  --font-display: CinzelDecorative, Georgia, Times New Roman, serif;
  --font-title: var(--font-display);
  --font-body: Cardo, EBGaramond, Garamond, serif;
  --font-quote: IslandMoments, cursive;
  --font-meta: Montserrat, Arial, Helvetica, sans-serif;

  --color-background: #04090f;
  --color-background-deep: #020509;
  --color-background-soft: #09121a;
  --color-secondary-bg: var(--color-background-soft);
  --color-background-gradient: linear-gradient(180deg, rgba(4, 9, 15, 0.98) 0%, rgba(12, 30, 35, 0.97) 55%, rgba(9, 42, 47, 0.96) 100%);
  --color-panel: rgba(5, 14, 21, 0.88);
  --color-panel-hover: rgba(10, 25, 32, 0.94);

  --color-text: #e6e1d8;
  --color-muted: #beb28f;
  --color-link: #c68c53;
  --color-link-light: #f0c38e;
  --color-accent: #d9a76f;
  --color-accent-deep: #8f4f2d;
  --color-border: #b3744d;
  --color-border-soft: rgba(179, 116, 77, 0.48);
  --color-shadow: rgba(224, 180, 120, 0.25);
  --color-header-shadow: 1px 1px 1px rgba(0, 0, 0, 0.3);

  --color-header: linear-gradient(45deg, #4a2c1a 10%, #a85c32 32%, #d98e5f 52%, #a85c32 72%, #4a2c1a 92%);
  --color-small-header: linear-gradient(45deg, #6b3b23 0%, #bd7045 20%, #e3a26f 50%, #bd7045 80%, #6b3b23 100%);

  --radius-small: 5px;
  --radius-medium: 10px;
  --radius-large: 18px;
  --page-width: 1760px;

  --outer-background-image: url(https://cdn.midjourney.com/3df8f914-91f4-4e49-813d-bae8923bc045/0_0.png);
  --header-background-image: url(https://www.worldanvil.com/i/6982210/render);

}

/* ANIMATIONS */

@keyframes fadeInFromBlack {
  0% {
    opacity: 0;
    background-color: #000;
  }

  100% {
    opacity: 1;
  }
}

@keyframes contentFadeIn {
  0% {
    opacity: 0;
    transform: translateY(20px);
  }

  40% {
    opacity: 0;
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes borderFlow {
  0% {
    background-position: 0% 50%;
  }

  50% {
    background-position: 100% 50%;
  }

  100% {
    background-position: 0% 50%;
  }
}

@keyframes floatQuote {
  0% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-6px) rotate(-0.2deg);
  }

  100% {
    transform: translateY(0) rotate(0);
  }
}

@keyframes compassSpin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes compassSpinFast {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes waExcerptFocus {
  0% {
    filter: blur(12px) brightness(1.20);
    transform: translateY(8px) scale(1.02);
  }

  70% {
    filter: blur(1px) brightness(1.05);
    transform: translateY(0) scale(1);
  }

  100% {
    filter: none;
    transform: translateY(0) scale(1);
  }
}

@keyframes waFlicker {

  0%,
  100% {
    opacity: 1;
  }

  48% {
    opacity: 0.96;
  }

  50% {
    opacity: 0.985;
  }

  52% {
    opacity: 0.97;
  }
}

@keyframes bookFloat {
  0% {
    transform: translateY(-25px) scale(1.3) rotate(0deg);
  }

  15% {
    transform: translateY(-32px) scale(1.3) rotate(0.3deg);
  }

  30% {
    transform: translateY(-28px) scale(1.3) rotate(-0.2deg);
  }

  50% {
    transform: translateY(-35px) scale(1.3) rotate(0.1deg);
  }

  65% {
    transform: translateY(-30px) scale(1.3) rotate(-0.3deg);
  }

  80% {
    transform: translateY(-33px) scale(1.3) rotate(0.2deg);
  }

  100% {
    transform: translateY(-25px) scale(1.3) rotate(0deg);
  }
}

@keyframes tp-front-out {

  0%,
  31% {
    opacity: 1;
  }

  38%,
  100% {
    opacity: 0;
  }
}

@keyframes tp-line1-in {

  0%,
  44% {
    opacity: 0;
  }

  52%,
  100% {
    opacity: 1;
  }
}

@keyframes tp-line2-in {

  0%,
  70% {
    opacity: 0;
  }

  80%,
  100% {
    opacity: 1;
  }
}

/* OUTER WORLD BACKGROUND */

html,
body {
  background-color: var(--color-background-deep);
}

.user-css-presentation,
.presentation-interface {
  min-height: 100vh;
  color: var(--color-text);
  font-family: var(--font-body);
  background-color: var(--color-background-deep);
  background-image:
    linear-gradient(180deg, rgba(2, 5, 9, 0.48) 0%, rgba(4, 9, 15, 0.62) 48%, rgba(4, 9, 15, 0.82) 100%),
    var(--outer-background-image);
  background-position: center top;
  background-size: 100% auto;
  background-repeat: no-repeat;
  background-attachment: fixed;
  animation: fadeInFromBlack 1.2s ease-out both;
}

.user-css-presentation .row .world-content {
  text-align: center !important;
}

.user-css {
  background: linear-gradient(to bottom, rgba(0, 20, 40, 0.3) 0%, rgba(0, 30, 30, 0.4) 80%), url(https://www.worldanvil.com/i/6982205/render);
  box-shadow: inset 0 0 20px var(--color-background);
  width: 100%;
  max-width: none;
  justify-self: stretch;
  box-sizing: border-box;
  margin: 0 auto;
}

.user-css>*:not(.article-title) {
  animation: contentFadeIn 2.5s ease-out;
}

/* GLOBAL HEADER */

.user-css-presentation .world-global-header {
  position: relative;
  z-index: 1000;
  width: 100%;
  min-height: 92px;
  margin: 0;
  padding: 14px clamp(18px, 4vw, 48px);
  display: flex;
  align-items: center;
  background-image:
    linear-gradient(90deg, rgba(2, 5, 9, 0.94), rgba(4, 9, 15, 0.64), rgba(2, 5, 9, 0.94)),
    var(--header-background-image);
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
  border-bottom: 1px solid var(--color-border-soft);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.42);
}

.user-css-presentation .world-global-header .d-block {
  display: flex !important;
  align-items: center;
}

.user-css-presentation .world-global-header h1,
.user-css-presentation .world-global-header h2,
.user-css-presentation .world-global-header p,
.user-css-presentation .world-global-header a {
  margin: 0;
  color: var(--color-text);
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85);
}

/* AUTHOR DISPLAY */

.user-css .world-authors {
  display: none;
}

/* MAIN PAGE FRAME */

.user-css.page,
.user-css-extended .page {
  box-sizing: border-box;
  width: min(var(--page-width), calc(100% - 20px));
  max-width: var(--page-width);
  min-height: 70vh;
  margin: 24px auto 52px;
  padding: clamp(20px, 2vw, 34px);
  color: var(--color-text);
  font-family: var(--font-body);
  font-size: 18px;
  line-height: 1.72;
  background:
    linear-gradient(180deg, rgba(4, 9, 15, 0.94), rgba(9, 30, 35, 0.93)),
    radial-gradient(circle at 50% 0%, rgba(217, 167, 111, 0.08), transparent 42%);
  border: 1px solid var(--color-border-soft);
  border-radius: var(--radius-large);
  box-shadow:
    0 24px 70px rgba(0, 0, 0, 0.72),
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    inset 0 0 50px rgba(0, 0, 0, 0.18);
  overflow: visible;
  animation: contentFadeIn 0.9s ease-out both;
}

.user-css .world-content,
.user-css .article-content,
.user-css .article-content-left,
.user-css .article-content-right {
  color: var(--color-text);
}

.user-css .article-content,
.user-css .world-content {
  margin-inline: auto;
}
@media only screen and (min-width: 992px) {
  .user-css .article-content-left,
  .user-css .article-content-left.col-md-8 {
    float: left;
    width: 80% !important;
    max-width: 80% !important;
    flex: 0 0 80% !important;
    padding-left: 8px;
    padding-right: 24px;
  }

  .user-css .article-content-right,
  .user-css .article-content-right.col-md-4 {
    float: left;
    width: 20% !important;
    max-width: 20% !important;
    flex: 0 0 20% !important;
    padding-left: 18px;
    padding-right: 8px;
  }
}

.user-css p,
.user-css-extended p,
.user-css li,
.user-css-extended li,
.user-css td,
.user-css th {
  color: var(--color-text);
  font-family: var(--font-body);
}

.user-css p,
.user-css-extended p {
  margin: 0 0 1em;
}

.user-css strong,
.user-css b,
.user-css-extended strong,
.user-css-extended b {
  color: #f2e9da;
}

.user-css small,
.user-css .text-muted,
.user-css-extended small,
.user-css-extended .text-muted {
  color: var(--color-muted) !important;
}

.user-css.page-world-homepage {
  background: transparent !important;
  box-shadow: none !important;
}

.user-css.page-world-homepage .article-panel h5 a {
  font-family: var(--font-header);
  font-size: 35px;
  top: 20px;
  position: relative;
}

.user-css.page-world-homepage #cover img {
  width: 100%;
  height: auto;
  display: block;
  -webkit-mask-image: linear-gradient(to bottom, black 45%, transparent 100%), linear-gradient(to top, black 65%, transparent 100%), linear-gradient(to right, black 45%, transparent 100%), linear-gradient(to left, black 45%, transparent 100%);
  -webkit-mask-composite: destination-in;
  mask-image: linear-gradient(to bottom, black 45%, transparent 100%), linear-gradient(to top, black 65%, transparent 100%), linear-gradient(to right, black 45%, transparent 100%), linear-gradient(to left, black 45%, transparent 100%);
  mask-composite: intersect;
  opacity: 0.6;
  filter: blur(0.1px) brightness(90%);
}

.user-css.page-world-homepage h2 {
  font-family: var(--font-quote);
  text-transform: capitalize;
  font-weight: 400;
  letter-spacing: 2px;
  background: var(--color-header);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  font-size: clamp(35px, 5vw, 90px);
  text-shadow: var(--color-header-shadow);
  text-align: center;
  border-bottom: 2px solid var(--color-border);
}

.user-css.page-world-homepage .user-custom-content-3 img.img-fluid.img-responsive,
.user-css.page-world-homepage .user-custom-content-3 img.img-responsive.img-fluid {
  box-shadow: none !important;
  filter: none !important;
}

.user-css.page-world-homepage .user-custom-content-3 img.img-fluid.img-responsive:hover,
.user-css.page-world-homepage .user-custom-content-3 img.img-responsive.img-fluid:hover {
  box-shadow: none !important;
  filter: none !important;
}
.user-css #cover img {
  -webkit-mask-composite: destination-in;
  mask-image: linear-gradient(to bottom, black 15%, transparent 100%), linear-gradient(to top, black 80%, transparent 100%);
  mask-composite: intersect;
  opacity: 0.7;
  filter: brightness(90%);
}

/* WORLD TITLE AND SUBTITLE */

.user-css .heading {
  text-align: center;
}

.user-css .world-subtitle {
  display: block;
  margin: 0 auto 0.75em;
  padding: 0.1em 0;
  font-family: var(--font-quote);
  font-size: clamp(32px, 5vw, 68px);
  font-weight: 400;
  letter-spacing: 0.04em;
  line-height: 1.15;
  text-align: center;
  color: var(--color-link-light);
  background: var(--color-small-header);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.72));
}

.user-css div.author-item.world-author {
  padding-top: 0;
  color: var(--color-muted);
  font-family: var(--font-meta);
  font-size: 13px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-align: center;
}

.user-css .article-panel {
  position: relative;
  overflow: hidden;
  border-radius: 20px 0px;
  background: var(--color-secondary-bg);
  border: 1px solid var(--color-border);
  transition: box-shadow 1s ease;
}

.user-css .article-panel:hover {
  box-shadow: 0 0 15px var(--color-shadow);
  z-index: 10;
}

.user-css .article-panel .heading {
  font-family: var(--font-header);
  font-size: clamp(20px, 2vw, 35px);
  background: var(--color-header);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  margin-bottom: 10px;
}

.user-css .article-panel .subheading {
  display: none;
}

.user-css .article-panel::before {
  content: "";
  font-size: 0;
  line-height: 0;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #071820;
  opacity: 0;
  transition: opacity 0.4s ease;
  z-index: 2;
  pointer-events: none;
}

.user-css .article-panel .details,
.user-css .article-panel .details .heading {
  text-align: center;
}

.user-css .article-panel .details .heading {
  width: 100%;
  margin-left: auto;
  margin-right: auto;
}

.user-css .article-panel:hover::before {
  opacity: 1;
}

.user-css .article-panel .details p {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #071820 0%, #0a242c 100%);
  padding: 20px;
  margin: 0;
  overflow-y: auto;
  font-family: var(--font-body);
  font-size: clamp(16px, 2vw, 22px);
  line-height: 1.6;
  color: var(--color-link);
  text-shadow: 0 0 2px var(--color-accent);
  border-radius: 20px 0px;
  opacity: 0;
  transition: opacity 0.4s ease;
  z-index: 3;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-css .article-panel:hover .details p {
  opacity: 1;
}

.user-css .article-panel .details p.excerpt {
  opacity: 0 !important;
  filter: blur(12px) brightness(1.15);
  transform: translateY(8px) scale(1.02);
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.user-css .article-panel:hover .details p.excerpt {
  opacity: 1 !important;
  animation: waExcerptFocus 1.1s ease forwards, waFlicker 3.2s ease-in-out infinite;
}

/* ARTICLE TITLE AND BREADCRUMBS */

.user-css .article-title {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 4px;
  margin-bottom: 28px;
  text-align: center;
}

.user-css .breadbox {
  order: 1;
  margin: 0 0 12px;
}

.user-css .article-title .m-b-0 {
  order: 2;
  width: 100%;
  text-align: center !important;
}

.user-css .article-title-author {
  order: 3;
  width: 100%;
  text-align: center;
  color: var(--color-muted);
  font-family: var(--font-meta);
  font-size: 13px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.user-css .breadbox .breadcrumb-world-link-wrapper {
  display: none;
}

.user-css .breadbox .breadcrumb {
  height: auto;
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--color-muted);
  font-family: var(--font-meta);
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.user-css .breadbox .breadcrumb a {
  color: var(--color-link);
  font-family: var(--font-meta);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
}

.user-css .category-contents .breadcrumb {
  display: none;
}

.user-css .category-contents,
.user-css-extended .category-contents {
  color: #000000;
  text-shadow: none;
}

.user-css .category-contents :is(p, li, td, th, blockquote, figcaption, small, strong, b, em, i),
.user-css-extended .category-contents :is(p, li, td, th, blockquote, figcaption, small, strong, b, em, i) {
  color: #000000 !important;
  -webkit-text-fill-color: #000000 !important;
  text-shadow: none !important;
}

.user-css .category-contents a,
.user-css-extended .category-contents a {
  color: #5b2d18;
  -webkit-text-fill-color: #5b2d18;
  text-shadow: none;
}

.user-css .category-contents a:hover,
.user-css-extended .category-contents a:hover {
  color: #8b451f;
  -webkit-text-fill-color: #8b451f;
}

.user-css .breadcrumb-article-icon {
  color: var(--color-accent);
}

/* HEADINGS */

.user-css h1,
.user-css-extended h1,
.user-css h2,
.user-css-extended h2,
.user-css h3,
.user-css-extended h3,
.user-css h4,
.user-css-extended h4,
.user-css h5,
.user-css-extended h5 {
  font-family: var(--font-header);
  font-weight: 400;
  color: var(--color-accent);
  text-shadow: 0 2px 3px rgba(0, 0, 0, 0.72);
}

.user-css h1,
.user-css-extended h1 {
  margin: 0.15em 0 0.35em;
  font-family: var(--font-display);
  font-size: clamp(42px, 6vw, 78px);
  line-height: 1.12;
  letter-spacing: 0.025em;
  background: var(--color-header);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.user-css h2,
.user-css-extended h2 {
  margin: 1.35em 0 0.55em;
  padding-bottom: 0.16em;
  font-size: clamp(34px, 4.2vw, 54px);
  line-height: 1.15;
  border-bottom: 1px solid var(--color-border-soft);
  background: var(--color-small-header);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.user-css h3,
.user-css-extended h3 {
  margin: 1.2em 0 0.45em;
  font-size: clamp(29px, 3.5vw, 44px);
  line-height: 1.18;
  color: var(--color-accent);
}

.user-css h4,
.user-css-extended h4 {
  margin: 1.15em 0 0.35em;
  font-size: clamp(24px, 3vw, 35px);
  line-height: 1.2;
  color: var(--color-link-light);
}

.user-css h5,
.user-css-extended h5 {
  margin: 1em 0 0.3em;
  font-size: clamp(21px, 2.5vw, 30px);
  line-height: 1.2;
  color: var(--color-link);
}

/* LINKS, ICONS, RULES, AND LISTS */

.user-css a,
.user-css-extended a {
  color: var(--color-link);
  font-family: inherit;
  text-decoration-color: rgba(198, 140, 83, 0.48);
  text-underline-offset: 0.15em;
  transition: color 0.25s ease, text-shadow 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
}

.user-css a:hover,
.user-css-extended a:hover {
  color: var(--color-link-light);
  text-decoration-color: var(--color-link-light);
  text-shadow: 0 0 10px rgba(217, 167, 111, 0.25);
}

.user-css i,
.user-css-extended i {
  color: var(--color-accent);
}

.user-css hr,
.user-css-extended hr {
  height: 1px;
  margin: 2em 0;
  border: 0;
  background: linear-gradient(90deg, transparent, var(--color-border), transparent);
}

.user-css ul,
.user-css ol {
  margin-bottom: 1.15em;
}

.user-css li::marker {
  color: var(--color-link);
}

/* IMAGES, FIGURES, AND CAPTIONS */

.user-css img,
.user-css .img-responsive,
.user-css figure img {
  max-width: 100%;
  height: auto;
}

.user-css .article-content img,
.user-css figure img,
.user-css .img-responsive {
  border: 1px solid var(--color-border-soft);
  border-radius: var(--radius-small);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.46);
}

.user-css figure {
  margin: 1.6em auto;
}

.user-css figcaption,
.user-css .artist-credits,
.user-css .image-credits {
  margin-top: 0.45em;
  color: var(--color-muted);
  font-family: var(--font-meta);
  font-size: 12px;
  line-height: 1.45;
  letter-spacing: 0.03em;
  text-align: center;
}

/* TABLES */

.user-css .table-responsive {
  margin: 1.5em 0;
  border: 1px solid var(--color-border-soft);
  border-radius: var(--radius-medium);
  overflow-x: auto;
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
}

.user-css table,
.user-css .table {
  width: 100%;
  margin: 0;
  color: var(--color-text);
  background: rgba(2, 7, 11, 0.58);
  border-collapse: collapse;
  font-family: var(--font-body);
}

.user-css table th,
.user-css .table th {
  padding: 12px 14px;
  color: var(--color-link-light);
  background: rgba(179, 116, 77, 0.14);
  border: 1px solid var(--color-border-soft);
  font-family: var(--font-meta);
  font-size: 12px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.user-css table td,
.user-css .table td {
  padding: 11px 14px;
  border: 1px solid rgba(179, 116, 77, 0.28);
  vertical-align: top;
}

.user-css table tr:nth-child(even) td,
.user-css .table tr:nth-child(even) td {
  background: rgba(217, 167, 111, 0.035);
}

.user-css table tr:hover td,
.user-css .table tr:hover td {
  background: rgba(217, 167, 111, 0.075);
}

/* QUOTES */

.user-css blockquote,
.user-css-presentation .tooltipster-content blockquote {
  position: relative;
  display: block;
  width: min(100%, 1200px);
  max-width: 1200px;
  box-sizing: border-box;
  margin: 1.25em auto;
  padding: 24px 34px 20px;
  color: var(--color-link-light);
  background: var(--color-background-gradient);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-large);
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.38), inset 0 0 26px rgba(217, 167, 111, 0.035);
  font-family: var(--font-quote);
  font-size: clamp(22px, 2.2vw, 32px);
  line-height: 1.35;
  text-align: center;
  animation: floatQuote 6s ease-in-out infinite;
}

.user-css blockquote::before {
  content: "";
  position: absolute;
  inset: 8px;
  pointer-events: none;
  border: 1px solid rgba(217, 167, 111, 0.18);
  border-radius: calc(var(--radius-large) - 6px);
}

.user-css blockquote a {
  color: var(--color-accent);
  font-family: var(--font-quote);
}

.user-css blockquote .author {
  display: block;
  margin-top: 1em;
  color: var(--color-muted);
  font-family: var(--font-meta);
  font-size: 12px;
  font-style: normal;
  letter-spacing: 0.06em;
  text-align: right;
  text-transform: uppercase;
}

.user-css blockquote .author a {
  font-family: var(--font-meta);
  font-size: inherit;
}

/* PANELS, SIDEBARS, AND CARDS */

.user-css div.panel,
.user-css .panel,
.user-css .well,
.user-css .card,
.user-css .list-group-item {
  color: var(--color-text);
  background: var(--color-panel);
  border: 1px solid var(--color-border-soft);
  border-radius: var(--radius-medium);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
}

.user-css div.panel,
.user-css .panel,
.user-css .well {
  padding: 18px;
}

.user-css .panel-heading,
.user-css .panel-title,
.user-css .card-header {
  color: var(--color-link-light);
  background: rgba(179, 116, 77, 0.1);
  border-bottom: 1px solid var(--color-border-soft);
  font-family: var(--font-header);
}

.user-css div.article-panel {
  margin: 10px 0;
  padding: 16px;
  color: var(--color-text);
  background: var(--color-panel);
  border: 1px solid var(--color-border-soft);
  border-radius: var(--radius-medium);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
  transition: transform 0.25s ease, border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
}

.user-css div.article-panel:hover {
  transform: translateY(-2px);
  background: var(--color-panel-hover);
  border-color: var(--color-border);
  box-shadow: 0 16px 34px rgba(0, 0, 0, 0.36);
}

.user-css .article-panel .details h5,
.user-css .article-panel .details h5 a {
  color: var(--color-link-light);
}

.user-css .article-panel .details .subheading,
.user-css .article-panel .details .subheading .date {
  color: var(--color-muted);
  font-family: var(--font-meta);
  font-size: 12px;
  letter-spacing: 0.04em;
}

.user-css li.map-box.map-item {
  padding: 8px;
  background: var(--color-panel);
  border: 1px solid var(--color-border-soft);
  border-radius: var(--radius-medium);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
}

.user-css .map-box .img-responsive {
  background: rgba(0, 0, 0, 0.24);
}

.user-css li.map-box.map-item div small {
  display: block;
  padding: 8px 4px 2px;
  color: var(--color-link-light);
  font-family: var(--font-header);
  font-size: 24px;
}

/* NUMBER OF FOLLOWERS — FLOATING DRIFTWOOD */

@keyframes followersDriftwoodFloat {
  0% {
    transform: translateY(0) rotate(0deg);
  }

  25% {
    transform: translateY(-3px) rotate(-0.35deg);
  }

  50% {
    transform: translateY(1px) rotate(0.25deg);
  }

  75% {
    transform: translateY(-2px) rotate(-0.2deg);
  }

  100% {
    transform: translateY(0) rotate(0deg);
  }
}


/* Center the counter within its available column. */

.user-css div.followers-counter {
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;

  width: 100% !important;
}


/* The actual Number of Followers panel. */

.user-css div.followers-counter div.panel {
  position: relative !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;

  width: min(380px, 100%) !important;
  aspect-ratio: 476 / 121 !important;
  min-height: 0 !important;

  margin: 14px auto !important;
  padding: 18px 48px 16px !important;

  color: #f2c788 !important;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/74f368526b695bed6b0c6c7ac05ddc07.png) !important;

  background-position: center center !important;
  background-size: 100% 100% !important;
  background-repeat: no-repeat !important;

  border: 0 !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  text-align: center !important;

  filter:
    drop-shadow(0 8px 7px rgba(0, 0, 0, 0.42)) !important;

  transform-origin: center center !important;

  animation:
    followersDriftwoodFloat 5.2s ease-in-out infinite !important;
}


/* Neutralize World Anvil's inner panel styling. */

.user-css div.followers-counter div.panel .panel-body,
.user-css div.followers-counter div.panel .panel-heading,
.user-css div.followers-counter div.panel .panel-title {
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;

  box-sizing: border-box !important;

  width: 100% !important;
  height: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  color: #f2c788 !important;

  background: transparent !important;

  border: 0 !important;
  border-radius: 0 !important;

  box-shadow: none !important;

  text-align: center !important;
}


/* FOLLOWER COUNTER TEXT — HIGH-CONTRAST WOOD SIGN */

.user-css div.followers-counter div.panel h1,
.user-css div.followers-counter div.panel h2,
.user-css div.followers-counter div.panel h3,
.user-css div.followers-counter div.panel h4,
.user-css div.followers-counter div.panel h5,
.user-css div.followers-counter div.panel p,
.user-css div.followers-counter div.panel span,
.user-css div.followers-counter div.panel strong,
.user-css div.followers-counter div.panel b,
.user-css div.followers-counter div.panel a {
  margin: 0 !important;
  padding: 0 !important;

  color: #ffe1a9 !important;
  -webkit-text-fill-color: #ffe1a9 !important;

  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;

  font-family: var(--font-header) !important;
  font-size: clamp(23px, 2.5vw, 31px) !important;
  font-weight: 400 !important;
  line-height: 1.05 !important;

  text-align: center !important;
  text-decoration: none !important;

  -webkit-text-stroke: 0.35px #210c04 !important;
  paint-order: stroke fill !important;

  text-shadow:
    0 1px 0 #321308,
    0 2px 2px rgba(0, 0, 0, 0.88),
    0 0 5px rgba(0, 0, 0, 0.58) !important;
}


/* Make the number slightly brighter without creating a heavy outline. */

.user-css div.followers-counter div.panel strong,
.user-css div.followers-counter div.panel b {
  color: #fff0c9 !important;
  -webkit-text-fill-color: #fff0c9 !important;

  font-size: clamp(27px, 3vw, 37px) !important;

  -webkit-text-stroke: 0.4px #210c04 !important;

  text-shadow:
    0 1px 0 #321308,
    0 2px 2px rgba(0, 0, 0, 0.9),
    0 0 6px rgba(0, 0, 0, 0.62) !important;
}

/* Make the actual follower number prominent. */

.user-css div.followers-counter div.panel strong,
.user-css div.followers-counter div.panel b {
  font-size: clamp(25px, 3vw, 36px) !important;
}


/* Keep individual follower cards using the normal theme panel. */

.user-css.page-followers .follower-box {
  color: var(--color-text);

  background: var(--color-panel);

  border: 1px solid var(--color-border-soft);
  border-radius: var(--radius-medium);

  box-shadow:
    0 10px 24px rgba(0, 0, 0, 0.3);
}


/* Mobile */

@media only screen and (max-width: 500px) {
  .user-css div.followers-counter div.panel {
    width: min(330px, 100%) !important;
    padding: 14px 38px 13px !important;
  }
}


/* Accessibility */

@media (prefers-reduced-motion: reduce) {
  .user-css div.followers-counter div.panel {
    animation: none !important;
  }
}
/* HOMEPAGE ARTICLE LISTS */

.user-css .world-recent-articles,
.user-css .world-featured-articles {
  box-sizing: border-box;
  width: 100% !important;
  max-width: 100% !important;
  flex: 0 0 100% !important;
  padding: 0;
}

.user-css .world-recent-articles ul.article-list,
.user-css .world-featured-articles ul.article-list {
  display: block;
  width: 100%;
  max-height: none;
  margin: 0;
  padding: 8px 4px;
  overflow: visible;
  list-style: none;
  scrollbar-width: none;
}

.user-css .world-recent-articles ul.article-list > li,
.user-css .world-featured-articles ul.article-list > li {
  display: block !important;
  float: none !important;
  width: 100% !important;
  max-width: 100% !important;
  margin: 0 0 12px;
}

.user-css .world-recent-articles .article-panel,
.user-css .world-featured-articles .article-panel {
  box-sizing: border-box;
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 18px 20px;
}

.user-css .world-recent-articles ul.article-list::-webkit-scrollbar,
.user-css .world-featured-articles ul.article-list::-webkit-scrollbar {
  display: none;
}

/* SEARCH BAR */

.user-css .search-form {
  position: relative !important;
  display: block !important;

  box-sizing: border-box !important;

  width: 381px !important;
  max-width: 100% !important;
  height: 208px !important;

  margin: 10px 0 !important;
  padding: 0 !important;

  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}


/* Complete frame image */

.user-css .search-form .form-group {
  position: relative !important;
  display: block !important;

  box-sizing: border-box !important;

  width: 381px !important;
  max-width: 100% !important;
  height: 208px !important;

  margin: 0 !important;
  padding: 0 !important;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/2be2c7b9b82ff8f108b88ea82210be46.png) !important;

  background-position: center center !important;
  background-size: 100% 100% !important;
  background-repeat: no-repeat !important;

  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;

  overflow: visible !important;
}


/* Neutralize a Typeahead wrapper if one appears */

.user-css .search-form .twitter-typeahead {
  position: static !important;
  display: block !important;

  box-sizing: border-box !important;

  width: 100% !important;
  max-width: 100% !important;
  height: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}


/* Hide Typeahead's visual duplicate, if present */

.user-css .search-form .tt-hint {
  display: none !important;
  visibility: hidden !important;

  width: 0 !important;
  height: 0 !important;

  opacity: 0 !important;
  pointer-events: none !important;
}


/* Visible input */
/*
  The solid-black opening in the image is:
  x: 39–340
  y: 66–142
*/

.user-css .search-form .form-group .typeahead-input {
  position: absolute !important;

  top: 31.7308% !important;
  left: 10.2362% !important;

  z-index: 2 !important;

  display: block !important;

  box-sizing: border-box !important;

  width: 79.2651% !important;
  min-width: 0 !important;
  max-width: none !important;

  height: 37.0192% !important;
  min-height: 0 !important;
  max-height: none !important;

  margin: 0 !important;
  padding: 0 14px !important;

  color: #f2c788 !important;
  -webkit-text-fill-color: #f2c788 !important;
  caret-color: #f2c788 !important;

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 0 !important;
  border-radius: 0 !important;
  outline: 0 !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  font-family: var(--font-header) !important;
  font-size: 21px !important;
  font-style: normal !important;
  font-weight: 400 !important;
  line-height: normal !important;

  appearance: none !important;
  -webkit-appearance: none !important;

  opacity: 1 !important;
  transform: none !important;
}


/* Placeholder */

.user-css .search-form .form-group .typeahead-input::placeholder {
  color: #f2c788 !important;
  -webkit-text-fill-color: #f2c788 !important;

  opacity: 0.76 !important;
}


/* Focus */

.user-css .search-form .form-group .typeahead-input:focus {
  color: #ffe1a9 !important;
  -webkit-text-fill-color: #ffe1a9 !important;
  caret-color: #ffe1a9 !important;

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 0 !important;
  outline: 0 !important;

  box-shadow: none !important;
  -webkit-box-shadow: none !important;

  transform: none !important;
}


/* Browser autofill */

.user-css .search-form .typeahead-input:-webkit-autofill,
.user-css .search-form .typeahead-input:-webkit-autofill:hover,
.user-css .search-form .typeahead-input:-webkit-autofill:focus {
  -webkit-text-fill-color: #f2c788 !important;
  caret-color: #f2c788 !important;

  box-shadow:
    0 0 0 1000px #020304 inset !important;

  -webkit-box-shadow:
    0 0 0 1000px #020304 inset !important;

  transition:
    background-color 9999s ease-out 0s !important;
}


/* Autocomplete menu */

.user-css .search-form .typeahead.dropdown-menu {
  z-index: 100 !important;

  box-sizing: border-box !important;

  color: var(--color-text) !important;
  background: rgba(4, 9, 15, 0.98) !important;

  border: 1px solid var(--color-border) !important;
  border-radius: var(--radius-small) !important;

  box-shadow:
    0 18px 36px rgba(0, 0, 0, 0.52) !important;
}

.user-css .search-form .typeahead .dropdown-item {
  color: var(--color-text) !important;
  background: transparent !important;
}

.user-css .search-form .typeahead .dropdown-item:hover,
.user-css .search-form .typeahead .active {
  color: var(--color-link-light) !important;
  background: rgba(179, 116, 77, 0.16) !important;
}


/* Mobile */

@media only screen and (max-width: 420px) {
  .user-css .search-form {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 381 / 208 !important;
  }

  .user-css .search-form .form-group {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 381 / 208 !important;
  }

  .user-css .search-form .form-group .typeahead-input {
    padding-inline: 10px !important;
    font-size: 18px !important;
  }
}

/* SPINNING COMPASS NAVIGATION */

.user-css-presentation .world-navigation-palette-trigger,
.user-css-presentation .world-navigation-palette-trigger-inactive,
.user-css-presentation .world-navigation-palette-trigger-active {
  display: inline-block;
  cursor: pointer;
  color: transparent !important;
  background: none !important;
  border: none !important;
  box-shadow: none !important;
}

.user-css-presentation .world-navigation-palette-trigger .fa-list,
.user-css-presentation .world-navigation-palette-trigger-inactive .fa-list,
.user-css-presentation .world-navigation-palette-trigger-active .fa-list {
  content: url(https://www.worldanvil.com/i/6982203/render);
  position: absolute;
  top: 40px;
  display: inline-block;
  width: 150px;
  height: auto;
  color: transparent !important;
  font-size: 0;
  transform-origin: center center;
  transition: filter 0.3s ease;
  animation: compassSpin 20s linear infinite;
}

.user-css-presentation .world-navigation-palette-trigger:hover .fa-list,
.user-css-presentation .world-navigation-palette-trigger-inactive:hover .fa-list,
.user-css-presentation .world-navigation-palette-trigger-active:hover .fa-list {
  animation: compassSpinFast 2s linear infinite;
  filter:
    drop-shadow(0 0 10px rgba(139, 69, 19, 0.4))
    drop-shadow(0 0 10px rgba(205, 127, 50, 0.3))
    drop-shadow(0 0 60px rgba(233, 170, 92, 0.5));
}

.user-css-presentation #world-navigation-sidebar {
  position: fixed;
  left: 150px;
  z-index: 1500;
  width: clamp(200px, 20%, 250px);
  max-width: 250px;
  max-height: 40vh;
  overflow-y: auto;
  padding: 10px;
  color: var(--color-text);
  text-align: center;
  background: var(--color-background-gradient);
  border: 2px solid var(--color-border);
  border-top: 5px double var(--color-muted);
  border-radius: 15px;
  box-shadow: inset 0 0 10px var(--color-muted), 12px 14px 30px rgba(0, 0, 0, 0.5);
  scrollbar-color: var(--color-muted) var(--color-background);
}

.user-css-presentation #world-navigation-sidebar a {
  color: var(--color-link);
}

.user-css-presentation #world-navigation-sidebar a:hover {
  color: var(--color-accent);
}

.user-css-presentation #world-navigation-sidebar .map-box,
.user-css-presentation #world-navigation-sidebar .maps-list-header {
  display: none;
}

.user-css .world-meta-categories-link,
.user-css .world-menu,
.user-css .world-toc-header,
.user-css.page.sidebar-panel-open .world-timelines {
  display: none;
}

.user-css .world-navigation-custom-content h2 {
  margin: 0 0 10px;
  padding-bottom: 6px;
  font-family: var(--font-header);
  font-size: clamp(24px, 4vw, 40px);
  text-align: center;
  background: var(--color-header);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  border-bottom: 3px double var(--color-border);
}

.user-css .world-navigation-custom-content a {
  display: block;
  margin-bottom: 5px;
  color: var(--color-link);
  font-family: var(--font-body);
  font-size: clamp(14px, 4vw, 20px);
  font-weight: 400;
  line-height: 1.9;
  text-decoration: none;
  transition: color 0.3s ease, transform 0.3s ease;
}

.user-css .world-navigation-custom-content a:hover {
  color: var(--color-accent);
  text-decoration: underline;
  transform: scale(1.05);
}

/* BACK TO WORLD */


.user-css .backtoworld {
  display: inline-block;
  margin: 12px 0;
}

.user-css .backtoworld a {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;
  min-height: 82px;

  margin: 0;
  padding: 8px 28px;

  color: #f2c788 !important;
  background: transparent !important;

  border-style: solid !important;
  border-color: transparent !important;
  border-width: 18px 26px 24px !important;

  border-image-source:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/8df9c2b84639b274ed7d04d5f4baf076.png) !important;

  border-image-slice: 38 40 47 40 fill !important;
  border-image-width: 18px 26px 24px !important;
  border-image-outset: 0 !important;
  border-image-repeat: stretch !important;

  border-radius: 0 !important;
  box-shadow: none !important;

  font-family: var(--font-header);
  font-size: clamp(22px, 2.5vw, 31px);
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: 0.03em;

  text-align: center;
  text-decoration: none !important;

  text-shadow:
    0 2px 2px rgba(36, 15, 5, 0.95),
    0 0 4px rgba(0, 0, 0, 0.65);

  transform: none !important;

  transition:
    color 0.3s ease,
    filter 0.3s ease !important;
}

.user-css .backtoworld a {
  -webkit-text-stroke: 4px #000;
  paint-order: stroke fill;

  text-shadow:
    -1px -1px 0 #000,
     1px -1px 0 #000,
    -1px  1px 0 #000,
     1px  1px 0 #000,
     0 2px 3px rgba(0, 0, 0, 0.9);
}


.user-css .backtoworld a::before,
.user-css .backtoworld a::after {
  content: none !important;
  display: none !important;
}

/* Hover */

.user-css .backtoworld a:hover {
  color: #ffe1a9 !important;

  background: transparent !important;
  box-shadow: none !important;
  transform: none !important;

  filter:
    brightness(1.08)
    drop-shadow(0 5px 7px rgba(0, 0, 0, 0.42));
}

@media only screen and (max-width: 600px) {
  .user-css .backtoworld a {
    min-height: 70px;

    padding: 6px 18px;

    border-width: 15px 21px 20px !important;
    border-image-width: 15px 21px 20px !important;

    font-size: 22px;
  }
}


/* SPOILERS */

.user-css a.btn.btn-sm.btn-primary.spoiler-button,
.user-css a.btn.btn-sm.btn-primary.spoiler-button.collapsed {
  width: 100%;
  height: auto;
  margin: 0;
  padding: 10px 14px;
  white-space: normal;
  color: var(--color-link-light) !important;
  background: var(--color-panel);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-small) var(--radius-small) 0 0;
  box-shadow: none;
  font-family: var(--font-header);
  font-size: 24px;
  text-shadow: none;
}

.user-css a.btn.btn-sm.btn-primary.spoiler-button:hover,
.user-css a.btn.btn-sm.btn-primary.spoiler-button.collapsed:hover {
  background: var(--color-panel-hover);
  color: #ffe2bf !important;
}

.user-css div.well.spoiler-content {
  width: 100%;
  height: auto;
  margin: 0;
  padding: 18px;
  color: var(--color-text) !important;
  background: rgba(4, 9, 15, 0.82);
  border: 1px solid var(--color-border);
  border-top: 0;
  border-radius: 0 0 var(--radius-small) var(--radius-small);
  box-shadow: 0 12px 26px rgba(0, 0, 0, 0.26);
  font-family: var(--font-body);
  font-size: 17px;
}

/* BUTTONS, TAGS, AND LABELS */

.user-css .btn,
.user-css-extended .btn,
.user-css button,
.user-css input[type="button"],
.user-css input[type="submit"] {
  color: var(--color-link-light) !important;
  background: rgba(4, 9, 15, 0.92) !important;
  border: 1px solid var(--color-border) !important;
  border-radius: var(--radius-small) !important;
  font-family: var(--font-meta) !important;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.24);
  transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
}

.user-css .btn:hover,
.user-css-extended .btn:hover,
.user-css button:hover,
.user-css input[type="button"]:hover,
.user-css input[type="submit"]:hover {
  color: #ffe2bf !important;
  background: rgba(143, 79, 45, 0.42) !important;
  transform: translateY(-1px);
  box-shadow: 0 9px 20px rgba(0, 0, 0, 0.32);
}

.user-css a.tag,
.user-css-extended a.tag,
.user-css .label,
.user-css .badge {
  display: inline-block;
  margin: 2px;
  padding: 4px 8px;
  color: var(--color-link-light) !important;
  background: rgba(179, 116, 77, 0.14) !important;
  border: 1px solid var(--color-border-soft);
  border-radius: 999px;
  font-family: var(--font-meta);
  font-size: 11px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  opacity: 0.86;
}



.user-css a.tag:hover,
.user-css-extended a.tag:hover {
  color: #ffe2bf !important;
  border-color: var(--color-border);
  opacity: 1;
}

/* TABS, METADATA, AND COMMENTS */

.user-css-extended .nav-tabs {
  border-bottom: 1px solid var(--color-border-soft);
}

.user-css-extended .nav-tabs a,
.user-css-extended .nav-tabs .active a,
.user-css-extended .nav-tabs .active a:focus,
.user-css-extended .nav-tabs .active a:hover {
  margin: 4px 4px 0 0;
  color: var(--color-link-light);
  background: var(--color-panel);
  border: 1px solid var(--color-border-soft);
  border-radius: var(--radius-small) var(--radius-small) 0 0;
  box-shadow: none;
  font-family: var(--font-meta);
  font-size: 12px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.user-css-extended .nav-tabs a:hover,
.user-css-extended .nav-tabs .active a {
  color: #ffe2bf;
  background: var(--color-panel-hover);
  border-color: var(--color-border);
}

.user-css-extended .tab-content .col-md-12 .row,
.user-css-extended .comment-box,
.user-css-extended .form-control {
  margin: 8px 0;
  padding: 16px;
  color: var(--color-text);
  background: var(--color-panel);
  border: 1px solid var(--color-border-soft);
  border-radius: var(--radius-medium);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24);
  font-family: var(--font-body);
}

.user-css-extended h2 {
  color: var(--color-accent);
}

/* WHITE LABEL MARK */

.user-css-presentation .widget-white-label-mark {
  position: fixed !important;
  left: 0 !important;
  right: auto !important;
  bottom: 8px !important;
  z-index: 2000;

  display: inline-flex !important;
  align-items: center;
  gap: 6px;

  width: auto !important;
  min-width: 0 !important;
  max-width: max-content !important;
  height: auto !important;

  margin: 0 !important;
  padding: 4px 8px !important;

  color: var(--color-muted) !important;
  background: rgba(4, 9, 15, 0.88);
  border: 1px solid var(--color-border-soft);
  border-left: 0;
  border-radius: 0 var(--radius-small) var(--radius-small) 0;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.42);
  font-family: var(--font-meta) !important;
  white-space: nowrap;
  overflow: hidden;
}

.user-css-presentation .widget-white-label-mark > *,
.user-css-presentation .widget-white-label-mark a {
  display: inline-block !important;
  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

.user-css-presentation .widget-white-label-mark a {
  color: var(--color-link) !important;
  font-family: var(--font-meta) !important;
  font-size: 10px;
  line-height: 1.2;
}

/* TOOLTIPS AND ABBREVIATIONS */

.user-css .tooltip.top .tooltip-arrow,
.user-css-extended .tooltip.top .tooltip-arrow,
.user-css-worldmenu .tooltip.top .tooltip-arrow {
  border-top-color: var(--color-border);
}

.user-css .tooltip.bottom .tooltip-arrow,
.user-css-extended .tooltip.bottom .tooltip-arrow,
.user-css-worldmenu .tooltip.bottom .tooltip-arrow {
  border-bottom-color: var(--color-border);
}

.user-css .tooltip.left .tooltip-arrow,
.user-css-extended .tooltip.left .tooltip-arrow,
.user-css-worldmenu .tooltip.left .tooltip-arrow {
  border-left-color: var(--color-border);
}

.user-css .tooltip.right .tooltip-arrow,
.user-css-extended .tooltip.right .tooltip-arrow,
.user-css-worldmenu .tooltip.right .tooltip-arrow {
  border-right-color: var(--color-border);
}

.user-css .tooltip .tooltip-inner,
.user-css-extended .tooltip .tooltip-inner,
.user-css-worldmenu .tooltip .tooltip-inner,
.user-css-presentation .tooltipster-box {
  color: var(--color-text) !important;
  background: rgba(4, 9, 15, 0.98) !important;
  border: 1px solid var(--color-border) !important;
  border-radius: var(--radius-small);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.45;
}

.user-css-presentation .tooltipster-content {
  color: var(--color-text) !important;
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.45;
}

.user-css .text-abbreviation {
  padding: 0 3px;
  color: var(--color-link-light);
  background: rgba(179, 116, 77, 0.12);
  border: 1px dotted var(--color-border);
}

/* DOCUMENT AND DISCUSSION UI */

.user-css .read-document-data-main,
.user-css .discussion-board-section,
.user-css .discussion-board-wrap,
.user-css .world-menu-subcategory {
  color: var(--color-text);
  background: var(--color-panel);
  border: 1px solid var(--color-border-soft);
  border-radius: var(--radius-medium);
  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.28);
}

.user-css .read-document-data-main,
.user-css .discussion-board-section,
.user-css .discussion-board-wrap,
.user-css .world-menu-subcategory {
  padding: 18px;
}

.user-css .discussion-board-section {
  font-family: var(--font-body);
  font-size: 17px;
}

.user-css .statblock {
  border: 0;
}

/* MAP PAGE */

.map-context-user-css {
  background-image:
    linear-gradient(rgba(2, 5, 9, 0.68), rgba(2, 5, 9, 0.84)),
    var(--outer-background-image);
  background-position: center;
  background-size: cover;
  background-attachment: fixed;
}

.user-css-map-sidebar {
  position: fixed;
  z-index: 1000 !important;
  width: min(420px, 90vw);
  max-width: 420px !important;
  padding: 34px 28px;
  color: var(--color-text);
  background: var(--color-background-gradient);
  border-right: 1px solid var(--color-border);
  box-shadow: 18px 0 42px rgba(0, 0, 0, 0.6);
  transition: transform 0.45s ease;
}

.user-css-map-sidebar hr {
  border-color: var(--color-border-soft);
}

.user-css-map-sidebar h3.world-world,
.user-css-map-sidebar h1.map-title {
  color: var(--color-accent);
  font-family: var(--font-header);
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.72);
}

.user-css-map-sidebar h3.world-world {
  font-size: 34px;
}

.user-css-map-sidebar h1.map-title {
  font-size: 48px;
}

/* SCROLLBARS */
.user-css-presentation,
.presentation-interface {
  scrollbar-width: auto;
  scrollbar-color: var(--color-accent-deep) var(--color-background-deep);
}

.user-css-presentation::-webkit-scrollbar,
.presentation-interface::-webkit-scrollbar {
  width: 12px;
  height: 12px;
}

.user-css-presentation::-webkit-scrollbar-track,
.presentation-interface::-webkit-scrollbar-track {
  background: var(--color-background-deep);
}

.user-css-presentation::-webkit-scrollbar-thumb,
.presentation-interface::-webkit-scrollbar-thumb {
  background: var(--color-accent-deep);
  border: 2px solid var(--color-background-deep);
  border-radius: 999px;
}

.user-css-presentation::-webkit-scrollbar-thumb:hover,
.presentation-interface::-webkit-scrollbar-thumb:hover {
  background: var(--color-border);
}

.user-css.page::-webkit-scrollbar,
.user-css-presentation .page::-webkit-scrollbar,
.user-css-presentation div#world-navigation-sidebar::-webkit-scrollbar,
.extendedbody-comments::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

.user-css.page::-webkit-scrollbar-track,
.user-css-presentation .page::-webkit-scrollbar-track,
.user-css-presentation div#world-navigation-sidebar::-webkit-scrollbar-track,
.extendedbody-comments::-webkit-scrollbar-track {
  background: var(--color-background-deep);
}

.user-css.page::-webkit-scrollbar-thumb,
.user-css-presentation .page::-webkit-scrollbar-thumb,
.user-css-presentation div#world-navigation-sidebar::-webkit-scrollbar-thumb,
.extendedbody-comments::-webkit-scrollbar-thumb {
  background: var(--color-accent-deep);
  border: 2px solid var(--color-background-deep);
  border-radius: 999px;
}

.user-css.page::-webkit-scrollbar-thumb:hover,
.user-css-presentation .page::-webkit-scrollbar-thumb:hover,
.user-css-presentation div#world-navigation-sidebar::-webkit-scrollbar-thumb:hover,
.extendedbody-comments::-webkit-scrollbar-thumb:hover {
  background: var(--color-border);
}

/* GENERAL COMPATIBILITY */

.user-css .timelines-list-header {
  display: none;
}

.user-css.page-followers .nav-strip {
  color: var(--color-text);
  background: transparent;
  border: 0;
  box-shadow: none;
  font-family: var(--font-header);
}

.user-css .dropdown-menu,
.user-css-extended .dropdown-menu {
  color: var(--color-text);
  background: rgba(4, 9, 15, 0.98);
  border: 1px solid var(--color-border-soft);
}

.user-css .dropdown-menu > li > a,
.user-css-extended .dropdown-menu > li > a {
  color: var(--color-text);
}

.user-css .dropdown-menu > li > a:hover,
.user-css-extended .dropdown-menu > li > a:hover {
  color: var(--color-link-light);
  background: rgba(179, 116, 77, 0.14);
}

/* RESPONSIVE LAYOUT */

@media only screen and (max-width: 768px) {
  .user-css-presentation,
  .presentation-interface {
    background-attachment: scroll;
    background-position: center top;
    background-size: auto 100vh;
  }

  .user-css-presentation .world-global-header {
    min-height: 72px;
    padding: 10px 14px;
  }

  .user-css.page,
  .user-css-extended .page {
    width: calc(100% - 16px);
    margin: 12px auto 28px;
    padding: 24px 18px 34px;
    border-radius: var(--radius-medium);
    font-size: 17px;
    line-height: 1.62;
  }

  .user-css .article-content-left,
  .user-css .article-content-left.col-md-8,
  .user-css .article-content-right,
  .user-css .article-content-right.col-md-4 {
    float: none;
    width: 100% !important;
    max-width: 100% !important;
    flex: 0 0 100% !important;
    padding-left: 0;
    padding-right: 0;
  }

  .user-css .heading h1,
  .user-css .world-title {
    font-size: clamp(38px, 12vw, 64px);
  }

  .user-css .world-subtitle {
    font-size: clamp(30px, 10vw, 52px);
  }

  .user-css h1,
  .user-css-extended h1 {
    font-size: clamp(36px, 11vw, 58px);
  }

  .user-css h2,
  .user-css-extended h2 {
    font-size: clamp(31px, 9vw, 46px);
  }

  .user-css h3,
  .user-css-extended h3 {
    font-size: clamp(27px, 8vw, 38px);
  }

  .user-css h4,
  .user-css-extended h4 {
    font-size: clamp(23px, 7vw, 32px);
  }

  .user-css h5,
  .user-css-extended h5 {
    font-size: clamp(20px, 6vw, 28px);
  }

  .user-css .breadbox .breadcrumb,
  .user-css .breadbox .breadcrumb a {
    font-size: 10px;
    line-height: 1.5;
  }

  .user-css blockquote,
  .user-css-presentation .tooltipster-content blockquote {
    margin: 1.2em 0;
    padding: 24px 20px 20px;
    font-size: clamp(24px, 8vw, 34px);
  }

  .user-css .table-responsive {
    border-radius: var(--radius-small);
  }

  .user-css table th,
  .user-css table td,
  .user-css .table th,
  .user-css .table td {
    padding: 9px 10px;
  }

  .user-css-presentation div#world-navigation-sidebar {
    width: 88vw;
    max-width: 88vw;
    padding: 24px 18px;
  }

  .user-css .backtoworld a {
    padding: 8px 14px;
    font-size: 22px;
  }

  .user-css .article-content img,
  .user-css figure img,
  .user-css .img-responsive {
    border-radius: 3px;
  }
}

@media only screen and (max-width: 500px) {
  .user-css.page,
  .user-css-extended .page {
    width: calc(100% - 10px);
    margin-top: 8px;
    padding: 20px 14px 30px;
    font-size: 16px;
  }

  .user-css-presentation .world-navigation-palette-trigger-inactive,
  .user-css-presentation .world-navigation-palette-trigger-active {
    display: block;
  }

  .user-css-presentation .world-navigation-palette-trigger .fa-list,
  .user-css-presentation .world-navigation-palette-trigger-inactive .fa-list,
  .user-css-presentation .world-navigation-palette-trigger-active .fa-list {
    top: 18px;
    width: 90px;
  }

  .user-css-presentation #world-navigation-sidebar {
    left: 90px;
    width: calc(100vw - 105px);
    max-width: calc(100vw - 105px);
    max-height: 62vh;
  }

  .user-css .article-title {
    margin-bottom: 18px;
  }

  .user-css .article-panel,
  .user-css div.panel,
  .user-css .panel,
  .user-css .well {
    padding: 14px;
  }
}

/* GLOBAL IMAGE SIZING */

.user-css img,
.user-css-extended img {
  max-width: 100%;
  height: auto;
  object-fit: contain;
}

.user-css .article-content img.img-responsive.img-fluid,
.user-css .article-content img.max-width-100 {
  max-width: 100%;
  height: auto;
  object-fit: contain;
}

/* CUSTOM CONTAINERS */

/* Readable body copy inside light paper and card surfaces. */

.user-css :is(
  .parchment,
  .bordered-cardbg,
  .border-card,
  .parchment2,
  .side-card,
  .weapon-card,
  .gear-card,
  .spell-card,
  .magic-item-card,
  .background-card
) :is(p, li, td, th, strong, b, em) {
  color: #21170f;
  text-shadow: none;
}

/* PARCHMENT CONTAINER */

.user-css .parchment {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: none;
  background: linear-gradient(145deg, #b8a089 0%, #c9b89e 15%, #d4c4a8 30%, #c9b598 50%, #bda888 70%, #b09878 85%, #a68d6a 100%);
  color: #1a1410;
  font-family: var(--font-body);
  font-size: clamp(16px, 1.25vw, 21px);
  line-height: 1.72;
  padding: clamp(30px, 3.5vw, 52px);
  margin: 24px 0 34px;
  border: 3px solid var(--color-border);
  border-radius: 2px;
  box-shadow: 0 0 0 6px var(--color-background), 0 0 0 8px rgba(180, 116, 77, 0.4), inset 0 0 60px rgba(80, 55, 30, 0.12), 0 8px 30px rgba(0, 0, 0, 0.6);
}

.user-css .parchment::before {
  content: "";
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(60, 40, 20, 0.2);
  border-radius: 0;
  pointer-events: none;
}

.user-css .parchment::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  border-radius: 2px;
  background:
    radial-gradient(ellipse at 8% 8%, rgba(60, 40, 20, 0.18), transparent 34%),
    radial-gradient(ellipse at 92% 90%, rgba(60, 40, 20, 0.19), transparent 34%),
    radial-gradient(ellipse at 72% 16%, rgba(90, 65, 35, 0.10), transparent 42%),
    radial-gradient(circle at 22% 24%, rgba(100, 70, 40, 0.11), transparent 4%),
    radial-gradient(circle at 78% 69%, rgba(95, 65, 40, 0.10), transparent 5%),
    linear-gradient(to right, rgba(50, 35, 20, 0.09), transparent 6%, transparent 94%, rgba(50, 35, 20, 0.09)),
    linear-gradient(to bottom, rgba(50, 35, 20, 0.07), transparent 8%, transparent 92%, rgba(50, 35, 20, 0.11));
  mix-blend-mode: multiply;
}

/* BORDERED CARD BACKGROUND */

.user-css .bordered-cardbg {
  position: relative;
  box-sizing: border-box;
   background:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/6a60fda871f1b00a448ea3c8b76e33ea.png)
    center center / 100% 100% no-repeat;
  color: #1a1410;
  font-family: var(--font-body);
  font-size: clamp(16px, 1.4vw, 22px);
  line-height: 1.8;
  padding: 40px 50px;
  margin: 30px auto;
  max-width: 90%;
  border: 3px solid var(--color-border);
  border-radius: 2px;
  box-shadow: 0 0 0 6px var(--color-background), 0 0 0 8px rgba(180, 116, 77, 0.4), inset 0 0 60px rgba(80, 55, 30, 0.12), 0 8px 30px rgba(0, 0, 0, 0.6);
}

.user-css .bordered-cardbg::before {
  content: "";
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(60, 40, 20, 0.2);
  border-radius: 0;
  pointer-events: none;
}

.user-css .bordered-cardbg::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  background:
    radial-gradient(ellipse at top left, rgba(60, 40, 20, 0.08), transparent 35%),
    radial-gradient(ellipse at bottom right, rgba(60, 40, 20, 0.10), transparent 38%);
  pointer-events: none;
  border-radius: 2px;
  mix-blend-mode: multiply;
}

.user-css .bordered-cardbg > * {
  position: relative;
  z-index: 1;
}

/* PARCHMENT PORTRAIT CARD */

.user-css .parchment2 {
  position: relative;
  box-sizing: border-box;

  width: min(420px, 94%);
  min-height: 620px;

  margin: 30px auto;
  padding: 66px 44px 72px;

  background:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/d9e3d8a4e1de6866815979dee58f29e6.png)
    center center / 100% 100% no-repeat;

  color: #1a1410;
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.42;

  border: none;
  border-radius: 3px;

  box-shadow:
    0 8px 26px rgba(0, 0, 0, .55);

  overflow: hidden;
  overflow-wrap: break-word;
  hyphens: auto;
}

.user-css .parchment2 > * {
  position: relative;
  z-index: 2;
}

.user-css .parchment2 h5 {
  margin: 0 0 5px;
  padding: 0;

  color: #21150f;
  font-family: var(--font-title);
  font-size: 1.65em;
  line-height: 1.08;
  text-align: left;
}

.user-css .parchment2 .item-meta {
  margin: 0 0 12px;
  padding: 0;

  font-size: .94em;
  line-height: 1.3;
  font-style: italic;
  text-align: left;
}

.user-css .parchment2 .item-meta .text-left,
.user-css .parchment2 .item-meta p {
  margin: 0;
  padding: 0;
  text-align: left;
}

.user-css .parchment2 .item-introduction {
  margin: 0 0 12px;
  padding: 0;

  line-height: 1.42;
}

.user-css .parchment2 p {
  margin: 0 0 9px;
  padding: 0;
}

.user-css .parchment2 strong,
.user-css .parchment2 b {
  color: #2b1710;
  font-weight: 700;
}

.user-css .parchment2 p:last-child,
.user-css .parchment2 > *:last-child {
  margin-bottom: 0;
}

.user-css .parchment2::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;

  pointer-events: none;

  background:
    radial-gradient(
      ellipse at top left,
      rgba(60, 40, 20, .08),
      transparent 35%
    ),
    radial-gradient(
      ellipse at bottom right,
      rgba(60, 40, 20, .10),
      transparent 38%
    );

  mix-blend-mode: multiply;
}

@media screen and (max-width: 500px) {
  .user-css .parchment2 {
    width: 96%;
    padding: 58px 34px 64px;

    font-size: 13px;
    line-height: 1.4;
  }

  .user-css .parchment2 h5 {
    font-size: 1.5em;
  }
}

/* BORDER CARD */

.user-css .border-card {
  position: relative;
  box-sizing: border-box;

  background:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/6a60fda871f1b00a448ea3c8b76e33ea.png)
    center center / 100% 100% no-repeat;

  color: #1a1410;
  font-family: var(--font-body);
  font-size: clamp(15px, 1.15vw, 20px);
  line-height: 1.65;

  width: min(420px, 92%);
  min-height: 620px;

  padding: 72px 58px 78px 58px;
  margin: 30px auto;

  border: none;
  border-radius: 3px;

  box-shadow:
    0 8px 26px rgba(0,0,0,.55);

  overflow: hidden;
}

.user-css .border-card::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;

  background:
    radial-gradient(ellipse at top left, rgba(60,40,20,.08), transparent 35%),
    radial-gradient(ellipse at bottom right, rgba(60,40,20,.10), transparent 38%);

  mix-blend-mode: multiply;
  z-index: 10;
}

/* SIDE CARD */

.user-css .side-card {
    position: relative;
    box-sizing: border-box;

    background: url(https://cdn.midjourney.com/6d154a3f-dbbf-4c0f-a623-e47885010ed8/0_2.png)
                center center / cover no-repeat;

    color: #1a1410;
    font-family: var(--font-body);
    font-size: clamp(15px, 1.2vw, 20px);
    line-height: 1.7;

    width: min(420px, 100%);
    max-width: 420px;
    padding: 48px;
    margin: 30px auto;

    box-shadow:
        0 8px 24px rgba(0,0,0,.45);
    clip-path: polygon(
        1% 2%, 4% 0%, 9% 1%, 15% 0%, 21% 2%, 28% 1%, 36% 0%, 44% 2%, 53% 1%, 61% 0%,
        70% 2%, 79% 1%, 87% 0%, 94% 2%, 99% 1%,
        100% 4%, 99% 12%, 100% 21%, 98% 31%, 100% 43%, 99% 55%, 100% 67%, 98% 79%, 100% 90%, 99% 98%,
        95% 100%, 87% 99%, 77% 100%, 67% 98%, 56% 100%, 45% 99%, 34% 100%, 23% 98%, 12% 100%, 2% 99%,
        0% 95%, 2% 86%, 0% 75%, 1% 64%, 0% 53%, 2% 41%, 0% 29%, 1% 18%, 0% 8%
    );

    overflow: hidden;
}

.user-css .side-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
        radial-gradient(ellipse at top left, rgba(70,45,20,.10), transparent 35%),
        radial-gradient(ellipse at top right, rgba(70,45,20,.08), transparent 35%),
        radial-gradient(ellipse at bottom left, rgba(70,45,20,.08), transparent 35%),
        radial-gradient(ellipse at bottom right, rgba(70,45,20,.12), transparent 35%);
}

