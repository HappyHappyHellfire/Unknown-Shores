  font-family: Cardo, EBGaramond, Garamond, serif !important;
  font-size: 14px !important;
  line-height: 1.2 !important;
  white-space: normal !important;
}

html body .user-css-presentation .world-global-header .social.social::before,
html body .user-css-presentation .world-global-header .social.social::after,
html body .presentation-interface .world-global-header .social.social::before,
html body .presentation-interface .world-global-header .social.social::after {
  content: none !important;
  display: none !important;
}

html body .user-css-presentation .world-global-header .us-social-strip,
html body .presentation-interface .world-global-header .us-social-strip {
  position: static !important;
  inset: auto !important;
  float: none !important;
  transform: none !important;

  display: inline-flex !important;
  flex-flow: row nowrap !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 12px !important;

  box-sizing: border-box !important;
  width: auto !important;
  min-width: 0 !important;
  max-width: calc(100vw - 32px) !important;
  height: auto !important;
  min-height: 0 !important;

  margin: 0 auto !important;
  padding: 10px 14px !important;

  color: #d9a76f !important;
  background:
    linear-gradient(
      180deg,
      rgba(24, 43, 46, 0.98),
      rgba(5, 13, 17, 0.99)
    ) !important;
  border: 1px solid #80502f !important;
  border-radius: 4px !important;
  box-shadow:
    0 8px 18px rgba(0, 0, 0, 0.30),
    inset 0 0 0 3px rgba(179, 116, 77, 0.07) !important;

  font-family: Cardo, EBGaramond, Garamond, serif !important;
  font-size: 14px !important;
  line-height: 1.2 !important;
  white-space: nowrap !important;
}

html body .user-css-presentation .world-global-header .us-social-strip::before,
html body .user-css-presentation .world-global-header .us-social-strip::after,
html body .presentation-interface .world-global-header .us-social-strip::before,
html body .presentation-interface .world-global-header .us-social-strip::after {
  content: none !important;
  display: none !important;
}

html body .user-css-presentation .world-global-header .us-social-copy,
html body .presentation-interface .world-global-header .us-social-copy {
  position: static !important;
  display: block !important;
  flex: 0 0 auto !important;

  box-sizing: border-box !important;
  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;
  height: auto !important;

  margin: 0 6px 0 0 !important;
  padding: 0 !important;

  color: #d9a76f !important;
  -webkit-text-fill-color: #d9a76f !important;
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;

  font-family: Cardo, EBGaramond, Garamond, serif !important;
  font-size: 14px !important;
  font-style: normal !important;
  font-weight: 400 !important;
  letter-spacing: 0 !important;
  line-height: 1.2 !important;
  text-align: left !important;
  text-transform: none !important;
  white-space: nowrap !important;
}

html body .user-css-presentation .world-global-header .us-social-icons,
html body .presentation-interface .world-global-header .us-social-icons {
  position: static !important;
  display: flex !important;
  flex: 0 0 auto !important;
  flex-flow: row nowrap !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 10px !important;

  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;
  height: auto !important;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

html body .user-css-presentation .world-global-header :is(
  .us-social-discord,
  .us-social-twitch,
  .us-social-patreon
),
html body .presentation-interface .world-global-header :is(
  .us-social-discord,
  .us-social-twitch,
  .us-social-patreon
) {
  position: static !important;
  display: flex !important;
  flex: 0 0 38px !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
  width: 38px !important;
  min-width: 38px !important;
  max-width: 38px !important;
  height: 38px !important;
  min-height: 38px !important;
  max-height: 38px !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow: hidden !important;
  background:
    radial-gradient(circle at 38% 30%, #3e575c 0%, #17292d 44%, #071014 100%) !important;
  border: 1px solid #8d5b35 !important;
  border-radius: 50% !important;
  box-shadow:
    inset 0 0 0 3px rgba(3, 8, 10, 0.44),
    0 5px 10px rgba(0, 0, 0, 0.42) !important;
  transform: none !important;
}

html body .user-css-presentation .world-global-header :is(
  .us-social-discord,
  .us-social-twitch,
  .us-social-patreon
) :is(.image-thumb-container, .paragraph-align-center, .text-center, p),
html body .presentation-interface .world-global-header :is(
  .us-social-discord,
  .us-social-twitch,
  .us-social-patreon
) :is(.image-thumb-container, .paragraph-align-center, .text-center, p) {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
  height: 100% !important;
  min-height: 0 !important;
  max-height: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  transform: none !important;
}

html body .user-css-presentation .world-global-header :is(
  .us-social-discord,
  .us-social-twitch,
  .us-social-patreon
) a,
html body .presentation-interface .world-global-header :is(
  .us-social-discord,
  .us-social-twitch,
  .us-social-patreon
) a {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
  height: 100% !important;
  min-height: 0 !important;
  max-height: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow: hidden !important;
  color: #d7a86d !important;
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  font-size: 0 !important;
  line-height: 0 !important;
  text-decoration: none !important;
  transform: none !important;
}

html body .user-css-presentation .world-global-header :is(
  .us-social-discord,
  .us-social-twitch,
  .us-social-patreon
) img,
html body .presentation-interface .world-global-header :is(
  .us-social-discord,
  .us-social-twitch,
  .us-social-patreon
) img {
  position: static !important;
  display: block !important;
  min-width: 0 !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  object-fit: contain !important;
  object-position: center center !important;
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  filter: none !important;
}

html body .user-css-presentation .world-global-header .us-social-discord img,
html body .presentation-interface .world-global-header .us-social-discord img {
  width: 28px !important;
  max-width: 28px !important;
  height: 28px !important;
  max-height: 28px !important;
  transform: none !important;
}

html body .user-css-presentation .world-global-header .us-social-twitch img,
html body .presentation-interface .world-global-header .us-social-twitch img {
  width: 18px !important;
  max-width: 18px !important;
  height: 18px !important;
  max-height: 18px !important;
  transform: none !important;
}

html body .user-css-presentation .world-global-header .us-social-patreon img,
html body .presentation-interface .world-global-header .us-social-patreon img {
  width: 16px !important;
  max-width: 16px !important;
  height: 18px !important;
  max-height: 18px !important;
  transform: translateY(-1px) !important;
}

html body .user-css-presentation .world-global-header .us-social-strip br,
html body .presentation-interface .world-global-header .us-social-strip br {
  display: none !important;
}

@media only screen and (max-width: 760px) {
  html body .user-css-presentation .world-global-header .us-social-strip,
  html body .presentation-interface .world-global-header .us-social-strip {
    flex-wrap: wrap !important;
    width: calc(100vw - 24px) !important;
    max-width: none !important;
  }

  html body .user-css-presentation .world-global-header .us-social-copy,
  html body .presentation-interface .world-global-header .us-social-copy {
    flex: 1 0 100% !important;
    margin-right: 0 !important;
    text-align: center !important;
    white-space: normal !important;
  }
}

/* RACE / SPECIES STAT CARD */

.user-css .race-card {
  position: relative;
  isolation: isolate;
  box-sizing: border-box;

  width: min(920px, 96%);
  min-height: 1235px;

  margin: 30px auto;
  padding: 84px 88px 96px;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/8e60a76449eae43203dde2ac7c45dc5d.png);
  background-position: center center;
  background-size: 100% 100%;
  background-repeat: no-repeat;

  color: #21170f;

  font-family:
    var(--font-body),
    Georgia,
    serif;

  font-size: 15px;
  line-height: 1.46;

  border: none;
  border-radius: 0;

  box-shadow:
    0 8px 24px rgba(0, 0, 0, .45);

  overflow: hidden;
  overflow-wrap: break-word;
  hyphens: auto;
}

.user-css .race-card > * {
  position: relative;
  z-index: 2;
}

.user-css .race-card :is(
  p,
  section,
  li,
  td,
  th,
  span,
  strong,
  b,
  em,
  i
) {
  color: #21170f !important;
  -webkit-text-fill-color: #21170f !important;
  text-shadow: none !important;
  filter: none !important;
}

.user-css .race-card .race-card-title {
  margin: 0 0 8px;
  padding: 0 0 8px;

  color: #6f251c !important;
  -webkit-text-fill-color: #6f251c !important;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-size: clamp(44px, 6vw, 70px);
  font-weight: 700;
  font-variant: small-caps;
  line-height: 1;
  letter-spacing: .025em;
  text-align: left;

  border-bottom: 2px solid #8b4a2f;
}

.user-css .race-card .race-card-flavor {
  margin: 0 0 18px;
  padding: 0;

  font-size: 1em;
  font-style: italic;
  line-height: 1.48;
}

.user-css .race-card .race-card-paragraph {
  margin: 0 0 10px;
  padding: 0;
}

.user-css .race-card .race-card-summary {
  margin: 16px 0 20px;
  padding: 10px 12px;

  background: rgba(122, 67, 36, .08);

  border-top: 2px solid #7b3525;
  border-bottom: 2px solid #7b3525;

  line-height: 1.44;
}

.user-css .race-card .race-card-summary > *:last-child {
  margin-bottom: 0;
}

.user-css .race-card .race-card-columns {
  column-count: 2;
  column-gap: 34px;
  column-rule: 1px solid rgba(111, 37, 28, .28);
}

.user-css .race-card .race-card-section-title {
  margin: 16px 0 6px;
  padding: 0 0 4px;

  color: #6f251c !important;
  -webkit-text-fill-color: #6f251c !important;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-size: 1.48em;
  font-weight: 700;
  font-variant: small-caps;
  line-height: 1.12;
  letter-spacing: .02em;

  border-bottom: 1px solid rgba(111, 37, 28, .65);

  break-after: avoid-column;
  page-break-after: avoid;
}

.user-css .race-card .race-card-section-title:first-child {
  margin-top: 0;
}

.user-css .race-card .race-card-intro {
  margin: 0 0 9px;
  padding: 0;

  font-style: italic;
  line-height: 1.4;

  break-after: avoid-column;
  page-break-after: avoid;
}

.user-css .race-card .race-card-rule {
  position: relative;

  margin: 0 0 9px;
  padding: 0 0 0 1.05em;

  line-height: 1.42;

  break-inside: avoid-column;
  page-break-inside: avoid;
}

.user-css .race-card .race-card-rule::before {
  content: "◆";

  position: absolute;
  top: .12em;
  left: 0;

  color: #6f251c;

  font-size: .64em;
  line-height: 1;
}

.user-css .race-card .race-card-rule strong,
.user-css .race-card .race-card-rule b {
  color: #5f2119 !important;
  -webkit-text-fill-color: #5f2119 !important;
  font-weight: 700;
}

.user-css .race-card .race-card-note {
  margin: 12px 0 0;
  padding: 9px 11px;

  background: rgba(122, 67, 36, .07);
  border-left: 3px solid #7b3525;

  font-size: .94em;
  line-height: 1.42;

  break-inside: avoid-column;
  page-break-inside: avoid;
}

.user-css .race-card a {
  color: #6f251c !important;
  -webkit-text-fill-color: #6f251c !important;
  text-decoration-color: rgba(111, 37, 28, .45);
}

.user-css .race-card a:hover {
  color: #8b2e21 !important;
  -webkit-text-fill-color: #8b2e21 !important;
  text-shadow: none !important;
}

@media screen and (max-width: 760px) {
  .user-css .race-card {
    width: 98%;
    min-height: 0;

    margin: 20px auto;
    padding: 62px 44px 72px;

    font-size: 13px;
    line-height: 1.4;
  }

  .user-css .race-card .race-card-title {
    font-size: clamp(38px, 12vw, 56px);
  }

  .user-css .race-card .race-card-columns {
    column-count: 1;
    column-gap: 0;
    column-rule: none;
  }

  .user-css .race-card .race-card-section-title {
    font-size: 1.4em;
  }
}

@media screen and (max-width: 460px) {
  .user-css .race-card {
    width: 100%;
    padding: 52px 32px 60px;

    font-size: 12px;
  }
}
