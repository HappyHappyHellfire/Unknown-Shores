/* ==============================
   PARCHMENT CONTAINER
============================== */

.user-css .parchment {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: none;
  background: linear-gradient(145deg, #b8a089 0%, #c9b89e 15%, #d4c4a8 30%, #c9b598 50%, #bda888 70%, #b09878 85%, #a68d6a 100%);
  color: #1a1410;
  font-family: var(--font-body);
  font-size: clamp(16px, 1.25vw, 21px);
  line-height: 1.72;
  padding: clamp(30px, 3.5vw, 52px);
  margin: 24px 0 34px;
  border: 3px solid var(--color-border);
  border-radius: 2px;
  box-shadow: 0 0 0 6px var(--color-background), 0 0 0 8px rgba(180, 116, 77, 0.4), inset 0 0 60px rgba(80, 55, 30, 0.12), 0 8px 30px rgba(0, 0, 0, 0.6);
}

.user-css .parchment::before {
  content: '';
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(60, 40, 20, 0.2);
  border-radius: 0;
  pointer-events: none;
}

/* Enhanced ::after with corner shadows + scattered stains */

.user-css .parchment::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    /* Original corner shadows */
    radial-gradient(ellipse at top left, rgba(60, 40, 20, 0.18) 0%, transparent 35%), radial-gradient(ellipse at bottom right, rgba(60, 40, 20, 0.2) 0%, transparent 35%), radial-gradient(ellipse at top right, rgba(60, 40, 20, 0.1) 0%, transparent 30%), radial-gradient(ellipse at bottom left, rgba(60, 40, 20, 0.1) 0%, transparent 30%),
    /* Water stain - large faded ring, upper area */
    radial-gradient(ellipse at 70% 15%, rgba(90, 65, 35, 0.08) 0%, rgba(70, 50, 30, 0.12) 30%, transparent 50%),
    /* Coffee/tea drip stain - irregular blob, mid-right */
    radial-gradient(ellipse at 85% 45%, rgba(80, 50, 25, 0.15) 0%, rgba(60, 40, 20, 0.08) 40%, transparent 55%),
    /* Age spot - small dark blotch, lower left */
    radial-gradient(circle at 15% 75%, rgba(50, 35, 20, 0.2) 0%, transparent 8%),
    /* Foxing spots - scattered small dots */
    radial-gradient(circle at 25% 20%, rgba(100, 70, 40, 0.12) 0%, transparent 4%), radial-gradient(circle at 60% 80%, rgba(90, 60, 35, 0.1) 0%, transparent 5%), radial-gradient(circle at 40% 55%, rgba(85, 55, 30, 0.08) 0%, transparent 3%), radial-gradient(circle at 80% 70%, rgba(95, 65, 40, 0.1) 0%, transparent 4%), radial-gradient(circle at 10% 40%, rgba(80, 55, 30, 0.09) 0%, transparent 3%),
    /* Larger aged area - subtle discoloration */
    radial-gradient(ellipse at 30% 85%, rgba(70, 50, 30, 0.1) 0%, transparent 25%),
    /* Edge darkening/burn */
    linear-gradient(to right, rgba(50, 35, 20, 0.08) 0%, transparent 5%, transparent 95%, rgba(50, 35, 20, 0.08) 100%), linear-gradient(to bottom, rgba(50, 35, 20, 0.06) 0%, transparent 8%, transparent 92%, rgba(50, 35, 20, 0.1) 100%);
  pointer-events: none;
  border-radius: 2px;
  mix-blend-mode: multiply;
}


