/* HOMEPAGE MEDALLIONS / BOOK COVERS: RESTORED HOVER ANIMATIONS                                     */
/* ================================================================================================ */

@keyframes book-twisterInDown {
  0% {
    opacity: 0;
    transform-origin: 0 100%;
    transform: scale(0) rotate(360deg) translateY(-100%);
  }

  100% {
    opacity: 1;
    transform-origin: 100% 100%;
    transform: scale(1.3) rotate(0deg) translateY(-25px);
  }
}

@keyframes book-twisterInUp {
  0% {
    opacity: 0;
    transform-origin: 100% 0;
    transform: scale(0) rotate(360deg) translateY(100%);
  }

  100% {
    opacity: 1;
    transform-origin: 0 0;
    transform: scale(1.3) rotate(0deg) translateY(-25px);
  }
}

