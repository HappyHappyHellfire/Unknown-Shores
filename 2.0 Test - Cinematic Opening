  0%, 30%, 50%, 80%, 100% {
    opacity: 0;
    transform: translate(-135%, -50%) scale(1.05);
  }
  37% {
    opacity: 0.25;
    transform: translate(-70%, -50%) scale(1.12);
  }
  42% {
    opacity: 0.92;
    transform: translate(-50%, -50%) scale(1.18);
  }
  48% {
    opacity: 0.14;
    transform: translate(45%, -50%) scale(1.1);
  }
  87% {
    opacity: 0.2;
    transform: translate(45%, -50%) scale(1.1);
  }
  92% {
    opacity: 0.92;
    transform: translate(-50%, -50%) scale(1.18);
  }
  98% {
    opacity: 0.12;
    transform: translate(-135%, -50%) scale(1.05);
  }
}

