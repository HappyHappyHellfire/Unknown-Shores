  background: rgba(122, 67, 36, .12);
  color: #64251c;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-weight: 700;
  font-variant: small-caps;
  letter-spacing: .02em;
  text-align: left;
  vertical-align: bottom;
}

.user-css .gear-card table td {
  padding: 6px 8px;

  background: transparent;
  border-bottom: 1px solid rgba(93, 54, 31, .35);

  text-align: left;
  vertical-align: top;
}

.user-css .gear-card table tbody tr:nth-child(odd) td {
  background: rgba(137, 91, 45, .07);
}

.user-css .gear-card table tbody tr:last-child td {
  border-bottom: 2px solid #7b3525;
