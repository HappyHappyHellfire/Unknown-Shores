/* ==============================
     CSS THEME BY IMAGICA (aka Make lore, not war)
     RUINED BY: SOLOMONJACK
============================== */

/* ==============================
   FONTS: EMBEDDED FONT FILES
============================== */

@font-face {
  font-family: Jim Nightshade;
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/jimnightshade/v20/PlIkFlu9Pb08Q8HLM1PxmB0g-NS_XXs.woff2);
}

@font-face {
  font-family: Cardo;
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/cardo/v20/wlp_gwjKBV1pqhv43IE.woff2);
}

@font-face {
  font-family: Island Moments;
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/islandmoments/v7/NaPBcZfVGvBdxIt7Ar0qzkXJF9TBKIk.woff2);
}

@font-face {
  font-family: Montserrat;
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/montserrat/v30/JTUSjIg1_i6t8kCHKm459Wlhyw.woff2);
}

/* ==============================
   ROOT VARIABLES
============================== */

:root {
  /* FONTS */
  --font-header: Jim Nightshade, Georgia, Times New Roman, sans-serif;
  --font-body: Cardo, Garamond, serif;
  --font-quote: Island Moments, cursive;
  --font-meta: Montserrat, Arial, Helvetica, sans-serif;
  --font-text: var(--font-body);
  /* BACKGROUNDS */
  --color-background: #04090F;
  --color-background-gradient: linear-gradient(180deg, rgba(4, 9, 15, 1) 0%, rgba(12, 30, 35, 1) 50%, rgba(9, 42, 47, 1) 100%);
  --color-secondary-bg: #09121A;
  --color-secondary-gradient: linear-gradient(180deg, rgba(9, 18, 26, 1) 0%, rgba(14, 30, 38, 1) 100%);
  /* TEXT */
  --color-text: #E6E1D8;
  --color-muted: #BEB28F;
  /* LINKS & HIGHLIGHTS */
  --color-link: #C68C53;
  --color-link-hover: linear-gradient(45deg, #C68C53, #FFDCC1, #E07B21);
  --color-header: linear-gradient(45deg, #4A2C1A 15%, #A85C32 35%, #D98E5F 55%, #A85C32 75%, #4A2C1A 85%);
  --color-small-header: linear-gradient(45deg, #4A2C1A 0%, #A85C32 10%, #D98E5F 55%, #A85C32 95%, #4A2C1A 100%);
  --color-border: #B3744D;
  --color-shadow: rgba(224, 180, 120, 0.4);
  --color-header-shadow: rgba(0, 0, 0, 0.3) 1px 1px 1px;
  --color-accent: #D9A76F;
  --author-css: Imagica;
}

/* ==============================
   GLOBAL ANIMATIONS
============================== */

@keyframes fadeInFromBlack {
  0% {
    opacity: 0;
    background-color: #000;
  }

  100% {
    opacity: 1;
  }
}

@keyframes contentFadeIn {
  0% {
    opacity: 0;
    transform: translateY(20px);
  }

  40% {
    opacity: 0;
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes mistFadeIn {
  0% {
    opacity: 0;
    filter: blur(20px);
    transform: scale(1.1);
    letter-spacing: 0.3em;
  }

  60% {
    opacity: 1;
    filter: blur(0px);
    transform: scale(1);
    letter-spacing: normal;
  }

  100% {
    opacity: 1;
    filter: blur(0px);
    transform: scale(1);
    letter-spacing: normal;
  }
}

@keyframes breathing {
  0% {
    box-shadow: 0 0 6px rgba(255, 215, 170, 0.2);
  }

  50% {
    box-shadow: 0 0 14px rgba(255, 215, 170, 0.4);
  }

  100% {
    box-shadow: 0 0 6px rgba(255, 215, 170, 0.2);
  }
}

@keyframes borderFlow {
  0% {
    background-position: 0% 50%;
  }

  50% {
    background-position: 100% 50%;
  }

  100% {
    background-position: 0% 50%;
  }
}

@keyframes floatQuote {
  0% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-6px) rotate(-0.2deg);
  }

  100% {
    transform: translateY(0) rotate(0);
  }
}

@keyframes compassSpin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes compassSpinFast {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes waExcerptFocus {
  0% {
    filter: blur(12px) brightness(1.20);
    transform: translateY(8px) scale(1.02);
  }

  70% {
    filter: blur(1px) brightness(1.05);
    transform: translateY(0) scale(1);
  }

  100% {
    filter: none;
    transform: translateY(0) scale(1);
  }
}

@keyframes waFlicker {

  0%,
  100% {
    opacity: 1;
  }

  48% {
    opacity: 0.96;
  }

  50% {
    opacity: 0.985;
  }

  52% {
    opacity: 0.97;
  }
}

@keyframes bookFloat {
  0% {
    transform: translateY(-25px) scale(1.3) rotate(0deg);
  }

  15% {
    transform: translateY(-32px) scale(1.3) rotate(0.3deg);
  }

  30% {
    transform: translateY(-28px) scale(1.3) rotate(-0.2deg);
  }

  50% {
    transform: translateY(-35px) scale(1.3) rotate(0.1deg);
  }

  65% {
    transform: translateY(-30px) scale(1.3) rotate(-0.3deg);
  }

  80% {
    transform: translateY(-33px) scale(1.3) rotate(0.2deg);
  }

  100% {
    transform: translateY(-25px) scale(1.3) rotate(0deg);
  }
}

@keyframes stickerFloat {

  0%,
  100% {
    transform: scale(1.25) rotate(-3deg) translateY(-10px);
    filter: brightness(1.1) drop-shadow(0 0 8px var(--color-accent));
  }

  50% {
    transform: scale(1.25) rotate(-1deg) translateY(-15px);
    filter: brightness(1.2) drop-shadow(0 0 15px var(--color-accent)) drop-shadow(0 0 30px var(--color-link));
  }
}

@keyframes tp-front-out {

  0%,
  31% {
    opacity: 1;
  }

  38%,
  100% {
    opacity: 0;
  }
}

@keyframes tp-line1-in {

  0%,
  44% {
    opacity: 0;
  }

  52%,
  100% {
    opacity: 1;
  }
}

@keyframes tp-line2-in {

  0%,
  70% {
    opacity: 0;
  }

  80%,
  100% {
    opacity: 1;
  }
}

@keyframes whisper-fade-in {
  0% {
    opacity: 0;
    transform: translateY(10px);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes whisper-fade-in-b {
  0% {
    opacity: 0;
    transform: translateY(-10px);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes tremble-subtle {
  0% {
    transform: translate(0, 0);
  }

  25% {
    transform: translate(0.5px, -0.5px);
  }

  50% {
    transform: translate(-0.5px, 0.5px);
  }

  75% {
    transform: translate(0.5px, 0.5px);
  }

  100% {
    transform: translate(-0.5px, -0.5px);
  }
}

/* ==============================
   BACKGROUND & PRESENTATION WRAPPER
============================== */

.user-css-presentation {
  background-image: url(https://www.worldanvil.com/i/6982189/render);
  background-size: cover;
  background-position: center;
  background-color: rgba(0, 76, 76, 0.9);
  background-blend-mode: multiply;
  justify-content: center;
  align-items: center;
  animation: fadeInFromBlack 2s ease-out;
}

.user-css-presentation .world-global-header {
  position: fixed;
  top: 0;
  height: 100px;
  z-index: 1000;
  background: url(https://www.worldanvil.com/i/6982210/render) center/cover no-repeat;
  background-color: rgba(0, 0, 0, 0.6);
  background-blend-mode: overlay;
  padding: 15px;
  display: flex;
  align-items: center;
  width: 100%;
  min-width: unset;
  margin: 0 auto;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
}

.user-css.world-global-header h1,
.user-css.world-global-header h2,
.user-css.world-global-header p {
  color: var(--color-text, #f8f8f8);
  margin: 0;
  text-align: center;
  font-size: clamp(18px, 3vw, 32px);
}

.user-css-presentation .world-global-header .d-block {
  display: flex !important;
}

.user-css-presentation .row .world-content {
  text-align: center !important;
}

.user-css {
  background: linear-gradient(to bottom, rgba(0, 20, 40, 0.3) 0%, rgba(0, 30, 30, 0.4) 80%), url(https://www.worldanvil.com/i/6982205/render);
  box-shadow: inset 0px 0px 20px var(--color-background);
  width: fit-content;
  max-width: 100%;
  justify-self: center;
  box-sizing: border-box;
  margin: clamp(20px, 12vw, 500px);
}

.user-css>*:not(.article-title) {
  animation: contentFadeIn 2.5s ease-out;
}

/* ==============================
   HOMEPAGE: BASE
============================== */

.user-css.page-world-homepage {
  background: transparent !important;
  box-shadow: none !important;
}

.user-css.page-world-homepage h5 a {
  font-family: var(--font-header);
  font-size: 35px;
  top: 20px;
  position: relative;
}

.user-css.page-world-homepage #cover img {
  width: 100%;
  height: auto;
  display: block;
  -webkit-mask-image: linear-gradient(to bottom, black 45%, transparent 100%), linear-gradient(to top, black 65%, transparent 100%), linear-gradient(to right, black 45%, transparent 100%), linear-gradient(to left, black 45%, transparent 100%);
  -webkit-mask-composite: destination-in;
  mask-image: linear-gradient(to bottom, black 45%, transparent 100%), linear-gradient(to top, black 65%, transparent 100%), linear-gradient(to right, black 45%, transparent 100%), linear-gradient(to left, black 45%, transparent 100%);
  mask-composite: intersect;
  opacity: 0.6;
  filter: blur(0.1px) brightness(90%);
}

.user-css.page-world-homepage h2 {
  font-family: var(--font-quote);
  text-transform: capitalize;
  font-weight: 400;
  letter-spacing: 2px;
  background: var(--color-header);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  -moz-background-clip: text;
  color: transparent;
  font-size: clamp(35px, 5vw, 90px);
  text-shadow: var(--color-header-shadow);
  text-align: center;
  border-bottom: 2px solid var(--color-border);
}

.user-css.page-world-homepage .user-custom-content-3 img.img-fluid.img-responsive,
.user-css.page-world-homepage .user-custom-content-3 img.img-responsive.img-fluid {
  box-shadow: none !important;
  filter: none !important;
}

.user-css.page-world-homepage .user-custom-content-3 img.img-fluid.img-responsive:hover,
.user-css.page-world-homepage .user-custom-content-3 img.img-responsive.img-fluid:hover {
  box-shadow: none !important;
  filter: none !important;
}

/* ==============================
   WHITE LABEL MARK
============================== */

.user-css-presentation .widget-white-label-mark {
  margin: 0 auto;
  font-family: var(--font-meta) !important;
  color: var(--color-text) !important;
  border: 2px solid var(--color-border);
  border-radius: 0 5px 5px 0;
  border-left: none;
}

.user-css-presentation .widget-white-label-mark a {
  margin: 0 auto;
  font-family: var(--font-meta) !important;
  font-size: 15px;
}

/* ==============================
   WORLD: TITLE + SUBTITLE
============================== */

.user-css .heading h1 {
  margin: 0;
  padding-top: 0.5em;
  color: transparent;
  line-height: 1.1;
}

.user-css .world-subtitle {
  display: inline-block;
  font-family: var(--font-quote);
  font-size: clamp(30px, 5vw, 200px);
  font-weight: 400;
  letter-spacing: 2px;
  line-height: 1.2;
  padding: 0.2em 0;
  text-align: center;
  background: var(--color-header);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  -moz-background-clip: text;
  color: transparent;
  text-shadow: var(--color-header-shadow);
}

/* ==============================
   WORLD: HIDE AUTHORS + TOC MENU
============================== */

.user-css .world-authors {
  display: none;
}

.user-css .table-of-contents .world-menu {
  display: none;
}

/* ==============================
   WORLD NAVIGATION
============================== */

.user-css-presentation .world-navigation-palette-trigger {
  background: none !important;
  display: inline-block;
  cursor: pointer;
}

.user-css-presentation .world-navigation-palette-trigger .fa-list {
  content: url(https://www.worldanvil.com/i/6982203/render);
  width: 150px;
  height: auto;
  display: inline-block;
  position: absolute;
  top: 40px;
  transition: transform 0.6s ease, filter 0.3s ease;
  animation: compassSpin 20s linear infinite;
}

.user-css-presentation .world-navigation-palette-trigger:hover .fa-list {
  animation: compassSpinFast 2s linear infinite;
  filter: drop-shadow(0 0 10px rgba(139, 69, 19, 0.4)) drop-shadow(0 0 10px rgba(205, 127, 50, 0.3)) drop-shadow(0 0 60px rgba(233, 170, 92, 0.5));
}

.user-css-presentation #world-navigation-sidebar {
  width: clamp(200px, 20%, 250px);
  max-height: 40vh;
  left: 150px;
  position: fixed;
  background: linear-gradient(0deg, rgba(4, 9, 15, 1) 0%, rgba(9, 42, 47, 1) 100%);
  border: 2px solid var(--color-border);
  box-shadow: inset 0 0 10px var(--color-muted);
  text-align: center;
  scrollbar-color: var(--color-muted) var(--color-background);
  border-top: 5px double var(--color-muted);
  border-radius: 15px;
  padding: 10px;
  overflow-y: auto;
  z-index: 1500;
}

.user-css-presentation #world-navigation-sidebar .map-box,
.user-css-presentation #world-navigation-sidebar .maps-list-header {
  display: none;
}

.user-css .world-meta-categories-link,
.user-css .world-menu,
.user-css .world-toc-header,
.user-css.page.sidebar-panel-open .world-timelines {
  display: none;
}

.user-css .world-navigation-custom-content h2 {
  font-family: var(--font-header);
  border-bottom: 3px double var(--color-border);
  background: var(--color-header);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  -moz-background-clip: text;
  color: transparent;
  font-size: clamp(24px, 4vw, 40px);
  text-align: center;
}

.user-css .world-navigation-custom-content a {
  display: block;
  line-height: 1.9em;
  font-weight: 400;
  font-size: clamp(14px, 4vw, 20px);
  font-family: var(--font-body);
  color: var(--color-link);
  transition: color 0.3s ease, transform 0.3s ease;
  text-decoration: none;
  margin-bottom: 5px;
}

.user-css .world-navigation-custom-content a:hover {
  color: var(--color-accent);
  transform: scale(1.05);
  text-decoration: underline;
}

/* ==============================
   LINKS
============================== */

.user-css a {
  color: var(--color-link);
  font-family: var(--font-body);
  font-size: clamp(16px, 1.2vw, 25px);
  text-decoration: none;
  transition: all 0.3s ease;
}

.user-css a:not(.btn):not(.world-navigation-custom-content a):hover {
  background: var(--color-link-hover);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  text-shadow: 0 0 8px var(--color-shadow);
}

/* ==============================
   SEARCH BAR
============================== */

.user-css .search-form .typeahead-input {
  z-index: 1200;
  position: fixed;
  top: calc(var(--header-height, 90px));
  width: 100%;
  left: -1px;
  text-align: center;
  background: var(--color-secondary-gradient);
  font-family: var(--font-header);
  font-size: clamp(18px, 2.5vw, 25px);
  color: var(--color-accent);
  letter-spacing: 2px;
  padding: clamp(5px, 3vw, 10px) 0 clamp(8px, 2vw, 5px);
  outline: none;
  transition: all 0.3s ease-in-out;
}

.user-css .search-form .typeahead-input:focus {
  animation: breathing 2s infinite ease-in-out;
  border-color: var(--color-accent);
}

/* ==============================
   BREADCRUMBS
============================== */

.user-css .article-title {
  display: flex;
  flex-direction: column;
}

.user-css .breadbox {
  order: 1;
}

.user-css .article-title .m-b-0 {
  order: 2;
}

.user-css .article-title-author {
  order: 3;
}

.user-css .breadbox .breadcrumb-world-link-wrapper {
  display: none;
}

.user-css .breadbox {
  margin: 30px -2px 10px 15px;
}

.user-css .breadbox .breadcrumb {
  font-family: var(--font-header);
  font-size: 30px;
  letter-spacing: 2px;
  height: 80px;
  background: transparent;
}

.user-css .breadbox .breadcrumb a {
  font-family: var(--font-header);
  font-size: 30px;
  font-weight: 400;
  letter-spacing: 2px;
}

.user-css .category-contents .breadcrumb {
  display: none;
}

.user-css .breadcrumb-article-icon {
  color: var(--color-text);
}

/* ==============================
   ARTICLE HEADERS
============================== */

.article-title h1 {
  display: block;
  animation: mistFadeIn 3s ease-out forwards;
}

.user-css .article-content h1 {
  font-family: var(--font-header);
  text-transform: uppercase;
  font-size: clamp(32px, 6vw, 80px);
  text-align: center;
  background: var(--color-header);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  -moz-background-clip: text;
  color: transparent;
  margin-top: 40px;
}

.user-css .article-content h2 {
  font-size: clamp(24px, 4vw, 55px);
  border-bottom: 2px solid var(--color-link);
  font-family: var(--font-header);
  background: var(--color-small-header);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  -moz-background-clip: text;
  color: transparent;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.user-css .article-content h3,
.user-css .article-content h4,
.user-css .article-content h5 {
  font-family: var(--font-header);
  background: var(--color-small-header);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  -moz-background-clip: text;
  color: transparent;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.user-css .article-content h3 {
  font-size: clamp(22px, 3.5vw, 50px);
}

.user-css .article-content h4 {
  font-size: clamp(20px, 3vw, 45px);
}

.user-css .article-content h5 {
  font-size: clamp(18px, 2.5vw, 35px);
}

/* ==============================
   ARTICLE CONTENT BASE
============================== */

.user-css .article-content {
  font-family: var(--font-body);
  color: var(--color-text);
  font-size: clamp(16px, 1.2vw, 25px);
  line-height: 1.6;
}

.user-css #cover img {
  -webkit-mask-composite: destination-in;
  mask-image: linear-gradient(to bottom, black 15%, transparent 100%), linear-gradient(to top, black 80%, transparent 100%);
  mask-composite: intersect;
  opacity: 0.7;
  filter: brightness(90%);
}

/* ==============================
   ARTICLE IMAGES
============================== */

.user-css img,
.user-css-extended img {
  max-width: 100%;
  height: auto;
  object-fit: contain;
}

.user-css .article-content .img-responsive.img-fluid,
.user-css .article-content .max-width-100 {
  max-width: 100%;
  height: auto;
  object-fit: contain;
}

.user-css .article-content .img-responsive.img-fluid:not(.bookcover img),
.user-css .article-content .max-width-100:not(.bookcover img) {
  display: block;
  height: auto;
  filter: sepia(1) contrast(1.1) brightness(0.7);
  -webkit-mask-image: radial-gradient(circle, rgba(0, 0, 0, 1) 70%, rgba(0, 0, 0, 0) 100%);
  border: 40px solid transparent;
  border-image: url(https://www.worldanvil.com/i/6986890/render) 30 round;
  transform: rotate(-0.8deg);
  transition: transform 0.6s ease, filter 4s ease, box-shadow 0.6s ease;
}

.user-css .article-content .img-responsive.img-fluid:not(.bookcover img):hover,
.user-css .article-content .max-width-100:not(.bookcover img):hover {
  box-shadow: inset 0 0 100px rgba(0, 0, 0, 1);
  filter: sepia(0) contrast(1.1) brightness(1) opacity(0.9);
  transform: rotate(0.5deg) translateY(-4px);
}

/* ==============================
   ARTICLE PANELS
============================== */

.user-css .article-panel {
  position: relative;
  overflow: hidden;
  border-radius: 20px 0px;
  background: var(--color-secondary-bg);
  border: 1px solid var(--color-border);
  transition: box-shadow 1s ease;
}

.user-css .article-panel:hover {
  box-shadow: 0 0 15px var(--color-shadow);
  z-index: 10;
}

.user-css .article-panel .heading {
  font-family: var(--font-header);
  font-size: clamp(20px, 2vw, 35px);
  background: var(--color-header);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  -moz-background-clip: text;
  color: transparent;
  margin-bottom: 10px;
}

.user-css .article-panel .subheading {
  display: none;
}

.user-css .article-panel::before {
  content: close-quote;
  font-size: 0;
  line-height: 0;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--color-background);
  opacity: 0;
  transition: opacity 0.4s ease;
  z-index: 2;
  pointer-events: none;
}

.user-css .article-panel .details,
.user-css .article-panel .details .heading {
  text-align: center;
}

.user-css .article-panel .details .heading {
  width: 100%;
  margin-left: auto;
  margin-right: auto;
}

.user-css .article-panel:hover::before {
  opacity: 1;
}

.user-css .article-panel .details p {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-background-gradient);
  padding: 20px;
  margin: 0;
  overflow-y: auto;
  font-family: var(--font-body);
  font-size: clamp(16px, 2vw, 22px);
  line-height: 1.6;
  color: var(--color-link);
  text-shadow: 0 0 2px var(--color-accent);
  border-radius: 20px 0px;
  opacity: 0;
  transition: opacity 0.4s ease;
  z-index: 3;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-css .article-panel:hover .details p {
  opacity: 1;
}

.user-css .article-panel .details p.excerpt {
  opacity: 0 !important;
  filter: blur(12px) brightness(1.15);
  transform: translateY(8px) scale(1.02);
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.user-css .article-panel:hover .details p.excerpt {
  opacity: 1 !important;
  animation: waExcerptFocus 1.1s ease forwards, waFlicker 3.2s ease-in-out infinite;
}

/* ==============================
   CREDITS CONTAINER
============================== */

.user-css .credits {
  color: var(--color-text);
  margin: 12px auto;
  padding: 8px 16px;
  font-family: var(--font-meta);
  font-size: clamp(12px, 1.2vw, 16px);
  line-height: 1.4;
  text-align: center;
  max-width: 100%;
  box-sizing: border-box;
  background-color: var(--color-background);
  border: 1px solid var(--color-border);
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
  margin-left: auto;
  margin-right: auto;
  transition: box-shadow 0.3s ease, transform 0.3s ease;
}

.user-css .credits:hover {
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5), 0 0 10px rgba(224, 200, 168, 0.4);
  transform: scale(1.02);
}

.user-css .credits a {
  font-family: var(--font-meta);
  font-size: clamp(12px, 1.2vw, 16px);
  text-decoration: none;
  transition: color 0.3s ease;
}

/* ==============================
   SOCIAL CONTAINER
============================== */

.user-css .social {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20px;
  padding: 10px 15px;
  font-family: var(--font-header);
  font-size: clamp(15px, 1.5vw, 25px);
  color: var(--color-link);
  text-shadow: 0 0 5px var(--color-shadow);
  background: var(--color-background);
  opacity: 0.5;
  pointer-events: auto;
  z-index: 10;
  height: 100px;
  width: 100%;
}

.user-css .social img {
  height: 28px;
  width: auto;
  transition: all 0.3s ease;
  cursor: pointer;
}

.user-css .social img:hover {
  transform: scale(1.4);
}

/* ==============================
   OVERLAY WRAPPER
============================== */

.user-css .overlay-wrapper {
  position: relative;
  width: 100%;
  min-height: 400px;
  overflow: hidden;
  background-color: var(--color-background);
}

.user-css .overlay-base {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: url(https://www.worldanvil.com/i/6982205/render);
  background-position: center;
  z-index: 1;
  mix-blend-mode: difference;
}

.user-css .overlay-top {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
}

/* ==============================
   PRIMER CONTAINER
============================== */

.user-css .primer {
  position: relative;
  border-style: solid;
  border-width: 90px;
  border-image: url(https://www.worldanvil.com/i/6982193/render) 900;
  border-image-outset: 12px 7px;
  font-family: var(--font-body);
  font-size: clamp(16px, 1.5vw, 22px);
  color: var(--color-text);
  text-align: center;
  padding: 20px;
  box-sizing: border-box;
  z-index: 2;
}

/* ==============================
   ALOUD CONTAINER
============================== */

.user-css .aloud {
  position: relative;
  margin: 50px auto;
  padding: 160px;
  border-image-source: url(https://www.worldanvil.com/i/6982212/render);
  border-image-slice: 200 fill;
  border-image-repeat: round;
  border-image-width: 200px;
  font-family: var(--font-body);
  font-size: clamp(14px, 3.6vw, 25px);
  font-style: normal;
  color: var(--color-muted);
  text-shadow: var(--color-shadow);
  -webkit-mask-composite: destination-in;
  mask-image: linear-gradient(to bottom, black 65%, transparent 100%), linear-gradient(to top, black 75%, transparent 100%), linear-gradient(to right, black 95%, transparent 100%), linear-gradient(to left, black 95%, transparent 100%);
  mask-composite: intersect;
}

/* ==============================
   PARCHMENT CONTAINER
============================== */

.user-css .parchment {
  position: relative;
  background: linear-gradient(145deg, #b8a089 0%, #c9b89e 15%, #d4c4a8 30%, #c9b598 50%, #bda888 70%, #b09878 85%, #a68d6a 100%);
  color: #1a1410;
  font-family: var(--font-body);
  font-size: clamp(16px, 1.4vw, 22px);
  line-height: 1.8;
  padding: 40px 50px;
  margin: 30px auto;
  max-width: 90%;
  border: 3px solid var(--color-border);
  border-radius: 2px;
  box-shadow: 0 0 0 6px var(--color-background), 0 0 0 8px rgba(180, 116, 77, 0.4), inset 0 0 60px rgba(80, 55, 30, 0.12), 0 8px 30px rgba(0, 0, 0, 0.6);
}

.user-css .parchment::before {
  content: '';
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(60, 40, 20, 0.2);
  border-radius: 0;
  pointer-events: none;
}

/* Enhanced ::after with corner shadows + scattered stains */

.user-css .parchment::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    /* Original corner shadows */
    radial-gradient(ellipse at top left, rgba(60, 40, 20, 0.18) 0%, transparent 35%), radial-gradient(ellipse at bottom right, rgba(60, 40, 20, 0.2) 0%, transparent 35%), radial-gradient(ellipse at top right, rgba(60, 40, 20, 0.1) 0%, transparent 30%), radial-gradient(ellipse at bottom left, rgba(60, 40, 20, 0.1) 0%, transparent 30%),
    /* Water stain - large faded ring, upper area */
    radial-gradient(ellipse at 70% 15%, rgba(90, 65, 35, 0.08) 0%, rgba(70, 50, 30, 0.12) 30%, transparent 50%),
    /* Coffee/tea drip stain - irregular blob, mid-right */
    radial-gradient(ellipse at 85% 45%, rgba(80, 50, 25, 0.15) 0%, rgba(60, 40, 20, 0.08) 40%, transparent 55%),
    /* Age spot - small dark blotch, lower left */
    radial-gradient(circle at 15% 75%, rgba(50, 35, 20, 0.2) 0%, transparent 8%),
    /* Foxing spots - scattered small dots */
    radial-gradient(circle at 25% 20%, rgba(100, 70, 40, 0.12) 0%, transparent 4%), radial-gradient(circle at 60% 80%, rgba(90, 60, 35, 0.1) 0%, transparent 5%), radial-gradient(circle at 40% 55%, rgba(85, 55, 30, 0.08) 0%, transparent 3%), radial-gradient(circle at 80% 70%, rgba(95, 65, 40, 0.1) 0%, transparent 4%), radial-gradient(circle at 10% 40%, rgba(80, 55, 30, 0.09) 0%, transparent 3%),
    /* Larger aged area - subtle discoloration */
    radial-gradient(ellipse at 30% 85%, rgba(70, 50, 30, 0.1) 0%, transparent 25%),
    /* Edge darkening/burn */
    linear-gradient(to right, rgba(50, 35, 20, 0.08) 0%, transparent 5%, transparent 95%, rgba(50, 35, 20, 0.08) 100%), linear-gradient(to bottom, rgba(50, 35, 20, 0.06) 0%, transparent 8%, transparent 92%, rgba(50, 35, 20, 0.1) 100%);
  pointer-events: none;
  border-radius: 2px;
  mix-blend-mode: multiply;
}


/* ==============================
   BORDERED-CARDBG CONTAINER
============================== */

.user-css .bordered-cardbg {
  position: relative;
   background:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/6a60fda871f1b00a448ea3c8b76e33ea.png)
    center center / 100% 100% no-repeat;
  color: #1a1410;
  font-family: var(--font-body);
  font-size: clamp(16px, 1.4vw, 22px);
  line-height: 1.8;
  padding: 40px 50px;
  margin: 30px auto;
  max-width: 90%;
  border: 3px solid var(--color-border);
  border-radius: 2px;
  box-shadow: 0 0 0 6px var(--color-background), 0 0 0 8px rgba(180, 116, 77, 0.4), inset 0 0 60px rgba(80, 55, 30, 0.12), 0 8px 30px rgba(0, 0, 0, 0.6);
}

.user-css .bordered-cardbg::before {
  content: '';
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(60, 40, 20, 0.2);
  border-radius: 0;
  pointer-events: none;
}

/* Enhanced ::after with corner shadows + scattered stains */

.user-css .bordered-cardbg::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
  pointer-events: none;
  border-radius: 2px;
  mix-blend-mode: multiply;
}



/* ==============================
   PARCHMENT 2 PORTRAIT CARD
============================== */

.user-css .parchment2 {
  position: relative;
  box-sizing: border-box;

  width: min(420px, 94%);
  min-height: 620px;

  margin: 30px auto;
  padding: 66px 44px 72px;

  background:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/d9e3d8a4e1de6866815979dee58f29e6.png)
    center center / 100% 100% no-repeat;

  color: #1a1410;
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.42;

  border: none;
  border-radius: 3px;

  box-shadow:
    0 8px 26px rgba(0, 0, 0, .55);

  overflow: hidden;
  overflow-wrap: break-word;
  hyphens: auto;
}

/* Keeps all content above the decorative shading */

.user-css .parchment2 > * {
  position: relative;
  z-index: 2;
}

/* Item title */

.user-css .parchment2 h5 {
  margin: 0 0 5px;
  padding: 0;

  color: #21150f;
  font-family: var(--font-title);
  font-size: 1.65em;
  line-height: 1.08;
  text-align: left;
}

/* Item classification line */

.user-css .parchment2 .item-meta {
  margin: 0 0 12px;
  padding: 0;

  font-size: .94em;
  line-height: 1.3;
  font-style: italic;
  text-align: left;
}

/* Removes inherited spacing from the alignment wrapper */

.user-css .parchment2 .item-meta .text-left,
.user-css .parchment2 .item-meta p {
  margin: 0;
  padding: 0;
  text-align: left;
}

/* Opening description */

.user-css .parchment2 .item-introduction {
  margin: 0 0 12px;
  padding: 0;

  line-height: 1.42;
}

/* Main text paragraphs */

.user-css .parchment2 p {
  margin: 0 0 9px;
  padding: 0;
}

/* Property names */

.user-css .parchment2 strong,
.user-css .parchment2 b {
  color: #2b1710;
  font-weight: 700;
}

/* Removes excess space after the final element */

.user-css .parchment2 p:last-child,
.user-css .parchment2 > *:last-child {
  margin-bottom: 0;
}

/* Subtle darkening at the parchment edges */

.user-css .parchment2::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;

  pointer-events: none;

  background:
    radial-gradient(
      ellipse at top left,
      rgba(60, 40, 20, .08),
      transparent 35%
    ),
    radial-gradient(
      ellipse at bottom right,
      rgba(60, 40, 20, .10),
      transparent 38%
    );

  mix-blend-mode: multiply;
}

/* Mobile adjustment */

@media screen and (max-width: 500px) {
  .user-css .parchment2 {
    width: 96%;
    padding: 58px 34px 64px;

    font-size: 13px;
    line-height: 1.4;
  }

  .user-css .parchment2 h5 {
    font-size: 1.5em;
  }
}

/* ==============================
   BORDER-CARD
============================== */

.user-css .border-card {
  position: relative;

  background:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/6a60fda871f1b00a448ea3c8b76e33ea.png)
    center center / 100% 100% no-repeat;

  color: #1a1410;
  font-family: var(--font-body);
  font-size: clamp(15px, 1.15vw, 20px);
  line-height: 1.65;

  width: min(420px, 92%);
  min-height: 620px;

  padding: 72px 58px 78px 58px;
  margin: 30px auto;

  border: none;
  border-radius: 3px;

  box-shadow:
    0 8px 26px rgba(0,0,0,.55);

  overflow: hidden;
}

/* Optional subtle darkening at the very edges */

.user-css .border-card::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;

  background:
    radial-gradient(ellipse at top left, rgba(60,40,20,.08), transparent 35%),
    radial-gradient(ellipse at bottom right, rgba(60,40,20,.10), transparent 38%);

  mix-blend-mode: multiply;
  z-index: 10;
}




/* ==============================
   SIDE-CARD
============================== */

.user-css .side-card {
    position: relative;

    background: url("https://cdn.midjourney.com/6d154a3f-dbbf-4c0f-a623-e47885010ed8/0_2.png")
                center center / cover no-repeat;

    color: #1a1410;
    font-family: var(--font-body);
    font-size: clamp(15px, 1.2vw, 20px);
    line-height: 1.7;

    padding: 48px;
    margin: 30px auto;
    max-width: 420px;

    box-shadow:
        0 8px 24px rgba(0,0,0,.45);

    /* Slightly irregular "hand-cut" edge */
    clip-path: polygon(
        1% 2%, 4% 0%, 9% 1%, 15% 0%, 21% 2%, 28% 1%, 36% 0%, 44% 2%, 53% 1%, 61% 0%,
        70% 2%, 79% 1%, 87% 0%, 94% 2%, 99% 1%,
        100% 4%, 99% 12%, 100% 21%, 98% 31%, 100% 43%, 99% 55%, 100% 67%, 98% 79%, 100% 90%, 99% 98%,
        95% 100%, 87% 99%, 77% 100%, 67% 98%, 56% 100%, 45% 99%, 34% 100%, 23% 98%, 12% 100%, 2% 99%,
        0% 95%, 2% 86%, 0% 75%, 1% 64%, 0% 53%, 2% 41%, 0% 29%, 1% 18%, 0% 8%
    );

    overflow: hidden;
}

.user-css .side-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;

    /* Soft edge darkening for depth */
    background:
        radial-gradient(ellipse at top left, rgba(70,45,20,.10), transparent 35%),
        radial-gradient(ellipse at top right, rgba(70,45,20,.08), transparent 35%),
        radial-gradient(ellipse at bottom left, rgba(70,45,20,.08), transparent 35%),
        radial-gradient(ellipse at bottom right, rgba(70,45,20,.12), transparent 35%);
}
/* ==========================================
   PHB-STYLE WEAPON STAT CARD CONTAINER 
========================================== */

.user-css .weapon-card {
  position: relative;
  box-sizing: border-box;

  width: min(920px, 96%);
  min-height: 440px;

  margin: 30px auto;
  padding: 68px 76px 66px;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/c9d5ca29575b5b7d32d8162d8e599e6a.png);
  background-position: center center;
  background-size: 100% 100%;
  background-repeat: no-repeat;

  color: #21170f;

  font-family:
    var(--font-body),
    Georgia,
    serif;

  font-size: 15px;
  line-height: 1.46;

  border: none;
  border-radius: 0;

  box-shadow:
    0 8px 24px rgba(0, 0, 0, .45);

  overflow-wrap: break-word;
  hyphens: auto;
}

/* Keeps card content above decorative layers */

.user-css .weapon-card > * {
  position: relative;
  z-index: 2;
}

/* ==========================================
   WEAPON NAME
========================================== */

.user-css .weapon-card h5 {
  margin: 0 0 4px;
  padding: 0 0 5px;

  color: #6f251c;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-size: 2em;
  font-weight: 700;
  font-variant: small-caps;
  line-height: 1.05;
  letter-spacing: .025em;

  text-align: left;

  border-bottom: 2px solid #8b4a2f;
}

/* ==========================================
   WEAPON CLASSIFICATION LINE
========================================== */

.user-css .weapon-card .weapon-meta {
  margin: 0 0 13px;
  padding: 0;

  color: #342218;

  font-size: .94em;
  font-style: italic;
  line-height: 1.3;
  text-align: left;
}

.user-css .weapon-card .weapon-meta p,
.user-css .weapon-card .weapon-meta .text-left {
  margin: 0;
  padding: 0;

  text-align: left;
}

/* ==========================================
   OPENING DESCRIPTION
========================================== */

.user-css .weapon-card .weapon-introduction {
  margin: 0 0 14px;
  padding: 0;

  font-style: italic;
  line-height: 1.45;
}

/* ==========================================
   BODY TEXT
========================================== */

.user-css .weapon-card p {
  margin: 0 0 10px;
  padding: 0;
}

.user-css .weapon-card p:last-child,
.user-css .weapon-card > *:last-child {
  margin-bottom: 0;
}

.user-css .weapon-card strong,
.user-css .weapon-card b {
  color: #5f2119;
  font-weight: 700;
}

.user-css .weapon-card em,
.user-css .weapon-card i {
  color: #2c1c14;
}

/* ==========================================
   OPTIONAL SECTION HEADINGS
========================================== */

.user-css .weapon-card h6 {
  margin: 16px 0 6px;
  padding: 0 0 3px;

  color: #6f251c;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-size: 1.22em;
  font-weight: 700;
  font-variant: small-caps;
  line-height: 1.15;
  letter-spacing: .02em;

  border-bottom: 1px solid rgba(111, 37, 28, .65);
}

/* ==========================================
   WEAPON STAT TABLE
========================================== */

.user-css .weapon-card .table-responsive {
  width: 100%;
  margin: 0 0 14px;

  overflow-x: auto;
}

.user-css .weapon-card table {
  width: 100%;
  margin: 0 0 14px;

  border-collapse: collapse;
  border-spacing: 0;

  background: transparent;

  color: #21170f;

  font-family:
    var(--font-body),
    Georgia,
    serif;

  font-size: .92em;
  line-height: 1.3;
}

.user-css .weapon-card table thead,
.user-css .weapon-card table tr:first-child {
  border-top: 2px solid #7b3525;
  border-bottom: 2px solid #7b3525;
}

.user-css .weapon-card table th {
  padding: 6px 8px;

  background: rgba(122, 67, 36, .12);
  color: #64251c;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-weight: 700;
  font-variant: small-caps;
  letter-spacing: .02em;
  text-align: left;
  vertical-align: bottom;
}

.user-css .weapon-card table td {
  padding: 6px 8px;

  background: transparent;
  border-bottom: 1px solid rgba(93, 54, 31, .35);

  text-align: left;
  vertical-align: top;
}

.user-css .weapon-card table tbody tr:nth-child(odd) td {
  background: rgba(137, 91, 45, .07);
}

.user-css .weapon-card table tbody tr:last-child td {
  border-bottom: 2px solid #7b3525;
}

/* Overrides unwanted World Anvil table decoration */

.user-css .weapon-card table,
.user-css .weapon-card table tr,
.user-css .weapon-card table td,
.user-css .weapon-card table th {
  box-shadow: none;
}

/* ==========================================
   OPTIONAL RULE DIVIDER
========================================== */

.user-css .weapon-card .weapon-rule {
  height: 2px;

  margin: 14px 0;

  background:
    linear-gradient(
      to right,
      transparent,
      #8a4b2d 12%,
      #8a4b2d 88%,
      transparent
    );
}

/* ==========================================
   MOBILE
========================================== */

@media screen and (max-width: 600px) {
  .user-css .weapon-card {
    width: 98%;
    min-height: 0;

    margin: 20px auto;
    padding: 44px 38px 46px;

    font-size: 13px;
    line-height: 1.4;
  }

  .user-css .weapon-card h5 {
    font-size: 1.65em;
  }

  .user-css .weapon-card table {
    font-size: .84em;
  }

  .user-css .weapon-card table th,
  .user-css .weapon-card table td {
    padding: 5px 4px;
  }
}



/* ==========================================
   PHB-STYLE GEAR STAT CARD CONTAINER
  ========================================== */

.user-css .gear-card {
  position: relative;
  z-index: 0;
  isolation: isolate;
  box-sizing: border-box;

  width: min(920px, 96%);
  min-height: 440px;

  margin: 30px auto;
  padding: 68px 76px 66px;

  background: transparent !important;

  color: #21170f;

  font-family:
    var(--font-body),
    Georgia,
    serif;

  font-size: 15px;
  line-height: 1.46;

  border: none;
  border-radius: 0;

  box-shadow:
    0 8px 24px rgba(0, 0, 0, .45);

  overflow: hidden;
  overflow-wrap: break-word;
  hyphens: auto;
}

/* ==========================================
   ROTATED PARCHMENT IMAGE
========================================== */

.user-css .gear-card .gear-card-image {
  position: absolute !important;
  inset: 0;

  z-index: -1;

  display: block !important;

  width: 100%;
  height: 100%;

  margin: 0 !important;
  padding: 0 !important;

  background-color: transparent !important;
  background-image:
    url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/ed65d1fbc85523a758337c764781e8cb.png);
  background-position: center center;
  background-size: 100% 100%;
  background-repeat: no-repeat;

  transform: rotate(180deg);
  transform-origin: center center;

  pointer-events: none;
}

/* Hides the placeholder break inside the image container */

.user-css .gear-card .gear-card-image br {
  display: none;
}

/* ==========================================
   GEAR NAME
========================================== */

.user-css .gear-card h5 {
  position: relative;

  margin: 0 0 4px;
  padding: 0 0 5px;

  color: #6f251c;

  font-family:
    var(--font-title),
