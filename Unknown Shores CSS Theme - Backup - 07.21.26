========================================== */

.user-css .gear-card .table-responsive {
  position: relative;

  width: 100%;
  margin: 0 0 14px;

  overflow-x: auto;
}

.user-css .gear-card table {
  position: relative;

  width: 100%;
  margin: 0 0 14px;

  border-collapse: collapse;
  border-spacing: 0;

  background: transparent;

  color: #21170f;

  font-family:
    var(--font-body),
    Georgia,
    serif;

  font-size: .92em;
  line-height: 1.3;
}

.user-css .gear-card table thead,
.user-css .gear-card table tr:first-child {
