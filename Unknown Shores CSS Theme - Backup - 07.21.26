/* =========================================================
   HORIZONTAL SIMPLE SCROLL
========================================================= */

/* Edit this if you want to change the styling of the text within the scroll */

.simplescroll .scrollcontent {
  color: #3A1D18;
  font-weight: 900;
  font-size: 17px;
}

.simplescroll .scrollcontent h2 {
  color: #3A1D18;
  font-weight: 900;
  font-size: 24px;
}

@keyframes scrolltext-horiz {
  0% {
    opacity: 0;
    text-shadow: 0 0 0 rgba(255, 255, 255, 0);
  }

  30% {
    opacity: 1;
    text-shadow: 0 0 50px rgba(255, 255, 255, 0.9), 0 0 30px rgba(255, 255, 255, 0.7);
  }

  60% {
    opacity: 1;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.6);
  }

  100% {
    opacity: 1;
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.5);
  }
}

.simplescroll {
  display: block;
  position: relative;
  z-index: 5;
  height: 450px;
}

.simplescroll .spoiler-card {
  display: none;
}

.simplescroll .well,
.simplescroll .collapse.in,
.simplescroll .collapsing {
  display: none;
}

.simplescroll .spoiler-button[aria-expanded$=true]~.scrollcontent {
  animation: scrolltext-horiz 1.9s;
  text-shadow: 0 0 15px white;
  display: block;
  z-index: 1;
  width: 630px;
  inline-size: 630px;
  clip-path: inset(0 0% 0 0);
  transition: all 2s;
  overflow: hidden;
  padding-right: 10px;
}

.simplescroll .scrollcontent {
  position: absolute;
  z-index: 1;
  width: 630px;
  height: 400px;
  padding: 10px;
  clip-path: inset(0 92% 0 0);
  padding-left: 50px;
  transition: all 2.2s;
  overflow: hidden;
}

.simplescroll .spoiler-button[aria-expanded$=true]~.scrollbg {
  width: 640px;
  transition: 2s;
}

.simplescroll .scrollbg {
  width: 50px;
  height: 400px;
  left: 20px;
  position: absolute;
  background: linear-gradient(to left, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.0)), url(https://www.worldanvil.com/uploads/images/d699204d24cf8d858745f4cbc106a3af.png);
  transition: 2s;
}

/* Spoiler button styling rules */

.simplescroll .spoiler-button {
  position: absolute;
  z-index: 5;
  margin: 0;
  left: 35px;
  width: 80px;
  height: 400px;
  opacity: 0;
}

.simplescroll .spoiler-button:hover {
  left: 38px;
}

.simplescroll .spoiler-button[aria-expanded$=true] {
  left: 635px;
}

.simplescroll .spoiler-button[aria-expanded$=true]:hover {
  left: 625px;
  transition: all 1s;
}

/* Rotation and animation of the scroll rolling to the side */

.simplescroll .spoiler-button:hover~.scroll {
  transform: rotateY(30deg);
  left: 80px;
}

.simplescroll .spoiler-button[aria-expanded$=true]:hover~.scroll {
  transform: rotateY(720deg);
  left: 640px;
}

.simplescroll .spoiler-button[aria-expanded$=true]~.scroll {
  transform: rotateY(760deg);
  left: 645px;
}

/* Cylinder wrap */

.simplescroll .scroll {
  transform-style: preserve-3d;
  position: relative;
  left: 70px;
  transform: rotateY(0deg);
  transition: all 2s;
  transform-origin: 2.4%;
  z-index: 2;
}

.simplescroll .scroll1,
.simplescroll .scroll2,
.simplescroll .scroll3,
.simplescroll .scroll4,
.simplescroll .scroll5,
.simplescroll .scroll6,
.simplescroll .scroll7,
.simplescroll .scroll8 {
  transform-style: preserve-3d;
  position: absolute;
  width: 25px;
  height: 400px;
  background: #000 url(https://www.worldanvil.com/uploads/images/9f0f00a10595514171d9147df84355c7.png);
  border-top: 5px solid rgb(145, 87, 0);
  border-bottom: 5px solid rgb(145, 87, 0);
}

.simplescroll .scroll1 {
  background-position: 622px;
  transform: rotateY(45deg) translateZ(30px);
}

.simplescroll .scroll2 {
  background-position: 544.25px;
  transform: rotateY(90deg) translateZ(30px);
}

.simplescroll .scroll3 {
  background-position: 466.5px;
  transform: rotateY(135deg) translateZ(30px);
}

.simplescroll .scroll4 {
  background-position: 388.75px;
  transform: rotateY(180deg) translateZ(30px);
}

.simplescroll .scroll5 {
  background-position: 311px;
  transform: rotateY(225deg) translateZ(30px);
}

.simplescroll .scroll6 {
  background-position: 233.25px;
  transform: rotateY(270deg) translateZ(30px);
}

.simplescroll .scroll7 {
  background-position: 155.5px;
  transform: rotateY(315deg) translateZ(30px);
}

.simplescroll .scroll8 {
  background-position: 77.75px;
  transform: rotateY(360deg) translateZ(30px);
}

/* ============================================
   BASE FLOAT ANIMATION (infinite loop)
============================================ */

@keyframes bookFloat {
  0% {
    transform: translateY(-25px) scale(1.3) rotate(0deg);
  }

  15% {
    transform: translateY(-32px) scale(1.3) rotate(0.3deg);
  }

  30% {
    transform: translateY(-28px) scale(1.3) rotate(-0.2deg);
  }

  50% {
    transform: translateY(-35px) scale(1.3) rotate(0.1deg);
  }

  65% {
    transform: translateY(-30px) scale(1.3) rotate(-0.3deg);
  }

  80% {
    transform: translateY(-33px) scale(1.3) rotate(0.2deg);
  }

  100% {
    transform: translateY(-25px) scale(1.3) rotate(0deg);
  }
}

/* ============================================
   ENTRANCE ANIMATIONS
============================================ */

/* Twister In Down - spins in from above */

@keyframes book-twisterInDown {
  0% {
    opacity: 0;
    transform-origin: 0 100%;
    transform: scale(0) rotate(360deg) translateY(-100%);
  }

  100% {
    opacity: 1;
    transform-origin: 100% 100%;
    transform: scale(1.3) rotate(0deg) translateY(-25px);
  }
}

/* Twister In Up - spins in from below */

@keyframes book-twisterInUp {
  0% {
    opacity: 0;
    transform-origin: 100% 0;
    transform: scale(0) rotate(360deg) translateY(100%);
  }

  100% {
    opacity: 1;
    transform-origin: 0 0;
    transform: scale(1.3) rotate(0deg) translateY(-25px);
  }
}

.user-css .bookcover:hover img {
  filter: brightness(1) drop-shadow(0 0 20px rgba(233, 170, 92, 0.7)) drop-shadow(0 0 40px rgba(205, 127, 50, 0.5)) drop-shadow(0 0 60px rgba(139, 69, 19, 0.4));
}

.user-css .col-md-6:first-child .bookcover:hover img {
  animation: book-twisterInDown 0.7s ease-out, bookFloat 3s ease-in-out 0.7s infinite;
}

.user-css .col-md-6:last-child .bookcover:hover img {
  animation: book-twisterInUp 0.7s ease-out, bookFloat 3s ease-in-out 0.7s infinite;
}

/* ====== 
ART GALLERY WRAPPER
 ====== */
.user-css .art-gallery {
  max-width: 1100px;
  margin: 30px auto;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
}


.user-css .art-gallery .art-artist {
  margin: 26px auto;
  padding: 22px;
  background: rgba(4, 9, 15, .72);
  border: 2px solid var(--color-border);
  border-radius: 16px;
  box-shadow: inset 0 0 40px rgba(0, 0, 0, .55);
}


.user-css .art-gallery .art-artist center {
  font-family: var(--font-meta);
  font-size: 14px;
  color: var(--color-muted);
  margin: 8px 0 16px;
}


.user-css .art-gallery .piece-title {
  max-width: 820px;
  margin: 14px auto 12px;
  padding: 12px 16px;
  text-align: center;
  font-family: var(--font-meta);
  font-size: 13px;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--color-muted);
  background: rgba(9, 18, 26, .60);
  border: 1px solid rgba(179, 116, 77, .55);
  border-radius: 12px;
  box-shadow: inset 0 0 16px rgba(0, 0, 0, .45);
}

.user-css .art-gallery .piece-title i {
  color: var(--color-accent);
  font-style: normal;
}


.user-css .art-gallery .piece-note {
  max-width: 820px;
  margin: -8px auto 18px;
  text-align: center;
  font-family: var(--font-body);
  color: var(--color-muted);
  font-size: 15px;
  line-height: 1.5;
  opacity: .95;
}


.user-css .art-gallery img,
.user-css .art-gallery .img-responsive.img-fluid,
.user-css .art-gallery .max-width-100 {
  display: block !important;
  margin: 12px auto 18px !important;
  float: none !important;
  filter: none !important;
  transform: none !important;
  border: none !important;
  border-image: none !important;
  -webkit-mask-image: none !important;
  mask-image: none !important;
  box-shadow: 0 10px 28px rgba(0, 0, 0, .55) !important;
  max-width: 100%;
  height: auto;
  border-radius: 10px;
}

.user-css .art-gallery hr {
  display: none;
}


@media(max-width:600px) {

  .user-css .art-gallery .art-artist {
    padding: 16px;
  }
}

.user-css .art-gallery .row {
  display: flex;
  gap: 14px;
  justify-content: center;
  align-items: stretch;
  margin: 10px auto 18px;
}

.user-css .art-gallery .row>[class*="col"] {
  flex: 1 1 0;
  min-width: 0;
}

.user-css .art-gallery .row>[class*="col"] img {
  width: 100% !important;
  height: auto !important;
  margin: 0 !important;
}

@media (max-width: 600px) {
  .user-css .art-gallery .row {
    flex-wrap: nowrap;
    gap: 10px;
  }

  .user-css .art-gallery .row>[class*="col"] {
    flex: 0 0 50%;
    max-width: 50%;
  }
}

/* ============================================
   KEYFRAMES
============================================ */

@keyframes blurFadeIn {
  0% {
    opacity: 0;
    filter: blur(20px);
    transform: scale(1.3);
  }

  50% {
    opacity: 0.5;
    filter: blur(5px);
    transform: scale(1.1);
  }

  100% {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
  }
}

/* ============================================
   CONTAINER
============================================ */

.user-css .blur-reveal {
  text-align: center;
  padding: 20px;
  margin: 20px 0;
}

/* ============================================
   WORDS
============================================ */

.user-css .blur-reveal .blur-word {
  display: inline-block;
  font-family: var(--font-quote);
  font-size: clamp(28px, 5vw, 60px);
  color: var(--color-accent);
  text-shadow: 0 0 10px rgba(233, 170, 92, 0.5);
  margin: 0 0.15em;
  opacity: 0;
  animation: blurFadeIn 1s ease-out forwards;
}


.user-css .blur-reveal .blur-word:nth-child(1) {
  animation-delay: 0.5s;
}

.user-css .blur-reveal .blur-word:nth-child(2) {
  animation-delay: 1s;
}

.user-css .blur-reveal .blur-word:nth-child(3) {
  animation-delay: 1.5s;
}

.user-css .blur-reveal .blur-word:nth-child(4) {
  animation-delay: 2s;
}

.user-css .blur-reveal .blur-word:nth-child(5) {
  animation-delay: 2.5s;
}

.user-css .blur-reveal .blur-word:nth-child(6) {
  animation-delay: 3s;
}

.user-css .blur-reveal .blur-word:nth-child(7) {
  animation-delay: 3.5s;
}

.user-css .blur-reveal .blur-word:nth-child(8) {
  animation-delay: 4s;
}

.user-css .blur-reveal .blur-word:nth-child(9) {
  animation-delay: 4.5s;
}

.user-css .blur-reveal .blur-word:nth-child(10) {
  animation-delay: 5s;
}

/* ============================================
   VARIANT: Slower
============================================ */

.user-css .blur-reveal-slow .blur-word {
  display: inline-block;
  font-family: var(--font-quote);
  font-size: clamp(32px, 6vw, 80px);
  color: var(--color-accent);
  text-shadow: 0 0 15px rgba(233, 170, 92, 0.6);
  margin: 0 0.2em;
  opacity: 0;
  animation: blurFadeIn 1.5s ease-out forwards;
}

.user-css .blur-reveal-slow .blur-word:nth-child(1) {
  animation-delay: 0.8s;
}

.user-css .blur-reveal-slow .blur-word:nth-child(2) {
  animation-delay: 1.8s;
}

.user-css .blur-reveal-slow .blur-word:nth-child(3) {
  animation-delay: 2.8s;
}

.user-css .blur-reveal-slow .blur-word:nth-child(4) {
  animation-delay: 3.8s;
}

.user-css .blur-reveal-slow .blur-word:nth-child(5) {
  animation-delay: 4.8s;
}

/* ============================================
   VARIANT: White text 
============================================ */

.user-css .blur-reveal-light .blur-word {
  display: inline-block;
  font-family: var(--font-quote);
  font-size: clamp(28px, 5vw, 60px);
  color: var(--color-text);
  text-shadow: 0 0 20px rgba(255, 255, 255, 0.8), 0 0 40px rgba(255, 255, 255, 0.4);
  margin: 0 0.15em;
  opacity: 0;
  animation: blurFadeIn 1s ease-out forwards;
}

.user-css .blur-reveal-light .blur-word:nth-child(1) {
  animation-delay: 0.5s;
}

.user-css .blur-reveal-light .blur-word:nth-child(2) {
  animation-delay: 1s;
}

.user-css .blur-reveal-light .blur-word:nth-child(3) {
  animation-delay: 1.5s;
}

.user-css .blur-reveal-light .blur-word:nth-child(4) {
  animation-delay: 2s;
}

.user-css .blur-reveal-light .blur-word:nth-child(5) {
  animation-delay: 2.5s;
}

.user-css .blur-reveal-light .blur-word:nth-child(6) {
  animation-delay: 3s;
}

.user-css .blur-reveal-light .blur-word:nth-child(7) {
  animation-delay: 3.5s;
}

.user-css .blur-reveal-light .blur-word:nth-child(8) {
  animation-delay: 4s;
}

/* ======
   MENU CONTAINER
======= */

.user-css .menu {
  position: relative;
  background: linear-gradient(145deg, #2a0a0a 0%, #3d1111 15%, #4a1818 30%, #3d1414 50%, #331010 70%, #2a0c0c 85%, #1f0808 100%);
  color: #e8d5c4;
  font-family: var(--font-body);
  font-size: clamp(14px, 1.2vw, 18px);
  line-height: 1.6;
  padding: 25px 20px;
  margin: 10px auto;
  max-width: 100%;
  min-height: 100%;
  border: 2px solid #8b4513;
  border-radius: 2px;
  box-shadow: 0 0 0 3px #1a0505, 0 0 0 5px #6b3510, inset 0 0 50px rgba(0, 0, 0, 0.4), 0 6px 20px rgba(0, 0, 0, 0.5);
  overflow: visible;
}

.user-css .menu::before {
  content: '';
  position: absolute;
  inset: 8px;
  border: 1px solid rgba(212, 175, 125, 0.2);
  border-radius: 0;
  pointer-events: none;
}

.user-css .menu::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at top left, rgba(0, 0, 0, 0.25) 0%, transparent 30%), radial-gradient(ellipse at bottom right, rgba(0, 0, 0, 0.3) 0%, transparent 30%), radial-gradient(ellipse at 50% 50%, rgba(212, 175, 125, 0.02) 0%, transparent 50%);
  pointer-events: none;
  border-radius: 2px;
}

.user-css .menu h2,
.user-css .menu h3,
.user-css .menu h4,
.user-css .menu h5 {
  font-family: var(--font-header);
  background: linear-gradient(45deg, #8b6914 0%, #d4af7a 25%, #f5deb3 50%, #d4af7a 75%, #8b6914 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  -moz-background-clip: text;
  color: transparent;
  text-shadow: none;
  letter-spacing: 1px;
  border-bottom: 1px solid rgba(212, 175, 125, 0.3);
  padding-bottom: 8px;
  margin-bottom: 15px;
  margin-top: 0;
  text-align: center;
  word-wrap: break-word;
  overflow-wrap: break-word;
  hyphens: auto;
}

.user-css .menu h2 {
  font-size: clamp(24px, 4vw, 40px);
}

.user-css .menu h3 {
  font-size: clamp(20px, 3vw, 32px);
}

.user-css .menu h4 {
  font-size: clamp(18px, 2.5vw, 26px);
}

.user-css .menu h5 {
  font-size: clamp(16px, 2vw, 22px);
}

.user-css .menu ul,
.user-css .menu ol {
  margin: 0;
  padding-left: 30px;
  list-style-position: inside;
}

.user-css .menu li {
  color: #e8d5c4;
  -webkit-text-fill-color: #e8d5c4;
  margin-bottom: 4px;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

.user-css .menu p {
  color: #e8d5c4;
  -webkit-text-fill-color: #e8d5c4;
  margin: 0 0 4px 0;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

.user-css .menu a {
  color: #d4af7a;
  -webkit-text-fill-color: #d4af7a;
  font-weight: 500;
  text-decoration: none;
  border-bottom: 1px solid rgba(212, 175, 125, 0.4);
  transition: all 0.3s ease;
}

.user-css .menu a:hover {
  color: #f5deb3;
  border-bottom-color: #f5deb3;
  text-shadow: 0 0 10px rgba(212, 175, 125, 0.5);
  background: none;
  -webkit-text-fill-color: #f5deb3;
}

.user-css .menu hr {
  border: none;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(212, 175, 125, 0.3) 20%, rgba(212, 175, 125, 0.5) 50%, rgba(212, 175, 125, 0.3) 80%, transparent 100%);
  margin: 15px 0;
}

.user-css .col-md-4 .menu,
.user-css[class*="col"] .menu {
  padding: 20px 20px 20px 25px;
  margin: 5px 0;
  height: auto;
  min-height: auto;
}

.user-css .col-md-4 .menu h4,
.user-css[class*="col"] .menu h4 {
  font-size: clamp(16px, 2vw, 22px);
  letter-spacing: 0.5px;
}

.user-css .col-md-4 .menu::before,
.user-css[class*="col"] .menu::before {
  inset: 6px;
}

@media (max-width: 768px) {
  .user-css .menu {
    padding: 20px 15px;
    font-size: 14px;
  }

  .user-css .menu h4 {
    font-size: 18px;
  }

  .user-css .menu::before {
    inset: 5px;
  }
}

.user-css .menu,
.user-css .menu * {
  overflow: visible;
  text-overflow: unset;
  white-space: normal;
}

/*THIS SECTION IS WHERE YOU MUST PASTE THE CSS GENERATED VIA SPREADSHEET. THE LOCK WILL NOT ACTUALLY LOCK UNLESS YOU PASTE THAT CODE IN HERE*/

/*MAKE SURE YOU PASTE THE CSS GENERATED BY THE SPREADSHEET ABOVE THIS LINE, IT MUST BE PASTED INTO YOUR CSS FOR IT TO WORK*/

/*Now, once you've done that, we're on to the rest of the CSS. You likely don't have to look into this that much, everything should work, though if something is slightly mis-aligned, you can work with me to get it to line up properly.

These are the animations that control the tabs and buttons on the locks themselves*/

@keyframes tabdown {
  0% {
    transform: rotateX(0);
  }

  100% {
    transform: rotateX(180deg);
    background: url(https://www.worldanvil.com/uploads/images/c4707c365571141511429a77e40b21e2.png);
    background-position: 0% 5%;
    height: 25px;
    top: 145px;
    z-index: 10;
    height: 25px;
    top: 145px;
    z-index: 10;
  }
}

@keyframes tabup {
  0% {
    transform: rotateX(180deg);
    background: url();
  }

  100% {
    transform: rotateX(0);
  }
}

/*This section is to control most of the base lock portions. Placement, backgrounds, etc. Only edit if you know what you're doing, and need to position things slightly. Otherwise, I can help.*/

.fantasylock .lockmech {
  position: relative;
  display: inline-block;
  left: -15px;
  top: -168px;
}

.fantasylock {
  margin-top: 30px;
  margin-bottom: -160px;
}

.fantasylock .well,
.fantasylock .card {
  display: none;
}

.fantasylock .lockhousing {
  background: url(https://www.worldanvil.com/uploads/images/1ada8e9b0006922a14f410f62c815058.png);
  display: block;
  position: relative;
  padding: 0px;
  width: 343px;
  height: 160px;
  z-index: 13 !important;
}

.user-css .panel .fantasylock .lockmech,
.user-css .panel .fantasylock .lockhousing {
  margin-left: -27px;
  /*This is to help position the lock in sidebars*/
}

.user-css .panel .fantasylock .lockcontent {
  margin-left: 35px;
  /*This is to help position the lock content in sidebars*/
  margin-right: -15px;
}

/*Controls styling of buttons*/

.fantasylock .spoiler-button {
  padding: 0px;
  width: 25px;
  height: 170px;
  position: absolute;
  color: #B7B7B7 !important;
  border-style: none !important;
  border-radius: 0px;
  box-shadow: none;
}

.fantasylock .spoiler-button:focus,
.fantasylock .spoiler-button:hover {
  box-shadow: none;
}

/*Controls styling of the content hider, overlay, thing*/

.fantasylock .lockcontent {
  filter: blur(0px);
  margin-top: 210px;
  margin-bottom: 15px;
  margin-left: 15px;
  padding: 15px;
  -webkit-touch-callout: none;
  -webkit-user-select: none;
  -khtml-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
  border: 5px groove #D4B572;
}

.fantasylock .lockpath {
  background: url(https://www.worldanvil.com/uploads/images/4d8e17cae309446a70acb31a3a318f15.png) repeat;
  background-size: 1000px;
  border-left: 7px groove #D4B572;
  border-right: 7px groove #D4B572;
  position: absolute;
  display: block;
  filter: brightness(70%);
  width: 340px;
  height: 80px;
  float: left;
  top: 135px;
  left: 16px;
}

.fantasylock .lockcontent:before {
  position: absolute;
  content: url(attr);
  box-shadow: inset 0 0 100px black;
  background: url(https://www.worldanvil.com/uploads/images/2787de27b34b35dfe124df61281401db.png) no-repeat, url(https://www.worldanvil.com/uploads/images/4d8e17cae309446a70acb31a3a318f15.png) repeat;
  background-position: center;
  background-size: contain, 1000px;
  width: 100%;
  height: 100%;
  left: 0px;
  top: 0px;
  transition: all 1s;
}

/*Reveals the hidden content*/

.fantasylock .lockbutton .spoiler-button[aria-expanded$=true]~.lockcontent {
  filter: blur(0px) !important;
  -webkit-touch-callout: auto;
  -webkit-user-select: auto;
  -khtml-user-select: auto;
  -moz-user-select: auto;
  -ms-user-select: auto;
  user-select: auto;
  transition: all 1s;
}

/*Some styling animations*/

.fantasylock .lockbutton .spoiler-button:hover~.lockcontent:before {
  background: url(https://www.worldanvil.com/uploads/images/90b75284687e673deef3e727f09dac5c.png) no-repeat, url(https://www.worldanvil.com/uploads/images/4d8e17cae309446a70acb31a3a318f15.png) repeat;
  background-position: center;
  background-size: contain, 1000px;
  box-shadow: inset 0 0 100px rgba(150, 150, 150, 0.1);
}

@keyframes fadeout {
  0% {
    opacity: 100%;
  }

  90% {
    opacity: 0%;
    display: block;
  }

  100% {
    display: none !important;
    opacity: 0%;
    z-index: -10;
  }
}

.fantasylock .lockbutton .spoiler-button[aria-expanded$=true]~.lockcontent:before {
  animation-name: fadeout;
  animation-fill-mode: forwards;
  animation-duration: .5s;
}

.fantasylock .lockbutton .spoiler-button {
  background: url(https://www.worldanvil.com/uploads/images/e2dcd5c73a7dbe057a46c0c2d5e50367.png) no-repeat;
  background-size: cover;
  background-position: center;
  width: 36px;
  height: 156px;
  padding: 16px;
  top: -5px;
  left: 355px;
  transition: all .5s;
  animation-name: none !important;
}

.fantasylock .lockbutton .spoiler-button:hover {
  background: url(https://www.worldanvil.com/uploads/images/f152bc5f854e381389c9a9144073f555.png) no-repeat;
}

.fantasylock .lockbutton .spoiler-button:active {
  left: 335px;
}

/*animations*/

.fantasylock .spoiler-button[aria-expanded$=true] {
  animation-name: tabdown;
  animation-duration: .5s;
  animation-fill-mode: forwards;
}

.fantasylock .spoiler-button[aria-expanded$=false] {
  animation-name: tabup;
  animation-duration: .2s;
  animation-fill-mode: forwards;
}

