/* ============================
   RAW IMAGE CONTAINER 
============================ */

.user-css .raw-image img,
.user-css .raw-image .img-responsive,
.user-css .raw-image .img-fluid,
.user-css .raw-image .img-responsive.img-fluid,
.user-css .container-raw-image img,
.user-css .container-raw-image .img-responsive,
.user-css .container-raw-image .img-fluid,
.user-css .container-raw-image .img-responsive.img-fluid {
  filter: none !important;
  -webkit-mask-image: none !important;
  mask-image: none !important;
  border: none !important;
  border-image: none !important;
  transform: none !important;
  box-shadow: none !important;
  transition: none !important;
  opacity: 1 !important;
}

.user-css .raw-image img:hover,
.user-css .raw-image .img-responsive:hover,
.user-css .raw-image .img-fluid:hover,
.user-css .raw-image .img-responsive.img-fluid:hover,
.user-css .container-raw-image img:hover,
.user-css .container-raw-image .img-responsive:hover,
.user-css .container-raw-image .img-fluid:hover,
.user-css .container-raw-image .img-responsive.img-fluid:hover {
  filter: none !important;
  transform: none !important;
  box-shadow: none !important;
}


/* ============================================
   GRID WRAPPER
============================================ */
.user-css .credits-grid,
.user-css .container-credits-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 25px;
  padding: 20px;
  margin: 30px auto;
  max-width: 1200px;
}

/* ============================================
   INDIVIDUAL CARD
============================================ */
.user-css .credit-card,
.user-css .container-credit-card {
  position: relative;
  background: linear-gradient(145deg,
      #0d2a2a 0%,
      #0a1f1f 50%,
      #071717 100%);
  border: 2px solid #8b4513;
  border-radius: 4px;
  padding: 25px 20px;
  text-align: center;
  box-shadow:
    0 0 0 1px rgba(139, 69, 19, 0.3),
    inset 0 0 30px rgba(0, 0, 0, 0.4),
    0 5px 20px rgba(0, 0, 0, 0.5);
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  overflow: hidden;
}

/* Inner decorative border */
.user-css .credit-card::before,
.user-css .container-credit-card::before {
  content: '';
  position: absolute;
  inset: 8px;
  border: 1px solid rgba(212, 175, 125, 0.15);
  border-radius: 2px;
  pointer-events: none;
}

/* Subtle corner glow */
.user-css .credit-card::after,
.user-css .container-credit-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at top left, rgba(212, 175, 125, 0.05) 0%, transparent 40%),
    radial-gradient(ellipse at bottom right, rgba(212, 175, 125, 0.05) 0%, transparent 40%);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}

/* Hover effect */
.user-css .credit-card:hover,
.user-css .container-credit-card:hover {
  transform: translateY(-5px);
  border-color: #d4af7a;
  box-shadow:
    0 0 0 1px rgba(212, 175, 125, 0.5),
    inset 0 0 30px rgba(0, 0, 0, 0.3),
    0 10px 30px rgba(0, 0, 0, 0.6),
    0 0 20px rgba(212, 175, 125, 0.15);
}

.user-css .credit-card:hover::after,
.user-css .container-credit-card:hover::after {
  opacity: 1;
}

/* ============================================
   NAME
============================================ */
.user-css .credit-name,
.user-css .container-credit-name {
  font-family: var(--font-header);
  font-size: clamp(22px, 3vw, 28px);
  background: linear-gradient(45deg,
      #8b6914 0%,
      #d4af7a 25%,
      #f5deb3 50%,
      #d4af7a 75%,
      #8b6914 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: 1px;
  margin-bottom: 5px;
}

/* ============================================
   ROLE/TITLE
============================================ */
.user-css .credit-role,
.user-css .container-credit-role {
  font-family: var(--font-quote);
  font-size: clamp(14px, 2vw, 18px);
  color: var(--color-accent);
  -webkit-text-fill-color: var(--color-accent);
  font-style: italic;
  margin-bottom: 15px;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(212, 175, 125, 0.2);
}

/* ============================================
   BIO
============================================ */
.user-css .credit-bio,
.user-css .container-credit-bio {
  font-family: var(--font-body);
  font-size: clamp(13px, 1.5vw, 15px);
  color: var(--color-text);
  -webkit-text-fill-color: var(--color-text);
  line-height: 1.6;
  margin-bottom: 15px;
  text-align: left;
}

/* ============================================
   LINKS
============================================ */
.user-css .credit-links,
.user-css .container-credit-links {
  font-family: var(--font-meta);
  font-size: clamp(12px, 1.3vw, 14px);
  padding-top: 10px;
  border-top: 1px solid rgba(212, 175, 125, 0.2);
}

.user-css .credit-links a,
.user-css .container-credit-links a {
  color: #d4af7a !important;
  -webkit-text-fill-color: #d4af7a !important;
  text-decoration: none;
  margin: 0 8px;
  transition: color 0.2s ease, text-shadow 0.2s ease;
}

.user-css .credit-links a:hover,
.user-css .container-credit-links a:hover {
  color: #f5deb3 !important;
  -webkit-text-fill-color: #f5deb3 !important;
  text-shadow: 0 0 8px rgba(212, 175, 125, 0.5);
}

/* ============================================
   RESPONSIVE
============================================ */
@media (max-width: 768px) {

  .user-css .credits-grid,
  .user-css .container-credits-grid {
    grid-template-columns: 1fr;
    padding: 10px;
  }


  /* ===== Kill Statblock Wrapper ===== */

  .user-css-presentation .card:has(.scp-background-card),
  .user-css-presentation .ibox:has(.scp-background-card),
  .user-css-presentation .ibox-content:has(.scp-background-card),
  .user-css-presentation .statblock:has(.scp-background-card) {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }
