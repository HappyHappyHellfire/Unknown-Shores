.user-css .background-card table th {
  padding: 6px 8px;

  background: rgba(122, 67, 36, .12);
  color: #64251c;

  font-family:
    var(--font-title),
    Georgia,
    serif;

  font-weight: 700;
  font-variant: small-caps;
  letter-spacing: .02em;

  text-align: left;
  vertical-align: bottom;
}

.user-css .background-card table td {
  padding: 6px 8px;

  background: transparent;
  border-bottom: 1px solid rgba(93, 54, 31, .35);

  text-align: left;
  vertical-align: top;
}

.user-css .background-card table tbody tr:nth-child(odd) td {
  background: rgba(137, 91, 45, .07);
}

.user-css .background-card table tbody tr:last-child td {
  border-bottom: 2px solid #7b3525;
}

/* Overrides unwanted World Anvil table styling */

.user-css .background-card table,
.user-css .background-card table tr,
.user-css .background-card table td,
.user-css .background-card table th {
  box-shadow: none;
}

/* Keeps narrow dice-result columns compact */

.user-css .background-card table th:first-child,
.user-css .background-card table td:first-child {
  width: 54px;
  white-space: nowrap;
  text-align: center;
}

/* ==========================================
   OPTIONAL RULE DIVIDER
========================================== */

.user-css .background-card .background-rule {
  height: 2px;

  margin: 16px 0;

  background:
    linear-gradient(
      to right,
      transparent,
      #8a4b2d 12%,
      #8a4b2d 88%,
      transparent
    );
}

/* ==========================================
   MOBILE
========================================== */

@media screen and (max-width: 600px) {
  .user-css .background-card {
    width: 98%;
    min-height: 0;

    margin: 20px auto;
    padding: 62px 48px 72px;

    font-size: 13px;
    line-height: 1.4;
  }

  .user-css .background-card h5 {
    font-size: 1.65em;
  }

  .user-css .background-card .background-details {
    padding: 7px 8px;
  }

  .user-css .background-card table {
    font-size: .82em;
  }

  .user-css .background-card table th,
  .user-css .background-card table td {
    padding: 5px 4px;
  }

  .user-css .background-card table th:first-child,
  .user-css .background-card table td:first-child {
    width: 38px;
  }
}



/* ==============================
   TREASURE PARCHMENT (ANIMATED CLUES)
============================== */

.user-css .treasure-parchment {
  background-image: url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/05dc9ca04ddf4307f8563b32f659fd2e.png);
  background-repeat: no-repeat;
  background-size: contain;
  background-position: center center;
  width: min(100%, 920px);
  aspect-ratio: 3 / 4;
  margin: 24px auto;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: clamp(24px, 5vw, 64px);
  box-sizing: border-box;
  color: #2a1b10;
  text-align: center;
  text-shadow: 0 0 1px rgba(0, 0, 0, 0.25);
}

.user-css .treasure-parchment .tp-wrap {
  position: relative;
  width: 80%;
  height: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-css .treasure-parchment .tp-front,
.user-css .treasure-parchment .tp-back {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  font-family: var(--font-quote);
  font-size: clamp(28px, 4vw, 52px);
  line-height: 1.4;
  text-align: center;
}

.user-css .treasure-parchment .tp-front {
  color: #2a1b10;
  transform: translate(-40%, 25%) rotate(-1.5deg);
  opacity: 1;
  animation: tp-front-out 16s ease forwards;
}

.user-css .treasure-parchment .tp-back {
  transform: translate(-40%, 75%) rotate(-1.5deg);
}

.user-css .treasure-parchment .tp-line1 {
  color: #2a1b10;
  margin-bottom: 20px;
  opacity: 0;
  animation: tp-line1-in 16s ease forwards;
}

.user-css .treasure-parchment .tp-line2 {
  color: #5a1a12;
  font-style: italic;
  text-shadow: 0 0 5px rgba(48, 0, 0, 0.25);
  opacity: 0;
  animation: tp-line2-in 16s ease forwards;
}

.user-css .treasure-parchment .burn-wrapper {
  cursor: help;
}

.user-css .treasure-parchment .burn-wrapper:hover {
  cursor: pointer;
}

/* ==============================
   PAPER CONTAINER
============================== */

.user-css .paper {
  background: url(https://cdn.midjourney.com/ce4b395e-a158-486b-ab9a-1b01033ca757/0_0.png);
  position: relative;
  color: black;
  border: 10px solid #000000;
  background-size: cover;
  background-position: center;
  margin: 1px;
  border-radius: 0px 15px 0px 15px;
  padding: 100px;
}

/* ==============================
   BURN/QUOTE EFFECT (HOVER REVEAL)
============================== */

.user-css .burn-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;
}

/* Front Text (visible initially) */

.user-css .burn-front {
  position: relative;
  font-family: var(--font-quote);
  font-size: 42px;
  color: #1a1410;
  z-index: 2;
  opacity: 1;
  transition: opacity 2s ease, filter 2s ease, transform 2s ease;
}

.user-css .burn-front,
.user-css .burn-back {
  padding: 50px;
}


.user-css .burn-wrapper:hover .burn-front {
  opacity: 0;
  filter: blur(8px) brightness(1.4) sepia(1);
  transform: scale(1.02) rotate(-1deg);
}


.user-css .burn-back {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  bottom: 0;
  z-index: 1;
  opacity: 0;
  transform: scale(1.03) rotate(2deg);
  transition: color 2s ease, text-shadow 2s ease, transform 1s ease;
}


.user-css .burn-wrapper:hover .burn-back {
  animation: whisper-fade-in 1.8s ease forwards;
  transform: scale(1) rotate(0deg);
}


.user-css .burn-back .text1 {
  opacity: 0;
  font-family: var(--font-header);
  font-size: 42px;
  color: #1a1410;
  animation: whisper-fade-in-b 1s ease forwards;
  animation-delay: 0.1s;
  animation-play-state: paused;
}


.user-css .burn-back .text2 {
  opacity: 0;
  font-family: var(--font-quote);
  font-size: 38px;
  margin-top: 20px;
  color: #1a1410;
  text-shadow: none;
  animation: whisper-fade-in 1s ease forwards;
  animation-delay: 2s;
  animation-play-state: paused;
}


.user-css .burn-wrapper:hover .burn-back .text1 {
  animation-play-state: running;
  animation-name: whisper-fade-in;
}

.user-css .burn-wrapper:hover .burn-back .text2 {
  animation-play-state: running;
  animation-name: whisper-fade-in-b;
}


@keyframes tremble-subtle {
  0% {
    transform: translate(0, 0);
  }

  25% {
    transform: translate(0.5px, -0.5px);
  }

  50% {
    transform: translate(-0.5px, 0.5px);
  }

  75% {
    transform: translate(0.5px, 0.5px);
  }

  100% {
    transform: translate(-0.5px, -0.5px);
  }
}


@keyframes whisper-fade-in {
  0% {
    opacity: 0.1;
  }

  30% {
    opacity: 0.3;
  }

  60% {
    opacity: 0.6;
  }

  100% {
    opacity: 1;
  }
}

@keyframes whisper-fade-in-b {
  0% {
    opacity: 0.1;
  }

  30% {
    opacity: 0.3;
  }

  60% {
    opacity: 0.6;
  }

  100% {
    opacity: 1;
  }
}

/* ==============================
   BLOCKQUOTES
============================== */

.user-css blockquote,
.user-css-presentation .tooltipster-content blockquote {
  display: block;
  max-width: 900px;
  margin: 0.5em auto;
  padding: 30px 40px 20px;
  background: var(--color-background-gradient);
  border-radius: 20px;
  border: 2px solid var(--color-border);
  font-family: var(--font-quote);
  font-size: clamp(18px, 2.5vw, 35px);
  color: var(--color-link);
  line-height: 1.6;
  text-align: center;
  box-shadow: 0 0px 10px var(--color-accent);
  transition: all 1s ease;
  animation: floatQuote 4s ease-in-out infinite;
}

.user-css blockquote a {
  font-size: clamp(18px, 2.5vw, 35px);
  color: var(--color-accent);
  font-family: var(--font-quote);
}

.user-css blockquote:hover {
  box-shadow: inset 0 0 20px var(--color-shadow);
  rotate: 1deg;
}

.user-css blockquote .author {
  font-family: var(--font-meta);
  font-size: 14px;
  color: var(--color-muted);
  opacity: .7;
  font-style: normal;
  text-align: right;
}

.user-css blockquote .author a {
  font-family: var(--font-meta);
  font-size: 14px;
}

/* ==============================
   HR
============================== */

.user-css hr {
  border: none;
  border: 10px solid;
  border-image-source: url(https://wa-cdn.nyc3.digitaloceanspaces.com/user-data/production/c4e07060-742c-422d-972b-be3e8bccf927/uploads/images/f7abbea934351f3a0e714026d471734d.webp);
  border-image-slice: 60 fill;
  height: 100px;
  border-image-repeat: round;
  border-image-width: 70px;
  margin: 100px auto;
  background: none;
  opacity: 0.8;
}

/* ==============================
   BACK TO WORLD BUTTON
============================== */

.user-css .backtoworld a {
  display: inline-block;
  padding: 12px 24px;
  font-family: var(--font-quote);
  font-size: clamp(16px, 2.5vw, 30px);
  letter-spacing: 1.5px;
  color: var(--color-link);
  background: var(--color-background);
  border: 2px solid transparent;
  border-radius: 12px;
  position: relative;
  text-decoration: none;
  transition: all 2s ease;
  overflow: hidden;
  z-index: 1;
}

.user-css .backtoworld a::before {
  content: close-quote;
  position: absolute;
  inset: 0;
  border-radius: 12px;
  padding: 2px;
  background: linear-gradient(135deg, #3b2a20, #6e4b2f, #9c7744, #c6a56d, #e6d5b8, #c6a56d, #9c7744, #6e4b2f);
  background-size: 300% 300%;
  animation: borderFlow 6s ease infinite;
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  z-index: -1;
}

.user-css .backtoworld a:hover {
  transform: scale(1.05);
  color: var(--color-accent);
  box-shadow: 0 0 15px rgba(224, 200, 168, 0.4);
  rotate: -2deg;
}

/* ==============================
   DROPCAP
============================== */

.user-css .dropcap {
  font-family: var(--font-quote);
  font-size: 150px;
  margin-right: 5px;
}

/* ==============================
"While digging for buried treasure, your shovel
suddenly hits something solid. Something made of
Wood. Clearing away the sand, you discover an
old wooden chest. Upon opening it, you find
a single dusty scroll." 
(1ee1db34-eecf-4c80-b9f1-4d15cc280296)
============================== */

/* ==============================
   USERCARD
============================== */

.user-css .usercard {
  background-color: var(--color-background);
  border: 2px solid var(--color-border);
  border-radius: 10px;
  color: var(--color-text);
  font-family: var(--font-body);
  line-height: 2;
  padding: 30px 30px 0px;
  box-shadow: inset 0px 0px 10px var(--color-border);
}

/* ==============================
   ARTICLE HORIZONTAL NAVIGATION
============================== */

.user-css .article-horizontal-navigation a {
  font-family: var(--font-quote);
  font-size: 45px;
  letter-spacing: 2px;
}

/* ==============================
   MAP BOXES
============================== */

.user-css .map-box {
  width: clamp(300px, 40%, 700px);
  display: inline-block;
  background: url(https://www.worldanvil.com/i/6982188/render) center/cover no-repeat;
  border: 2px solid var(--color-border);
  border-radius: 15px;
  height: auto;
  min-height: 300px;
  margin: 30px;
  margin-left: 60px;
  padding: 0;
  box-sizing: border-box;
  color: var(--color-text);
}

.user-css .map-box .p-20 {
  padding: 0 !important;
  margin: 0 auto;
  height: 90px;
  background: var(--color-background);
  opacity: 0.8;
  transform: translateY(-5px);
}

.user-css .map-box h5 {
  font-family: var(--font-header);
  font-size: clamp(20px, 3vw, 24px);
  font-weight: 700;
  background: var(--color-header);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  -moz-background-clip: text;
  color: transparent;
  text-shadow: rgba(0, 0, 0, 0.3) 1px 1px 2px;
  transform: translateY(5px);
  text-align: center;
  letter-spacing: 1px;
}

.user-css .map-box .img-responsive.img-fluid {
  opacity: 0;
  border-radius: 12px 12px 0 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.user-css .map-box:hover .img-responsive.img-fluid {
  opacity: 1;
  pointer-events: auto;
}

.user-css .map-box:hover {
  transform: scale(1.02);
  box-shadow: 0 0 15px rgba(217, 142, 95, 0.4);
}

/* ==============================
   BOOK COVERS
============================== */

.user-css .bookcover {
  background: transparent;
  text-align: center;
  margin: 0 auto;
  display: inline-block;
  width: 300px;
  position: relative;
  height: 400px;
  overflow: visible;
  z-index: 1;
  transition: z-index 0s 0.4s;
}

.user-css .bookcover:hover {
  z-index: 100;
  transition: z-index 0s;
}

.user-css .bookcover img {
  display: inline-block;
  object-fit: contain;
  max-width: 100%;
  height: auto;
  opacity: 1;
  filter: brightness(70%);
  box-shadow: none !important;
  border: none !important;
  transform: translateY(0) scale(1);
  transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.4s ease;
}

.user-css .bookcover::before {
  content: '';
  position: absolute;
  bottom: -30px;
  left: 50%;
  transform: translateX(-50%);
  width: 0%;
  height: 0px;
  background: radial-gradient(ellipse, rgba(0, 0, 0, 0.5), transparent);
  opacity: 0;
  transition: all 0.5s ease;
  z-index: -1;
}

.user-css .bookcover:hover::before {
  width: 60%;
  height: 15px;
  opacity: 0.3;
  filter: blur(10px);
  bottom: -60px;
}

.user-css .bookcover:hover img {
  filter: brightness(1) drop-shadow(0 0 20px rgba(233, 170, 92, 0.7)) drop-shadow(0 0 40px rgba(205, 127, 50, 0.5)) drop-shadow(0 0 60px rgba(139, 69, 19, 0.4));
  animation: bookFloat 3s ease-in-out infinite;
}

.user-css .booktitle {
  font-family: var(--font-quote);
  text-transform: capitalize;
  background: linear-gradient(45deg, #4A2C1A 0%, #A85C32 15%, #D98E5F 65%, #A85C32 85%, #4A2C1A 95%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  -moz-background-clip: text;
  color: transparent;
  font-size: clamp(35px, 5vw, 32px);
  font-weight: 400;
  letter-spacing: 1px;
  text-shadow: var(--color-shadow);
  position: relative;
  top: 0;
  left: 0;
}

.user-css .bookcover .excerpt {
  display: none;
}

/* ==============================
   BUTTONS
============================== */

.user-css .btn-success:focus,
.user-css .btn-success:active,
.user-css .btn-primary:focus,
.user-css .btn-primary:active,
.user-css .btn-info:focus,
.user-css .btn-info:active,
.user-css .btn-danger:focus,
.user-css .btn-danger:active {
  outline: none !important;
  box-shadow: none !important;
}

.user-css .btn-primary,
.user-css .btn-success {
  background: linear-gradient(145deg, #0d2f2f, #081a1a);
  border: 1px solid #0f3d46 !important;
  padding: 10px 20px 5px;
  border-radius: 8px;
  font-weight: 400;
  font-family: var(--font-meta);
  font-size: 20px;
  transition: all 0.3s ease-in-out;
}

.user-css .btn-primary:hover {
  background: linear-gradient(145deg, #124444, #0b2222);
  box-shadow: inset 0 0 10px rgba(168, 255, 222, 0.4), 0 3px 8px rgba(0, 0, 0, 0.8);
  transform: translateY(-2px);
}

.user-css .primer .btn-success {
  background-color: var(--color-secondary-bg) !important;
  border: 1px solid var(--color-border) !important;
  color: var(--color-link) !important;
  font-family: var(--font-quote);
  font-size: clamp(16px, 2.5vw, 30px);
  letter-spacing: 1.5px;
  transition: transform 2s ease, filter 0.3s ease, border 0.3s ease, color 1s ease;
}

.user-css .primer .btn-success:hover {
  transform: scale(1.1);
  border: 0px solid transparent !important;
  background: var(--color-link-hover);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  box-shadow: none;
}

.user-css .btn-secondary {
  font-family: var(--font-meta);
  font-size: 20px;
  color: var(--color-text);
  font-weight: 400;
  padding: 10px;
  border-radius: 8px;
  border: 1px solid var(--color-border);
  transition: all 0.4s ease;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #04131d, #092a2f);
  border: 1px solid #0f3d46;
}

.user-css .btn-secondary:hover {
  background: linear-gradient(135deg, #092a2f, #04131d);
  transform: translateY(-2px);
}

/* ==============================
   STICKERS, LIKES, READING LIST
============================== */

.user-css .btn-danger,
.user-css .btn-info,
.user-css .btn-sticker,
.user-css #likes-indicator.text-danger {
  font-family: var(--font-meta);
  font-size: 20px;
  color: var(--color-text);
  font-weight: 400;
  padding: 10px;
  border-radius: 8px;
  border: 1px solid var(--color-border);
  transition: all 0.4s ease;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.user-css #likes-indicator.text-danger {
  background: linear-gradient(135deg, #04131d, #092a2f) !important;
  color: var(--color-text) !important;
  font-family: var(--font-meta) !important;
  font-size: 20px !important;
  border: 1px solid #0f3d46;
}

.user-css .btn-danger {
  background: linear-gradient(135deg, #6e4b2f, #9c7744, #c6a56d);
  text-shadow: 0 0 5px rgba(0, 0, 0, 0.6);
  box-shadow: inset 0 0 6px rgba(255, 215, 170, 0.3);
}

.user-css .btn-danger:hover {
  transform: scale(1.05);
  box-shadow: 0 0 12px #c6a56d;
}

.user-css .btn-info {
  background: linear-gradient(135deg, #04131d, #092a2f);
  border: 1px solid #0f3d46;
}

.user-css .btn-info:hover {
  background: linear-gradient(135deg, #092a2f, #04131d);
  transform: translateY(-2px);
}

.user-css .btn-sticker {
  background: linear-gradient(145deg, #1c1c1c, #000);
  border: 1px solid #9c7744;
  box-shadow: inset 0 0 6px rgba(212, 175, 55, 0.3), 0 2px 6px rgba(0, 0, 0, 0.6);
  transition: all 0.3s ease-in-out;
}

.user-css .btn-sticker:hover {
  background: linear-gradient(145deg, #2a2a2a, #111);
  transform: translateY(-2px);
}

/* ==============================
   STICKER SECTION - TREASURE DISPLAY
============================== */

.user-css .stickers-article-collection {
  position: relative;
  background: radial-gradient(ellipse at center, rgba(20, 12, 8, 0.9) 0%, rgba(4, 9, 15, 0.95) 70%), url(https://www.worldanvil.com/i/6982205/render);
  border: none;
  border-radius: 0;
  padding: 50px 40px 40px;
  margin: 50px auto;
  max-width: 600px;
  clip-path: polygon(0% 2%, 3% 0%, 7% 1%, 12% 0%, 18% 2%, 25% 0%, 32% 1%, 40% 0%, 48% 2%, 55% 0%, 63% 1%, 70% 0%, 78% 2%, 85% 0%, 92% 1%, 97% 0%, 100% 2%, 100% 98%, 97% 100%, 92% 99%, 85% 100%, 78% 98%, 70% 100%, 63% 99%, 55% 100%, 48% 98%, 40% 100%, 32% 99%, 25% 100%, 18% 98%, 12% 100%, 7% 99%, 3% 100%, 0% 98%);
  box-shadow: inset 0 0 80px rgba(217, 167, 111, 0.15), inset 0 0 20px rgba(0, 0, 0, 0.8);
}

.user-css .stickers-article-collection h4 {
  font-family: var(--font-header);
  font-size: clamp(28px, 4vw, 45px);
  color: var(--color-accent);
  -webkit-text-fill-color: var(--color-accent);
  background: none;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 4px;
  margin: 0 0 25px 0;
  padding: 10px 20px;
  border: 2px solid var(--color-border);
  border-left: none;
  border-right: none;
}

.user-css .stickers-article-collection .sticker-collection-sticker {
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  filter: sepia(0.3) brightness(0.85);
  cursor: pointer;
}

.user-css .stickers-article-collection .sticker-collection-sticker:hover {
  filter: sepia(0) brightness(1.1);
  transform: scale(1.25) rotate(-3deg) translateY(-10px);
  z-index: 10;
  animation: stickerFloat 2s ease-in-out infinite;
}

/* ==============================
   PANELS: DEFAULT
============================== */

.user-css .panel-default {
  background: linear-gradient(145deg, #0d2f2f, #081a1a);
  border: 1px solid #0f3d46 !important;
  padding: 10px 20px 5px;
  border-radius: 8px;
  font-weight: 400;
  font-family: var(--font-meta);
  font-size: 15px;
  color: var(--color-text);
  word-spacing: 2px;
  transition: all 0.3s ease-in-out;
}

.user-css .panel-default .btn-primary {
  background: transparent !important;
  border: none !important;
}

.user-css .panel-default a {
  font-family: var(--font-quote);
  color: var(--color-link);
  font-size: 40px;
  letter-spacing: 1px;
  font-weight: 400;
  text-transform: capitalize;
}

.user-css .panel-default a:hover {
  text-decoration: none;
}

.user-css .article-content .panel-default {
  position: relative;
  display: block;
  padding: 50px;
  background-color: rgba(4, 9, 15, 0.7);
  border: 3px solid var(--color-border);
  box-shadow: inset 0 0 10px var(--color-muted);
  word-spacing: 3px;
  color: var(--color-text);
  font-family: var(--font-body);
  font-size: 20px;
}

.user-css .article-content .panel-default a {
  font-family: var(--font-body);
  font-size: 20px;
  font-weight: 400;
}

/* ==============================
   CATEGORY CONTENTS
============================== */

.user-css .category-contents h1 {
  font-family: var(--font-header);
  font-size: clamp(30px, 5vw, 200px);
  background: var(--color-header);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  -moz-background-clip: text;
}

.user-css .category-contents {
  font-family: var(--font-text);
  color: var(--color-accent);
  font-size: 20px;
}

.user-css .category-contents .toc-article-link {
  font-family: var(--font-header);
  font-size: 30px;
  letter-spacing: 1px;
  line-height: 1.9;
}

.user-css .category-contents strong {
  display: none;
}

.user-css .category-contents .category-toc-header {
  font-family: var(--font-header);
  font-size: 60px;
  letter-spacing: 1px;
  text-align: center;
  border-bottom: 1px dashed var(--color-accent);
  line-height: 1.2;
}

.user-css .category-contents .category-list,
.user-css .world-timelines .category-list {
  list-style-type: none;
}

.user-css .world-timelines .category-list {
  position: relative;
  top: -10px;
}

/* ==============================
   SPOILER CONTENT
============================== */

.user-css .spoiler-content {
  background: var(--color-background-gradient);
  color: whitesmoke;
  border-radius: 0px;
  border: 2px solid var(--color-accent);
  box-shadow: 0 0 10px black;
  text-align: left;
  font-family: var(--font-body);
  font-size: 20px;
  line-height: 1.5em;
}

.user-css .spoiler-content:focus,
.user-css .spoiler-content:active {
  outline: none !important;
  box-shadow: none !important;
}

/* ==============================
   TOOLTIPS
============================== */

.user-css-presentation .tooltipster-base .tooltipster-content,
.user-css-presentation .tooltip-inner {
  font-size: 15px;
  line-height: 1.7;
  font-family: var(--font-body);
  opacity: 1;
  background: var(--color-background);
  border-radius: 5px;
  border: 2px solid var(--color-border);
  color: var(--color-text);
  text-align: center;
}

.user-css-presentation .tooltip {
  opacity: 1;
}

.user-css-presentation .tooltipster-content h2,
.user-css-presentation .tooltipster-content h3,
.user-css-presentation .tooltipster-content h4,
.user-css-presentation .tooltipster-content h5 {
  color: var(--color-accent);
}

.user-css-presentation .tooltipster-content a {
  color: var(--color-link);
}

.user-css-presentation .tooltipster-borderless.tooltipster-top .tooltipster-arrow-background,
.user-css-presentation .tooltipster-borderless.tooltipster-top .tooltipster-arrow-border,
.user-css-presentation .tooltip.bs-tooltip-top .tooltip-arrow::before {
  border-top-color: var(--color-border);
}

.user-css-presentation .tooltipster-borderless.tooltipster-bottom .tooltipster-arrow-background,
.user-css-presentation .tooltipster-borderless.tooltipster-bottom .tooltipster-arrow-border,
.user-css-presentation .tooltip.bs-tooltip-bottom .tooltip-arrow::before {
  border-bottom-color: var(--color-border);
}

.user-css-presentation .tooltipster-borderless.tooltipster-left .tooltipster-arrow-background,
.user-css-presentation .tooltipster-borderless.tooltipster-left .tooltipster-arrow-border,
.user-css-presentation .tooltip.bs-tooltip-start .tooltip-arrow::before {
  border-left-color: var(--color-border);
}

.user-css-presentation .tooltipster-borderless.tooltipster-right .tooltipster-arrow-background,
.user-css-presentation .tooltipster-borderless.tooltipster-right .tooltipster-arrow-border,
.user-css-presentation .tooltip.bs-tooltip-end .tooltip-arrow::before {
  border-right-color: var(--color-border);
}

/* ==============================
   DOCUMENT / DISCUSSION UI
============================== */

.user-css .read-document-data-main {
  background: var(--color-background-gradient);
  border: 5px solid var(--color-border);
  border-radius: 2px;
}

.user-css .discussion-board-section {
  color: white;
  font-family: var(--font-meta);
  font-size: 20px;
  background: var(--color-background-gradient);
}

.user-css .discussion-board-wrap,
.user-css .mt-4 {
  background: var(--color-background);
  border: 2px solid var(--color-border);
  border-radius: 5px 0;
}

.user-css .world-menu-subcategory {
  border: 5px solid var(--color-border);
  border-radius: 10px 0 10px;
  background: var(--color-secondary-bg);
}

.user-css .statblock {
  border: none;
}

/* ==============================
   TEMPLATE SPECIFIC OVERRIDES
============================== */

.user-css .template-generic_random_generator-nulcheck-208,
.user-css .template-refresh_page-solarcat02-208 {
  background: transparent;
  position: relative;
  top: 40px;
  padding: 10px 0 0 0;
}

.user-css .max-width-100.mw-100.image-6987522 {
  border-image: none;
  border: none;
  position: relative;
  left: 150px;
  top: -100px;
  filter: sepia(0) brightness(1);
  rotate: 10deg;
  opacity: 0.8;
}

.user-css .max-width-100.mw-100.image-6987522:hover {
  box-shadow: 0 0 0;
  filter: sepia(0) contrast(1.1) brightness(1) opacity(0.9);
}

/* ==============================
   COMMENTS SECTION
============================== */

.user-css-extended {
  position: relative;
  background: var(--color-background-gradient);
  box-shadow: 0 0 0 6px var(--color-background), 0 0 0 8px rgba(180, 116, 77, 0.4), inset 0 0 60px rgba(0, 0, 0, 0.5), 0 8px 30px rgba(0, 0, 0, 0.6);
  margin: clamp(20px, 12vw, 500px);
  padding: 40px;
  border: 3px solid var(--color-border);
  border-radius: 2px;
}

.user-css-extended::before {
  content: '';
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(179, 116, 77, 0.2);
  pointer-events: none;
}

.user-css-extended .page {
  background: transparent;
  box-shadow: none;
}

.user-css-extended .nav-tabs {
  display: none;
}

.user-css-extended h2 {
  font-size: clamp(30px, 4vw, 85px);
  border-bottom: none;
  margin: 10px auto;
  font-family: var(--font-quote);
  background: var(--color-header);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  -moz-background-clip: text;
  color: transparent;
  font-weight: 400;
  letter-spacing: 2px;
  text-transform: capitalize;
  text-align: center;
}

.user-css-extended a {
  color: var(--color-link);
  text-decoration: none;
  transition: all 0.3s ease;
}

.user-css-extended a:hover {
  background: var(--color-link-hover);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  text-shadow: var(--color-shadow);
}

.user-css-extended .user-tag .fas {
  font-size: 0.8em;
  color: var(--color-link) !important;
}

/* Comment boxes */

.user-css-extended .comment-box {
  position: relative;
  background: rgba(4, 9, 15, 0.5);
  font-family: var(--font-body);
  font-size: clamp(15px, 2vw, 18px);
  color: var(--color-text);
  padding: 25px;
  margin: 20px 0;
  border: 2px solid var(--color-border);
  box-shadow: 0 0 0 4px var(--color-background), 0 0 0 5px rgba(180, 116, 77, 0.3), inset 0 0 30px rgba(0, 0, 0, 0.3);
}

.user-css-extended .comment-box::before {
  content: '';
  position: absolute;
  inset: 8px;
  border: 1px solid rgba(179, 116, 77, 0.15);
  pointer-events: none;
}

.user-css-extended .comment-box .comment-box-author {
  font-family: var(--font-quote);
  font-weight: 400;
  font-size: clamp(25px, 2vw, 45px);
}

.user-css-extended .comment-box-signature,
.user-css-extended .comment-box-signature a {
  font-size: 15px;
}

/* Nested replies */

.user-css-extended .comment-box .comment-box {
  margin-left: 20px;
  background: rgba(9, 18, 26, 0.5);
}

/* Comment form */

.user-css-extended .comment-form textarea {
  font-family: var(--font-meta);
  background: var(--color-text);
  height: 120px;
  opacity: 0.7;
  font-size: clamp(16px, 2vw, 20px);
  width: 100%;
}

.user-css-extended .comment-form textarea:focus {
  opacity: 0.9;
}

.user-css-extended .comment-form .btn-primary {
  font-family: var(--font-meta);
  font-size: 16px;
  background: var(--color-background);
  border: 1px solid var(--color-border);
  transition: all 0.4s ease;
  width: 100%;
}

.user-css-extended .comment-form .btn-primary:hover {
  box-shadow: 0 0 10px var(--color-shadow);
  transform: translateY(5px);
}

